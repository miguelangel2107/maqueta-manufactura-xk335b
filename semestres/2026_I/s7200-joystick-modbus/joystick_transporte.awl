SUBROUTINE_BLOCK MBUS_INIT:SBR5
TITLE=该代码是Siemens Energy & Automation, Inc.的财产，属于扩充包Modbus协议库的一部分。
VAR_INPUT
Mode:BYTE;	// 启动／停止（1 = 启动Modbus，0 = 停止Modbus）
Addr:BYTE;	// 从属地址（1- 247）
Baud:DWORD;	// 波特率（1200、2400、4800、9600、19200、38400、57600、115200）
Parity:BYTE;	// 奇偶校验（0 = 无，1 = 奇数，2 = 偶数）
Delay:INT;	// 附加字符间超时（默认值0毫秒）
MaxIQ:INT;	// I和Q位最大数目（默认值128）
MaxAI:INT;	// 输入寄存器最大数目（模拟输入字－16或32）
MaxHold:INT;	// 保持寄存器最大数目（V内存字）
HoldStart:DWORD;	// 保持寄存器在V内存中的起始地址（默认值&VB0）
END_VAR
VAR_OUTPUT
Done:BOOL;	// 初始化完成旗标
Error:BYTE;	// 初始化错误代码
END_VAR
VAR
index1:INT;
index2:INT;
AC0save:DWORD;
AC1save:DWORD;
AC2save:DWORD;
AC3save:DWORD;
END_VAR
BEGIN
Network 1 // This POU is password-protected against editing and viewing.

END_SUBROUTINE_BLOCK
