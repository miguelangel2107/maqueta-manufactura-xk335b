END_VAR
VAR
start:INT;	// Fctn 1,2,3,4,5,6,15,16
count:INT;	// Fctn 1,2,3,4,15
functn:BYTE;	// Fctn 1,2,3,4
shift_cnt:BYTE;	// Fctn 1,2
offset:INT;	// Fctn 1,2
index:INT;	// Fctn 1,2
bit_count:INT;	// Fctn 1,2
bit_number:BYTE;	// Fctn 5
byte_count:BYTE;	// Fctn 16
AC0save:DWORD;
AC1save:DWORD;
AC2save:DWORD;
AC3save:DWORD;
END_VAR
BEGIN
