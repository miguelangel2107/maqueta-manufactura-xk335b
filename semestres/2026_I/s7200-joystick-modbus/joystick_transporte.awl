SUBROUTINE_BLOCK NET_EXE:SBR8
TITLE=This POU was created by the NETR/NETW formula of the S7-200 Instruction Wizard.
// To enable this configuration within the program, use SM0.0 to call this Subroutine from the MAIN program block every scan cycle.  
// 
// NETR       Operation 1 of 8
// Local PLC Data Table        Remote PLC = 2    Operation Status
//  VB0 - VB0              <---   VB0 - VB0           NETR1_Status:VB100
// Data Length: 1 byte(s)
// 
// NETW       Operation 2 of 8
// Local PLC Data Table        Remote PLC = 2    Operation Status
//  VB1 - VB1              --->   VB1 - VB1           NETW2_Status:VB108
// Data Length: 1 byte(s)
// 
// NETR       Operation 3 of 8
// Local PLC Data Table        Remote PLC = 4    Operation Status
//  VB2 - VB2              <---   VB0 - VB0           NETR3_Status:VB116
// Data Length: 1 byte(s)
// 
// NETW       Operation 4 of 8
// Local PLC Data Table        Remote PLC = 4    Operation Status
//  VB3 - VB3              --->   VB1 - VB1           NETW4_Status:VB124
// Data Length: 1 byte(s)
// 
// NETR       Operation 5 of 8
// Local PLC Data Table        Remote PLC = 3    Operation Status
//  VB4 - VB4              <---   VB0 - VB0           NETR5_Status:VB132
// Data Length: 1 byte(s)
// 
// NETW       Operation 6 of 8
// Local PLC Data Table        Remote PLC = 3    Operation Status
//  VB5 - VB5              --->   VB1 - VB1           NETW6_Status:VB140
// Data Length: 1 byte(s)
// 
// NETR       Operation 7 of 8
// Local PLC Data Table        Remote PLC = 5    Operation Status
//  VB6 - VB6              <---   VB0 - VB0           NETR7_Status:VB148
// Data Length: 1 byte(s)
// 
// NETW       Operation 8 of 8
// Local PLC Data Table        Remote PLC = 5    Operation Status
//  VB7 - VB7              --->   VB1 - VB1           NETW8_Status:VB156
// Data Length: 1 byte(s)
// 
// To modify the network operations for this configuration, re-run the NETR/NETW Wizard. To track the status of network operations, create a Status Chart containing the Operation Status symbols shown above. Consult online Help for a description of the possible error conditions for NETR and NETW instructions.
VAR_INPUT
Timeout:INT;	// Timeout timer 0=no timer; 1-32767=timer value in seconds.
END_VAR
VAR_OUTPUT
Cycle:BOOL;	// Toggled each time all NET operations are completed.
Error:BOOL;	// 0=No error; 1=Error (check NETR/NETW status byte for code number).
END_VAR
BEGIN
Network 1 // This POU is password-protected against editing and viewing.

END_SUBROUTINE_BLOCK
