ORGANIZATION_BLOCK MAIN:OB1
TITLE=Unidad 3: Ensamblaje (PLC 3)
// Planta XK-335B - Unidad 3: Ensamblaje
// Coloca un nucleo en la pieza base y detecta si la pieza es negra.
// CPU 226CN. Puerto 0: esclavo PPI, direccion 3, 19200 bps, 8-E-1.
// Subrutinas:
//   OB1: llama a las subrutinas (las dos secuencias corren en auto y en manual)
//   SBR0 SBR_INIT: valores iniciales en el primer ciclo (SM0.1)
//   SBR1 SBR_IO_SCAN: entradas, flancos de SB1/SB2 y ordenes PPI
//   SBR2 SBR_SEGURIDAD: seta QS (I2.6), rearme (SB1 o ACK del PLC 1) y reset con SB2
//   SBR3 SBR_DIAGNOSTICO: tiempos de los cilindros, atascos y alarmas de nucleo
//   SBR4 SBR_PREPARA: marcha/pausa y preparacion de nucleos en el plato (VW332)
//   SBR5 SBR_ENSAMBLE: colocacion del nucleo en la pieza del nido (VW330)
//   SBR6 SBR_ACTUADORES: electrovalvulas Q0.0..Q0.5, focos del tablero y baliza de la planta
//   SBR7 SBR_COMMS_PPI: datos para el PLC 1 (VB200..VB207) y diagnostico VB337/VB338
// Los pasos estan en VW330/VW332 para no pisar VB100..VB103 (red PPI).
// Las ordenes PPI se toman por flanco y VB100 no se borra.
// Plato de dos nidos, uno en cada extremo del actuador giratorio (comprobado el 12-10-2026).
//   Sensores fijos: I0.2 = nucleo en el nido que esta bajo el silo, I0.3 = nucleo en el nido que esta
//   bajo la pinza. I1.1 / I1.2 = las dos posiciones del plato. La estacion trata de tener nucleo en
//   los dos nidos: si el del silo tiene y el de la pinza no, gira 180 grados; si el del silo esta vacio, suelta uno.
//   La pinza solo tiene sensor de cerrada (I1.3): el cierre se confirma por tiempo.
//   Auto y manual usan la misma secuencia; en manual cada movimiento espera SB1.
BEGIN

Network 1 // Valores iniciales (primer ciclo)
LD     SM0.1
CALL   SBR_INIT

Network 2 // Entradas, flancos y ordenes PPI
LD     SM0.0
CALL   SBR_IO_SCAN

Network 3 // Seta de emergencia, rearme y reset
LD     SM0.0
CALL   SBR_SEGURIDAD

Network 4 // Tiempos de los cilindros, atascos y alarmas de nucleo
LD     SM0.0
CALL   SBR_DIAGNOSTICO

Network 5 // Marcha y preparacion de nucleos en los dos nidos del plato
LD     SM0.0
CALL   SBR_PREPARA

Network 6 // Colocacion del nucleo en la pieza del nido
LD     SM0.0
CALL   SBR_ENSAMBLE

Network 7 // Electrovalvulas, focos del tablero y baliza de la planta
LD     SM0.0
CALL   SBR_ACTUADORES

Network 8 // Datos para el PLC 1 (red PPI)
LD     SM0.0
CALL   SBR_COMMS_PPI

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_INIT
// ==============================================================================
SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=Valores iniciales de pasos, tiempos y banderas
BEGIN

Network 1 // Pasos en reposo y buffers de red en cero
LD     SM0.0
MOVW   +0, VW330                    // Ensamble: Paso 0 = nido libre
MOVW   +0, VW332                    // Preparacion de nucleos: Paso 0 = evaluar nidos
MOVB   0, VB100                     // Ordenes del PLC 1 en cero
MOVB   0, VB101
MOVB   0, VB102
MOVB   0, VB103
MOVB   0, VB200                     // Estado para el PLC 1 en cero
MOVB   0, VB201                     // STAT_PASO en 0
MOVB   0, VB202                     // STAT_INPUTS en 0
MOVB   0, VB203                     // STAT_DATA (resultado de la fibra) en 0

Network 2 // Tiempos normales de los cilindros (ms)
LD     SM0.0
MOVW   +320, VW210                  // Bajada vertical del manipulador: 320 ms
MOVW   +300, VW212                  // Avance horizontal del manipulador: 300 ms
MOVW   +350, VW214                  // Giro del plato hacia I1.2: 350 ms
MOVW   +200, VW216                  // Retenedor superior, extender: 200 ms
MOVW   +200, VW218                  // Base inferior, retraer: 200 ms
MOVW   +250, VW220                  // Cierre de la pinza: 250 ms
MOVW   +300, VW222                  // Subida vertical del manipulador: 300 ms
MOVW   +350, VW224                  // Giro del plato hacia I1.1: 350 ms

Network 3 // Borrar banderas, alarmas y salidas
LD     SM0.0
R      M0.0, 8                      // M0.0..M0.7 (incluye M0.4 = atasco)
R      M2.0, 8                      // M2.0 = SEGURIDAD_OK, M2.1 = ESPERA_REARME, M2.2 = EMERGENCIA_ACTIVA
R      M4.0, 8                      // M4.0 = ALM_FUGA, M4.1 = ALM_ATASCO
R      M5.0, 8                      // M5.0 = PULSO_SB1, M5.1 = PULSO_SB2, M5.2 = MODO_AUTO, M5.3 = SB1 memorizado
R      M6.0, 8                      // M6.0 MARCHA, M6.1 PAUSA, M6.2 START, M6.3 ACK, M6.4 PIEZA, M6.5 SB1, M6.6 RETIRO
R      M7.0, 8                      // M7.6 = 0: el plato arranca ordenado a la posicion I1.1
R      M11.0, 8                     // M11.0 = en manual hay un movimiento listo (pulsar SB1)
R      M12.0, 8                     // Permisos de la preparacion
R      Q0.0, 8                      // Todas las salidas apagadas al arrancar
R      Q1.0, 8

Network 4 // Estado de la seta al encender
// Con la seta liberada (I2.6 = 1) hay que rearmar: SB1 local o ACK_RESET del PLC 1 (SB1 de Transporte)
LD     I2.6
=      M2.1                         // M2.1 = esperando rearme
LDN    I2.6
=      M2.2                         // M2.2 = seta accionada

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 1: SBR_IO_SCAN
// ==============================================================================
SUBROUTINE_BLOCK SBR_IO_SCAN:SBR1
TITLE=Entradas, flancos de pulsadores y ordenes del PLC 1
BEGIN

Network 1 // Selector SA1 (I2.7)
LD     I2.7
=      M5.2                         // 1 = automatico, 0 = manual

Network 2 // Flancos de SB1 (I2.5) y SB2 (I2.4), pulsadores NA
LD     I2.5
EU
=      M5.0                         // M5.0 = Pulso de un ciclo de SB1
LD     I2.4
EU
=      M5.1                         // M5.1 = Pulso de un ciclo de SB2

Network 3 // Silo de nucleos: M7.1 = hay al menos un nucleo (I0.0 o I0.1)
// M7.2 = nivel bajo (solo uno de los dos ve nucleos): dato informativo, no bloquea ni enciende focos.
LD     I0.0
O      I0.1
=      M7.1
LD     I0.0
AN     I0.1
LDN    I0.0
A      I0.1
OLD
=      M7.2

Network 4 // Ordenes del PLC 1 (VB100)
// El PLC 1 pone cada bit en 1 durante un solo envio NETW y luego en 0.
// Se toman por flanco y VB100 no se borra aqui.
LD     V100.0
EU
S      M6.2, 1                      // CMD_START (SB1 de Transporte en automatico)

LD     V100.1
EU
S      M6.7, 1                      // CMD_PAUSE

LD     V100.3
EU
S      M6.3, 1                      // CMD_ACK_RESET

LD     V100.4
EU
S      M6.4, 1                      // CMD_PIEZA_ENTREGADA (Transporte dejo la pieza en el nido y se retiro)

LD     V100.6
EU
S      M6.6, 1                      // CMD_RETIRO_CONFIRMADO (Transporte retiro la pieza ensamblada)

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 2: SBR_SEGURIDAD
// ==============================================================================
SUBROUTINE_BLOCK SBR_SEGURIDAD:SBR2
TITLE=Seta de emergencia QS (I2.6), rearme y reset con SB2
BEGIN

Network 1 // Seta accionada (I2.6 = 0, contacto NC)
LDN    I2.6
S      M2.2, 1                      // Seta accionada
R      M2.0, 1                      // Quitar SEGURIDAD_OK
R      M2.1, 1                      // Todavia no se puede rearmar
MOVW   +0, VW330                    // Cortar el ensamble
MOVW   +0, VW332                    // Cortar la preparacion
R      M6.0, 1                      // Sin marcha
R      M6.4, 1                      // Descartar aviso de pieza
R      M6.5, 1
R      M5.3, 1
R      M7.6, 1                      // Q0.2 sin energia: el plato vuelve a I1.1 y la orden se alinea
R      V200.2, 1                    // Quitar STAT_DONE

Network 2 // Seta liberada (I2.6 = 1): pasar a espera de rearme
LD     I2.6
A      M2.2                         // Venia de la seta accionada
R      M2.2, 1
S      M2.1, 1                      // Esperando rearme
R      M2.0, 1                      // Sin operar hasta el rearme

Network 3 // Rearme con SB1 local o ACK_RESET del PLC 1 (SB1 de Transporte o SCADA)
LD     M5.0
O      M6.3
A      M2.1
A      I2.6
S      M2.0, 1                      // SEGURIDAD_OK
R      M2.1, 1
R      M2.2, 1
R      M4.0, 2                      // Fuga (M4.0) y Atasco (M4.1)
R      M0.4, 1
R      M7.3, 2                      // Alarmas de nucleo (M7.3 no llego bajo la pinza, M7.4 no cayo)
R      V200.3, 1
R      V200.4, 1
R      M6.1, 1                      // Sin pausa
R      M6.3, 1                      // ACK_RESET atendido
MOVW   +0, VW330
MOVW   +0, VW332
R      M5.0, 1                      // El SB1 del rearme no arranca nada

Network 4 // ACK_RESET con la estacion ya rearmada: solo borra alarmas, no cambia los pasos
LD     M6.3
A      M2.0
R      M4.0, 2
R      M0.4, 1
R      M7.3, 2
R      V200.3, 1
R      V200.4, 1
LD     M6.3
R      M6.3, 1                      // Se borra tambien con la seta accionada

Network 5 // SB2 (I2.4 -> M5.1): los dos pasos a 0, borra alarmas y quita la marcha
LD     M5.1
MOVW   +0, VW330
MOVW   +0, VW332
R      M4.0, 2
R      M0.4, 1
R      M7.3, 2
R      V200.3, 1
R      V200.4, 1
R      M6.0, 1
R      M6.4, 1
R      M6.5, 1
R      M5.3, 1
LD     M5.1
AN     I1.2                         // Plato fuera de I1.2: la orden vuelve a la posicion I1.1
R      M7.6, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 3: SBR_DIAGNOSTICO
// ==============================================================================
SUBROUTINE_BLOCK SBR_DIAGNOSTICO:SBR3
TITLE=Tiempos de los cilindros, giro del plato y alarmas de nucleo
// Los avisos de fuga (M4.0) se evaluan solo al llegar el cilindro; SB2 los borra.
// Ensamble VW330: 50/90 bajar, 60 cerrar pinza, 70/100 subir, 80 avanzar.
// Preparacion VW332: 20 dosificar (retenedor + base), 30 cerrar base, 40 girar el plato.
BEGIN

Network 1 // Bajada vertical (T33, 10 ms) -> VW210. Pasos 50 y 90.
LD     I1.4
EU
LDW=   VW330, +50
OW=    VW330, +90
ALD
MOVW   T33, VW210
*I     +10, VW210                   // Cuentas de 10 ms a ms
AW>    VW210, +520                  // Mas de 520 ms: aviso de fuga
S      M4.0, 1

LDW=   VW330, +50
OW=    VW330, +90
AN     I1.4
TON    T33, +32767

LDW>   T33, +120                    // Atasco: 1,2 s sin I1.4
AN     I1.4
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 2 // Avance horizontal (T34, 10 ms) -> VW212. Paso 80.
LD     I1.7
EU
LDW=   VW330, +80
ALD
MOVW   T34, VW212
*I     +10, VW212
AW>    VW212, +500
S      M4.0, 1

LDW=   VW330, +80
AN     I1.7
TON    T34, +32767

LDW>   T34, +120
AN     I1.7
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 3 // Giro del plato hacia I1.2 (T35, 10 ms) -> VW214. Preparacion paso 40 con M7.6 = 1.
LD     I1.2
EU
LDW=   VW332, +40
A      M7.6
ALD
MOVW   T35, VW214
*I     +10, VW214
AW>    VW214, +550
S      M4.0, 1

LDW=   VW332, +40
A      M7.6
AN     I1.2
TON    T35, +32767

LDW>   T35, +200                    // 2 s sin llegar a I1.2: atasco
AN     I1.2
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 4 // Giro del plato hacia I1.1 (T36, 10 ms) -> VW224. Preparacion paso 40 con M7.6 = 0.
LD     I1.1
EU
LDW=   VW332, +40
AN     M7.6
ALD
MOVW   T36, VW224
*I     +10, VW224
AW>    VW224, +550
S      M4.0, 1

LDW=   VW332, +40
AN     M7.6
AN     I1.1
TON    T36, +32767

LDW>   T36, +200                    // 2 s sin llegar a I1.1: atasco
AN     I1.1
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 5 // Retenedor superior Q0.1 -> I0.5 (T97, 10 ms) -> VW216. Preparacion paso 20.
LD     I0.5
EU
LDW=   VW332, +20
ALD
MOVW   T97, VW216
*I     +10, VW216
AW>    VW216, +350
S      M4.0, 1

LDW=   VW332, +20
AN     I0.5
TON    T97, +32767

LDW>   T97, +100
AN     I0.5
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 6 // Apertura de la base Q0.0 -> I1.0 (T98, 10 ms) -> VW218. Preparacion paso 20.
LD     I1.0
EU
LDW=   VW332, +20
ALD
MOVW   T98, VW218
*I     +10, VW218
AW>    VW218, +350
S      M4.0, 1

LDW=   VW332, +20
A      I0.5
AN     I1.0
TON    T98, +32767

LDW>   T98, +100
AN     I1.0
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 7 // Cierre de la pinza Q0.3 -> I1.3 (T99, 10 ms) -> VW220. Paso 60. Solo se mide.
// La pinza solo tiene sensor de cerrada y con el nucleo dentro a veces no se activa: no da atasco.
LD     I1.3
EU
LDW=   VW330, +60
ALD
MOVW   T99, VW220
*I     +10, VW220
AW>    VW220, +450
S      M4.0, 1

LDW=   VW330, +60
AN     I1.3
TON    T99, +32767

Network 8 // Subida vertical -> I1.5 (T100, 10 ms) -> VW222. Pasos 70 y 100.
LD     I1.5
EU
LDW=   VW330, +70
OW=    VW330, +100
ALD
MOVW   T100, VW222
*I     +10, VW222
AW>    VW222, +500
S      M4.0, 1

LDW=   VW330, +70
OW=    VW330, +100
AN     I1.5
TON    T100, +32767

LDW>   T100, +120
AN     I1.5
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 9 // El nucleo no llego bajo la pinza: plato quieto (M7.7) sin I0.3 durante 1 s -> alarma M7.3
LDW=   VW332, +40
A      M7.7
AN     I0.3
TON    T41, +10
LD     T41
S      M7.3, 1
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 10 // El nucleo no cayo al nido del silo: base abierta (I1.0) sin I0.2 durante 2 s -> alarma M7.4
LDW=   VW332, +20
A      I1.0
AN     I0.2
TON    T42, +20
LD     T42
S      M7.4, 1
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 11 // Paso 30: la base no cerro o el retenedor no se retrajo en 2 s -> atasco
LDW=   VW332, +30
LD     I0.7
A      I0.6
NOT
ALD
TON    T49, +20
LD     T49
S      M4.1, 1
S      M0.4, 1
S      V200.3, 1

Network 12 // Diagnostico del plato y los nidos (VB338, ver en binario en la tabla de estado)
// bit0 I1.2 plato en posicion 180   bit1 I1.1 plato en posicion 0   bit2 I0.2 nucleo en el nido del silo
// bit3 I0.3 nucleo en el nido de la pinza   bit4 Q0.2 salida de giro   bit5 alarma nucleo no llego bajo la pinza
// bit6 alarma nucleo no cayo   bit7 M7.6 posicion ordenada del plato
LD     SM0.0
MOVB   0, VB338
LD     I1.2
=      V338.0
LD     I1.1
=      V338.1
LD     I0.2
=      V338.2
LD     I0.3
=      V338.3
LD     Q0.2
=      V338.4
LD     M7.3
=      V338.5
LD     M7.4
=      V338.6
LD     M7.6
=      V338.7

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 4: SBR_PREPARA
// ==============================================================================
SUBROUTINE_BLOCK SBR_PREPARA:SBR4
TITLE=Marcha/pausa y preparacion de nucleos en los dos nidos del plato (VW332)
// Plato de dos nidos (uno en cada extremo del actuador giratorio). Sensores fijos:
//   I0.2 = nucleo en el nido bajo el silo   I0.3 = nucleo en el nido bajo la pinza
//   M7.6 = posicion pedida (Q0.2: 1 -> I1.2, 0 -> I1.1)   M7.7 = plato quieto en esa posicion
// En el paso 0 se revisan los nidos:
//   1. Nido del silo con nucleo y nido de la pinza vacio -> girar 180 grados (paso 40)
//   2. Nido del silo vacio y hay nucleos en el silo       -> soltar un nucleo (pasos 20 y 30)
//   3. Los dos nidos con nucleo                          -> esperar (estacion lista)
// Automatico: con marcha (M6.0) corre sola, al mismo tiempo que el ensamble. Solo gira con el
//   manipulador arriba (I1.5) y fuera de los pasos 50..70 (pinza sobre el plato).
// Manual: un movimiento por cada SB1 y solo con el ensamble detenido (paso 0, 120, o 10 sin nucleo).
BEGIN

Network 1 // M11.0 = hay un movimiento listo; M5.3 = SB1 guardado en manual (se olvida a los 3 s)
LD     SM0.0
R      M11.0, 1                     // Se vuelve a calcular en cada ciclo, en los pasos que esperan SB1
LD     M5.3
TON    T46, +30
LD     T46
O      M5.2
O      M5.1
R      M5.3, 1
LD     M5.0
AN     M5.2
A      M2.0
S      M5.3, 1                      // Un SB1 pulsado antes de tiempo se ejecuta cuando termina el movimiento en curso

Network 2 // Marcha en automatico (CMD_START, SB1 local o pieza entregada) y pausa (CMD_PAUSE o SB2)
LD     M6.2                         // CMD_START del PLC 1 (SB1 de Transporte en automatico)
O      M6.4                         // Transporte dejo una pieza: la planta esta en marcha
LD     M5.0
A      M5.2                         // SB1 local en automatico
OLD
A      M2.0
S      M6.0, 1
R      M6.1, 1
LD     M6.7                         // CMD_PAUSE del PLC 1
LD     M5.1
A      M5.2                         // SB2 local en automatico
OLD
R      M6.0, 1
S      M6.1, 1
LDN    M5.2                         // En manual no hay marcha automatica
R      M6.0, 1
R      M6.1, 1
LD     SM0.0
R      M6.2, 1
R      M6.7, 1

Network 3 // Estado del plato y permisos de la preparacion
// M7.7 plato quieto en la posicion pedida | M12.0 retenedor retraido y base cerrada
// M12.1 se puede girar | M12.2 preparacion habilitada
LD     M7.6
A      I1.2
AN     I1.1
LDN    M7.6
A      I1.1
AN     I1.2
OLD
=      M7.7
LD     I0.6
A      I0.7
=      M12.0
LD     M7.7
A      M12.0
A      I1.5                         // Manipulador arriba
LDW<   VW330, +50
OW>    VW330, +70
ALD
=      M12.1
LD     M5.2                         // Automatico: con marcha y sin pausa
A      M6.0
AN     M6.1
LDN    M5.2                         // Manual: ensamble detenido
LDW=   VW330, +0
OW=    VW330, +120
LDW=   VW330, +10
AN     I0.3
OLD
ALD
OLD
A      M2.0
AN     M4.1
AN     M0.4
=      M12.2

Network 4 // Regla 1: nucleo en el nido del silo y nido de la pinza vacio -> girar 180 grados (paso 40)
LDW=   VW332, +0
A      M12.2
A      M12.1
A      I0.2                         // Nucleo en el nido bajo el silo
AN     I0.3                         // Nido bajo la pinza vacio
S      M11.0, 1                     // Manual: movimiento listo, pulsar SB1
LD     M5.2
O      M5.3
ALD
=      M12.5
LD     M12.5
A      I1.1                         // Plato en I1.1 -> pedir I1.2
S      M7.6, 1
LD     M12.5
A      I1.2                         // Plato en I1.2 -> pedir I1.1
R      M7.6, 1
LD     M12.5
MOVW   +40, VW332
R      M5.3, 1

Network 5 // Regla 2: nido del silo vacio y hay nucleos en el silo -> soltar un nucleo (paso 20)
LDW=   VW332, +0
A      M12.2
A      M7.7                         // Plato quieto: hay un nido bajo el silo
A      M12.0                        // Retenedor retraido y base cerrada
AN     I0.2                         // Nido bajo el silo vacio
A      M7.1                         // Hay nucleos en el silo
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +20, VW332
R      M5.3, 1

Network 6 // Paso 20: el retenedor sujeta la columna (Q0.1 -> I0.5) y la base se abre (Q0.0 -> I1.0): cae un nucleo
LDW=   VW332, +20
A      I0.5
A      I1.0
TON    T37, +3                      // 300 ms para que caiga el nucleo

Network 7 // Paso 20 -> 30: nucleo en el nido del silo (I0.2) -> cerrar la base y soltar el retenedor
LDW=   VW332, +20
A      T37
A      I0.2
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +30, VW332
R      M5.3, 1

Network 8 // Paso 30 -> 0: base cerrada (I0.7) y retenedor retraido (I0.6) + 300 ms -> revisar los nidos otra vez
LDW=   VW332, +30
A      I0.7
A      I0.6
TON    T38, +3
LDW=   VW332, +30
A      T38
MOVW   +0, VW332

Network 9 // Paso 40 -> 0: plato quieto en la posicion pedida (M7.7) + 300 ms y nucleo bajo la pinza (I0.3)
// Si el nucleo no aparece en 1 s salta la alarma M7.3 (SBR_DIAGNOSTICO) y la preparacion se detiene.
LDW=   VW332, +40
A      M7.7
TON    T47, +3
LDW=   VW332, +40
A      T47
A      I0.3
MOVW   +0, VW332

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 5: SBR_ENSAMBLE
// ==============================================================================
SUBROUTINE_BLOCK SBR_ENSAMBLE:SBR5
TITLE=Colocacion del nucleo en la pieza del nido (VW330)
// Pasos (auto y manual; en manual cada movimiento espera SB1):
//   0   Nido libre (STAT_READY). Pieza: CMD_PIEZA_ENTREGADA del PLC 1 (auto y manual), o SB1 con una
//       pieza blanca/metal a la vista (I0.4)
//   10  Revisa la fibra I0.4 durante 0,5 s. Si ve la pieza: blanca/metal (STAT_DATA = 1) y espera un
//       nucleo bajo la pinza. Si no la ve: negra (STAT_DATA = 5) -> 120 sin nucleo
//   50  Baja la pinza (I1.4)   60 cierra la pinza (0,5 s)   70 sube con el nucleo (I1.5)
//   80  Avanza sobre el nido (I1.7)   90 baja e inserta (I1.4 + 0,6 s)   95 abre la pinza abajo (0,4 s)
//   100 Sube (I1.5)   110 retrocede (I1.6)
//   120 Terminado (STAT_DONE). Sale con CMD_RETIRO_CONFIRMADO, SB1 o si la pieza blanca falta 2 s.
// STAT_DATA (VB203) se conserva hasta la siguiente pieza: el PLC 1 lo lee junto con STAT_DONE.
BEGIN

Network 1 // SB1 en automatico con una pieza blanca/metal a la vista y el nido libre
LD     M5.0
A      M5.2
A      I0.4
AW=    VW330, +0
S      M6.5, 1

Network 2 // Si llega un aviso de pieza con el nido ocupado se descarta
LDW<>  VW330, +0
R      M6.4, 1
R      M6.5, 1

Network 3 // Paso 0 -> 10: pieza en el nido
// Aviso de Transporte (M6.4) u orden local en auto (M6.5). En manual tambien SB1 con pieza blanca
// a la vista y la preparacion detenida.
LDN    M5.2
AW=    VW330, +0
AW=    VW332, +0
A      I0.4
A      M2.0
AN     M4.1
AN     M0.4
S      M11.0, 1                     // Manual: pieza blanca a la vista, pulsar SB1 para ensamblar

LDW=   VW330, +0
A      M2.0
AN     M4.1
AN     M0.4
LD     M6.4
O      M6.5
LDN    M5.2
A      M5.3
A      I0.4
AW=    VW332, +0
OLD
ALD
MOVW   +10, VW330
MOVB   0, VB203                     // Tipo todavia sin revisar
R      M7.5, 1                      // Pieza blanca todavia no vista
R      M6.4, 1
R      M6.5, 1
R      M6.6, 1                      // Se descarta un retiro anterior
R      M5.3, 1

Network 4 // Paso 10: revisar la fibra durante 0,5 s (T43); si la ve en algun momento = blanca/metal
LDW=   VW330, +10
TON    T43, +5
LDW=   VW330, +10
A      I0.4
S      M7.5, 1

Network 5 // Paso 10 -> 120: pieza negra (la fibra no la vio) -> sin nucleo, STAT_DONE con STAT_DATA = 5
LDW=   VW330, +10
A      T43
AN     M7.5
MOVB   5, VB203
MOVW   +120, VW330

Network 6 // Paso 10: pieza blanca o metalica -> STAT_DATA = 1 (espera un nucleo bajo la pinza)
LDW=   VW330, +10
A      T43
A      M7.5
MOVB   1, VB203

Network 7 // Paso 10 -> 50: nucleo bajo la pinza (I0.3), plato quieto y manipulador en reposo
LDW=   VW330, +10
A      T43
A      M7.5
A      I0.3
A      M7.7
AW<>   VW332, +40
A      I1.5
A      I1.6
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +50, VW330
R      M5.3, 1

Network 8 // Paso 50 -> 60: pinza abajo sobre el nucleo (I1.4) -> cerrar pinza
LDW=   VW330, +50
A      I1.4
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +60, VW330
R      M5.3, 1

Network 9 // Paso 60 -> 70: pinza cerrada 0,5 s (T44). I1.3 no se exige porque a veces no se activa.
LDW=   VW330, +60
TON    T44, +5
LDW=   VW330, +60
A      T44
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +70, VW330
R      M5.3, 1

Network 10 // Paso 70 -> 80: arriba con el nucleo (I1.5) -> avanzar sobre el nido
LDW=   VW330, +70
A      I1.5
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +80, VW330
R      M5.3, 1

Network 11 // Paso 80 -> 90: adelante sobre el nido (I1.7) -> bajar e insertar
LDW=   VW330, +80
A      I1.7
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +90, VW330
R      M5.3, 1

Network 12 // Paso 90 -> 95: inserta 600 ms (T39) -> abrir la pinza abajo
LDW=   VW330, +90
A      I1.4
TON    T39, +6
LDW=   VW330, +90
A      T39
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +95, VW330
R      M5.3, 1

Network 13 // Paso 95 -> 100: pinza abierta 400 ms (T45) -> subir
LDW=   VW330, +95
TON    T45, +4
LDW=   VW330, +95
A      T45
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +100, VW330
R      M5.3, 1

Network 14 // Paso 100 -> 110: arriba (I1.5) -> retroceder sobre el plato
LDW=   VW330, +100
A      I1.5
AN     M4.1
AN     M0.4
S      M11.0, 1
LD     M5.2
O      M5.3
ALD
MOVW   +110, VW330
R      M5.3, 1

Network 15 // Paso 110 -> 120: atras (I1.6) -> ensamble terminado (sin pulsar, tambien en manual)
LDW=   VW330, +110
A      I1.6
AN     M4.1
AN     M0.4
MOVW   +120, VW330

Network 16 // Paso 120 -> 0: retiro confirmado (M6.6), SB1, o pieza blanca fuera del nido 2 s (T48)
LDW=   VW330, +120
AB=    VB203, 1
AN     I0.4
TON    T48, +20
LDW=   VW330, +120
LD     M6.6
O      T48
LD     M5.0
A      M5.2
OLD
LD     M5.3
AN     M5.2
OLD
ALD
MOVW   +0, VW330
R      M6.6, 1
R      M5.3, 1

Network 17 // M7.0 = pieza blanca esperando un nucleo bajo la pinza (foco amarillo 1 Hz, VB337 bit 2)
LDW=   VW330, +10
A      T43
A      M7.5
AN     I0.3
=      M7.0

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 6: SBR_ACTUADORES
// ==============================================================================
SUBROUTINE_BLOCK SBR_ACTUADORES:SBR6
TITLE=Salidas: electrovalvulas, focos del tablero y baliza de la planta
BEGIN

Network 1 // Base del silo Q0.0 (mangueras invertidas: 0 = cerrada/extendida, 1 = abrir/retraer)
// Se abre solo en el paso 20 de la preparacion, con la columna ya sujeta por el retenedor (I0.5).
LDW=   VW332, +20
A      I0.5
A      M2.0
AN     M4.1
AN     M0.4
=      Q0.0

Network 2 // Retenedor superior Q0.1 (1 = sujetar la columna)
// Paso 20. En el paso 30, con una alarma o un reset, sigue sujetando hasta que la base cierre (I0.7).
LDW=   VW332, +20
AN     M4.1
AN     M0.4
LDW=   VW332, +30
O      Q0.1
AN     I0.7
OLD
A      M2.0
=      Q0.1

Network 3 // Plato de dos nidos Q0.2 = posicion pedida M7.6 (1 = posicion I1.2, 0 = posicion I1.1)
// Las alarmas no lo cortan (no debe girar con la pinza encima). La seta lo devuelve a I1.1.
LD     M7.6
A      M2.0
=      Q0.2

Network 4 // Pinza Q0.3 (1 = cerrar): pasos 60..90. Con una alarma la pinza no suelta el nucleo.
LDW>=  VW330, +60
AW<=   VW330, +90
A      M2.0
=      Q0.3

Network 5 // Vertical del manipulador Q0.4 (1 = bajar): pasos 50, 60, 90 y 95. Con una alarma sube.
LDW=   VW330, +50
OW=    VW330, +60
OW=    VW330, +90
OW=    VW330, +95
A      M2.0
AN     M4.1
AN     M0.4
=      Q0.4

Network 6 // Horizontal del manipulador Q0.5 (1 = adelante): pasos 80..100. Con una alarma se queda donde esta.
LDW>=  VW330, +80
AW<=   VW330, +100
A      M2.0
=      Q0.5

Network 7 // Foco verde HL1 (Q1.6): automatico en marcha / manual con un ciclo en curso
LD     M5.2
A      M6.0
AN     M6.1
LDN    M5.2
LDW<>  VW330, +0
OW<>   VW332, +0
ALD
OLD
A      M2.0
AN     M4.1
AN     M0.4
=      Q1.6

Network 8 // Foco amarillo HL2 (Q1.5)
// Fijo: automatico sin marcha o en pausa (pulsar SB1 de Transporte o de esta estacion) / manual sin nada pendiente
// 2 Hz: manual con un movimiento listo (pulsar SB1) / esperando rearme despues de la seta
// 1 Hz: pieza blanca esperando nucleo, silo vacio con un nido por llenar, aviso de fuga
LD     M5.2
AN     M6.0
O      M6.1
LDN    M5.2
AN     M11.0
OLD
LDN    M5.2
A      M11.0
O      M2.1
A      SM0.4
OLD
LD     M7.0
O      M4.0
LDN    M7.1
LDN    I0.2
ON     I0.3
ALD
OLD
A      SM0.5
OLD
AN     M2.2
A      I2.6
=      Q1.5

Network 9 // Foco rojo HL3 (Q1.7): seta QS o alarma (atasco, el nucleo no cayo o no llego). Se borra con SB2.
LDN    I2.6
O      M2.2
O      M4.1
O      M0.4
=      Q1.7

Network 10 // Baliza de la planta: VB103 (contador del PLC 1) tiene que ir cambiando
// Si el PLC 1 no escribe nada durante 5 s (T40), la baliza muestra que se perdio la comunicacion.
LDB<>  VB103, VB336
MOVB   VB103, VB336
R      T40, 1                       // Llego un dato nuevo: reiniciar T40
LDB=   VB103, VB336
TON    T40, +50                     // 5 s sin datos del PLC 1

Network 11 // Baliza roja Q0.6: fija (VB102 bit 3), intermitente (bit 4, seta local o sin PLC 1)
LD     V102.3                       // Alarma en la planta
LD     V102.4                       // Seta accionada en alguna estacion
O      T40                          // Sin comunicacion con el PLC 1
LDN    I2.6                         // Seta local (responde sin esperar a la red)
O      M2.2
OLD
A      SM0.5                        // Parpadeo a 1 Hz
OLD
=      Q0.6

Network 12 // Baliza amarilla Q0.7: fija (bit 1, detenida/manual), intermitente (bit 2, avisos) o sin PLC 1
LD     V102.1
LD     V102.2
O      T40
A      SM0.5
OLD
AN     V102.4                       // Con la seta accionada solo parpadea la roja
=      Q0.7

Network 13 // Baliza verde Q1.0: planta produciendo en automatico sin alarmas
LD     V102.0
AN     T40
A      I2.6
AN     M2.2
=      Q1.0

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 7: SBR_COMMS_PPI
// ==============================================================================
SUBROUTINE_BLOCK SBR_COMMS_PPI:SBR7
TITLE=Datos para el PLC 1 (VB200..VB207) y diagnostico VB337 / VB338
BEGIN

Network 1 // VB200 (STAT_GLOBAL): byte de estado, igual en auto y manual
// Bit 0: STAT_READY: nido libre (paso 0 del ensamble) y sin alarmas. La preparacion no lo afecta.
LDW=   VW330, +0
A      M2.0
AN     M4.1
AN     M0.4
=      V200.0

// Bit 1: STAT_BUSY: pieza en proceso (pasos 10..110)
LDW>=  VW330, +10
AW<=   VW330, +110
=      V200.1

// Bit 2: STAT_DONE: ensamble terminado o pieza negra lista (paso 120)
LDW=   VW330, +120
=      V200.2

// Bit 3: STAT_ALM_ATASCO
LD     M4.1
O      M0.4
=      V200.3

// Bit 4: STAT_ALM_FUGA (aviso de fuga o lentitud)
LD     M4.0
=      V200.4

// Bit 5: STAT_SILO_EMPTY (ningun sensor de silo ve nucleos)
LDN    M7.1
=      V200.5

// Bit 6: seta QS (I2.6) accionada o sin liberar (para la baliza de la planta)
LDN    I2.6
O      M2.2
=      V200.6

// Bit 7: STAT_HOMED (mecanismos en reposo y plato quieto)
LD     I0.6
A      I0.7
A      M7.7
A      I1.5
A      I1.6
A      M2.0
=      V200.7

Network 2 // VB201 (STAT_PASO): paso del ensamble para el SCADA (byte bajo de VW330 = VB331)
LD     SM0.0
MOVB   VB331, VB201

Network 3 // VB202 (STAT_INPUTS): copia de IB0
LD     SM0.0
MOVB   IB0, VB202

Network 4 // VB203 (STAT_DATA): 1 = blanca/metal con nucleo, 5 = negra. Lo escribe SBR_ENSAMBLE.

Network 5 // Que esta esperando Ensamblaje (VB337, ver en binario en la tabla de estado)
// bit0 auto sin marcha o en pausa (SB1 de Transporte o local)   bit1 nido libre esperando pieza
// bit2 pieza blanca esperando nucleo bajo la pinza   bit3 esperando que Transporte retire la pieza
// bit4 silo vacio   bit5 seguridad sin rearmar   bit6 alarma (reset con SB2)   bit7 manual: pulsar SB1
LD     SM0.0
MOVB   0, VB337
LD     M5.2
AN     M6.0
O      M6.1
=      V337.0
LDW=   VW330, +0
=      V337.1
LD     M7.0
=      V337.2
LDW=   VW330, +120
=      V337.3
LDN    M7.1
=      V337.4
LDN    M2.0
=      V337.5
LD     M4.1
O      M0.4
=      V337.6
LDN    M5.2
A      M11.0
=      V337.7

Network 6 // VB204..VB207: datos extra para el SCADA (el PLC 1 lee 8 bytes)
// VB204 = IB1 (base, plato, pinza, manipulador)   VB205 = QB0 (electrovalvulas y baliza roja/amarilla)
// VB206 bits 4..7 = IB2 (SB2, SB1, seta, selector) y bits 0..3 = paso de preparacion / 10 (0, 2, 3, 4)
// VB207 diagnostico de espera (VB337)
LD     SM0.0
MOVB   IB1, VB204
MOVB   QB0, VB205
MOVW   VW332, VW334                 // VW334: auxiliar libre
/I     +10, VW334
MOVB   IB2, VB206
ANDB   16#F0, VB206
ORB    VB335, VB206
MOVB   VB337, VB207

END_SUBROUTINE_BLOCK
