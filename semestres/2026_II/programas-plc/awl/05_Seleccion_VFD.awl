ORGANIZATION_BLOCK MAIN:OB1
TITLE=Unidad 5: Seleccion y variador (PLC 5)
// Planta XK-335B - Unidad 5: Seleccion
// Cinta con variador Powtran PI9100A, clasificacion de piezas y tres desviadores.
// CPU 224XP-CN (2 puertos RS-485, salida analogica AQW0).
// Puerto 0: esclavo PPI, direccion 5, 19200 bps, 8-E-1.
// Puerto 1: maestro Modbus RTU hacia el variador (19200 bps, 8-N-1, direccion 1).
// Cambios respecto a la version anterior del programa:
//   [C1] Los pasos auto/manual estaban en VW100/VW102 y se pisaban con VB100..VB103,
//        que escribe el PLC 1 por la red. Ahora: paso auto = VW330, paso manual = VW332.
//   [C2] Los bytes de error VB4100/VB4101 estaban dentro de la memoria de la libreria
//        Modbus (VB4000..VB4285). Ahora estan en VB345 (MBUS_CTRL_P1) y VB344 (MBUS_MSG_P1).
//   [C3] F0.11 (fuente de comandos) se escribia en 40018 = 0x0011 = F0.17 (ajuste de la
//        portadora, rango 0..1): el variador respondia con excepcion y nunca pasaba a mando
//        por comunicacion. Segun el manual de Powtran (F3.12 -> F30C) la direccion es
//        F0.11 -> 0xF00B -> RAM 0x000B -> Modbus 40012.
//   [C4] VW340 se trababa en los pasos 20/30/40: el EN de MBUS_MSG_P1 bajaba a 0 en el
//        segundo ciclo (AN M14.4 despues de S M14.4) y el bloque nunca daba Done.
//        Ahora hay una sola llamada a MBUS_MSG_P1 (EN = M14.2 hasta Done), First de un
//        ciclo, tiempo maximo T45, reintentos y vuelta al paso 100.
//   [C5] En automatico modo 2, la network de pausa ponia VW350 = 0 en cada ciclo (error
//        de pila LPP/LDW=) y la cinta nunca arrancaba. VW350 ahora se calcula en un solo
//        lugar (SBR_ACTUADORES).
//   [C6] T44 de la prueba manual (paso 70) contaba 3 s desde la transicion, aunque no se
//        hubiera enviado la trama. Ahora cuenta VW388 (10 s) desde que se confirma la marcha
//        (modo 1 inmediata, modo 2 con la respuesta Modbus); T48 corta a los 6 s si no se confirma.
// Modos del variador (se cambian en RAM, sin gastar la EEPROM):
//   Modo 2 (por defecto, Modbus, VW308 = 2):
//     RAM 0x0003 (F0.03) = 9 [40004]  frecuencia por comunicacion
//     RAM 0x000B (F0.11) = 2 [40012]  comandos por comunicacion
//     Marcha/paro 0x2000 [48193]: 1 = marcha adelante, 6 = paro con rampa, 5 = paro libre
//     Consigna    0x1000 [44097]: 6000 = 30 Hz (VW366), 3600 = 18 Hz (VW368)
//     Q0.0 = 0 y AQW0 = 0 siempre.
//   Modo 1 (analogico/digital, VW308 = 1):
//     RAM 0x0003 (F0.03) = 2 [40004]  frecuencia por AI1 (0-10 V)
//     RAM 0x000B (F0.11) = 1 [40012]  comandos por bornes DI
//     Marcha Q0.0 = 1, consigna AQW0: 19200 = 30 Hz (VW370), 11520 = 18 Hz (VW372)
//     El puerto 1 solo lee datos (0x1001..0x1004 cada 200 ms).
//   Rampas en RAM (F0.15 = 1, base 0,1 s): 0x000D = VW362 (10 = 1 s), 0x000E = VW364 (5 = 0,5 s)
// Memoria V (todo debajo de VB1000; la libreria Modbus usa VB4000 en adelante):
//   VB100..VB103 : ordenes del PLC 1 (NETW, 4 bytes)
//                  VB100 = CMD_CONTROL, VB101 = tipo (5 = negra), VB102 = modo del variador pedido
//   VB200..VB212 : datos para el PLC 1 (NETR, 13 bytes)
//                  VB200 estado, VB201 paso, VB202 IB0, VB203 rampa,
//                  VW204 frecuencia real (0,01 Hz), VW206 corriente (0,01 A),
//                  VW208 bus DC (0,1 V), VB210 modo del variador, VB211 error Modbus, VB212 QB0
//   VW220..VW224 : tiempos de los desviadores (ms)
//   VW300        : tipo de pieza en curso (1..5)
//   VW308        : modo del variador (1 = analogico, 2 = Modbus)
//   VW310..VW328 : cotas del HSC0 (inspeccion, paradas y cambio a 18 Hz)
//   VW330 / VW332: paso automatico / paso manual
//   VW340        : paso de la secuencia Modbus
//   VB343..VB347 : reintentos maximos, error MSG, error CTRL, contador de reintentos, -
//   VW350 / VW352: orden pedida / orden confirmada (0 paro, 1 30 Hz, 2 18 Hz, 3 paro libre)
//   VW354..VW358 : orden en curso / copia del paso / ultimo paso que fallo
//   VW360        : dato a escribir por Modbus (1 registro)
//   VW362..VW372 : rampas y consignas Modbus y analogicas (se pueden cambiar en marcha)
//   VB374..VD382 : parametros de MBUS_MSG_P1
//   VW386        : consigna analogica calculada (unica escritura en AQW0)
//   VW388        : duracion de la prueba manual de la cinta (x 100 ms)
//   VW400..VW406 : datos del variador (0x1001 frecuencia, 0x1002 bus DC, 0x1003 tension de salida, 0x1004 corriente)
//   VB4000..VB4299 : reservado para la libreria Modbus maestro (asignar en Micro/WIN)
BEGIN

Network 1 // Valores iniciales (primer ciclo)
LD     SM0.1
CALL   SBR_INIT

Network 2 // Entradas, flancos y ordenes del PLC 1
LD     SM0.0
CALL   SBR_IO_SCAN

Network 3 // Seta de emergencia y rearme
LD     SM0.0
CALL   SBR_SEGURIDAD

Network 4 // Tiempos de los desviadores y atascos
LD     SM0.0
CALL   SBR_DIAGNOSTICO

Network 5 // Secuencia manual (SA1 = 0)
LDN    M5.2                         // SA1 en manual (I1.5 = 0)
CALL   SBR_MAN_STEP

Network 6 // Secuencia automatica con el HSC0 (SA1 = 1)
LD     M5.2                         // SA1 en automatico (I1.5 = 1)
CALL   SBR_SECUENCIA_AUTO

Network 7 // Orden de la cinta VW350, Q0.0/AQW0 (modo 1), desviadores y focos
LD     SM0.0
CALL   SBR_ACTUADORES

Network 8 // Modbus maestro en el puerto 1: parametros en RAM, ordenes y lectura de datos
LD     SM0.0
CALL   SBR_VFD_MODBUS

Network 9 // Datos para el PLC 1 (red PPI)
LD     SM0.0
CALL   SBR_COMMS_PPI

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_INIT
// ==============================================================================
SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=Valores iniciales de pasos, cotas y buffers
BEGIN

Network 1 // Pasos en reposo y salida analogica en 0 V
LD     SM0.0
MOVW   +0, VW330                    // Paso automatico = 0
MOVW   +0, VW332                    // Paso manual = 0
MOVW   +0, VW300                    // Tipo de pieza en curso (0..5)
MOVW   +0, VW386                    // Consigna analogica calculada = 0
MOVW   +0, AQW0                     // 0 V en reposo

Network 2 // Variador en modo 2 (Modbus) y secuencia Modbus en el paso 0
LD     SM0.0
MOVW   +2, VW308                    // VW308 = 2: modo Modbus por defecto
MOVW   +0, VW350                    // Orden pedida: 0 = paro con rampa
MOVW   +99, VW352                   // Orden confirmada no valida: obliga a enviar el paro al arrancar
MOVW   +0, VW354                    // Orden en curso
MOVW   +0, VW340                    // Paso Modbus 0: esperar MBUS_CTRL_P1
MOVW   +0, VW358                    // Ultimo paso Modbus que fallo
MOVB   3, VB343                     // 3 intentos por trama
MOVB   0, VB344                     // Error MBUS_MSG_P1
MOVB   0, VB345                     // Error MBUS_CTRL_P1
MOVB   0, VB346                     // Contador de reintentos

Network 3 // Parametros del variador (rampas en RAM, consignas Modbus y analogicas)
LD     SM0.0
MOVW   +10, VW362                   // Rampa de aceleracion RAM 0x000D: 10 = 1 s (F0.15 = 0,1 s)
MOVW   +5, VW364                    // Rampa de desaceleracion RAM 0x000E: 5 = 0,5 s
MOVW   +6000, VW366                 // Consigna Modbus 0x1000 marcha normal: 6000 = 60 % de 50 Hz = 30 Hz
MOVW   +3600, VW368                 // Consigna Modbus 0x1000 acercamiento: 3600 = 18 Hz
MOVW   +19200, VW370                // Consigna AQW0 marcha normal: 19200 = 6 V = 30 Hz
MOVW   +11520, VW372                // Consigna AQW0 acercamiento: 11520 = 3,6 V = 18 Hz
MOVW   +100, VW388                  // Duracion de la prueba manual (paso 70): 100 x 100 ms = 10 s
MOVW   +2, VW390                    // Sentido de giro: 1 = adelante, 2 = atras (en la planta el motor giraba al reves con 1)
MOVB   0, VB392                     // Medicion de cotas apagada (V392.0 = 1 la activa)
MOVW   +7, VW394                    // Espera antes de empujar: 7 x 100 ms = 0,7 s con la cinta detenida
MOVB   1, VB374                     // Direccion Modbus del variador = 1

Network 4 // Cotas del HSC0: inspeccion y paradas
LD     SM0.0
// Medidas en la planta el 12-10-2026, 2 corridas (encoder en cuadratura x4, pieza metalica a 18 Hz):
//   Inductivo I0.5: 1860..2263 / 1990..2170     Fibra I0.4: 1803..~2267 / 1875..2322
//   Rampa 1: 2866 / 2808 -> 2837   Rampa 2: 4320 / 4524 -> 4422   Rampa 3: 5976 / 6113 -> 6045
//   Fin de cinta (donde recoge el brazo): 7769   Frenado a 18 Hz: 83 / 115 -> 100 cuentas
//   Cota de parada = posicion media - 100 (la pieza queda centrada); cambio a 18 Hz = parada - 500.
MOVW   +2080, VW310                 // Inspeccion: centro de la zona donde los dos sensores ven la pieza (1990..2170)
MOVW   +2737, VW312                 // Parada rampa 1: 2837 - 100 (tipo 1)
MOVW   +4322, VW314                 // Parada rampa 2: 4422 - 100 (tipo 2)
MOVW   +5945, VW316                 // Parada rampa 3: 6045 - 100 (tipo 3)
MOVW   +7769, VW318                 // Parada fin de cinta: 7769, medida en la segunda corrida (tipos 4 y 5, recoge el brazo)

Network 5 // Cotas donde la cinta baja a 18 Hz (parada - 500 cuentas)
LD     SM0.0
MOVW   +2237, VW322                 // Rampa 1: 2737 - 500 (despues de la inspeccion en 2080)
MOVW   +3822, VW324                 // Rampa 2: 4322 - 500
MOVW   +5445, VW326                 // Rampa 3: 5945 - 500
MOVW   +7269, VW328                 // Fin de cinta: 7769 - 500

Network 6 // Tiempos normales de los desviadores (ms)
LD     SM0.0
MOVW   +180, VW220                  // Desviador 1: 180 ms
MOVW   +180, VW222                  // Desviador 2: 180 ms
MOVW   +180, VW224                  // Desviador 3: 180 ms

Network 7 // Borrar banderas, alarmas y salidas
LD     SM0.0
R      M1.0, 8                      // Banderas auxiliares M1.0..M1.7
R      M2.0, 8                      // M2.0 = SEGURIDAD_OK, M2.1 = ESPERA_REARME, M2.2 = EMERGENCIA_ACTIVA
R      M4.0, 8                      // M4.0 = ALM_FUGA, M4.1 = ALM_ATASCO
R      M5.0, 8                      // M5.0 = PULSO_SB1, M5.1 = PULSO_SB2, M5.2 = MODO_AUTO
R      M6.0, 8                      // M6.1 PAUSA, M6.2 ESTOP_REMOTO, M6.3 ACK, M6.4 PIEZA, M6.5 TIPO5, M6.6 PERMISO
R      M7.0, 8                      // Pulsos de flanco de las ordenes PPI
R      M11.0, 8                     // Permisos del manual (M11.1..M11.6) y M11.7 marcha confirmada
R      M12.0, 8                     // Banderas auxiliares del manual
R      M14.0, 8                     // Banderas de Modbus M14.0..M14.7
R      M15.0, 8                     // Banderas de la secuencia Modbus M15.0..M15.7
R      Q0.0, 8                      // Salidas digitales apagadas
R      Q1.0, 8

Network 8 // Buffers de red en cero
LD     SM0.0
MOVB   0, VB100                     // CMD_CONTROL
MOVB   0, VB101                     // Tipo de pieza = 0
MOVB   0, VB102                     // Modo del variador pedido = 0 (sin cambio)
MOVB   0, VB103                     // Sin uso
MOVB   0, VB200                     // STAT_GLOBAL
MOVB   0, VB201                     // STAT_PASO
MOVB   0, VB202                     // STAT_INPUTS
MOVB   0, VB203                     // STAT_DATA (rampa asignada)
MOVW   +0, VW204                    // Frecuencia
MOVW   +0, VW206                    // Corriente
MOVW   +0, VW208                    // Bus DC
MOVB   2, VB210                     // Modo del variador
MOVB   0, VB211                     // Error Modbus

Network 9 // Estado de la seta al encender
LD     I1.4
=      M2.1                         // M2.1 = esperando rearme si la seta esta liberada
LDN    I1.4
=      M2.2                         // M2.2 = seta accionada

Network 10 // Configurar el contador rapido HSC0
LD     SM0.0
CALL   SBR_HSC0_CONFIG

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 1: SBR_IO_SCAN
// ==============================================================================
SUBROUTINE_BLOCK SBR_IO_SCAN:SBR1
TITLE=Entradas, flancos de pulsadores y ordenes del PLC 1
BEGIN

Network 1 // Selector SA1 (I1.5)
LD     I1.5
=      M5.2                         // 1 = automatico, 0 = manual

Network 2 // Flanco de SB1 (I1.3, NA), marcha / avance
LD     I1.3
EU
=      M5.0                         // M5.0 = pulso de un ciclo al pulsar SB1

Network 3 // Flanco de SB2 (I1.2, NA), pausa / reset
LD     I1.2
EU
=      M5.1                         // M5.1 = pulso de un ciclo al pulsar SB2

Network 4 // Sensores de entrada, inspeccion y desviadores
LD     I0.3
=      M2.3                         // Fotoelectrico en la entrada de la cinta
LD     I0.4
=      M2.4                         // Fibra vertical a 10 cm (nucleo)
LD     I0.5
=      M2.5                         // Inductivo lateral a 10 cm (base metalica)
LD     I0.7
=      M2.7                         // Desviador 1 extendido
LD     I1.0
=      M3.0                         // Desviador 2 extendido
LD     I1.1
=      M3.1                         // Desviador 3 extendido

Network 5 // Ordenes del PLC 1 (VB100)
// El PLC 1 pone cada bit en 1 durante un solo envio NETW y luego en 0.
// Aqui se toma el flanco de subida y VB100 no se borra, asi una misma orden
// reescrita por el maestro no se ejecuta dos veces.
LD     V100.0
EU
=      M7.0                         // CMD_START: quitar pausa / emergencia remota
LD     V100.1
EU
=      M7.1                         // CMD_PAUSE
LD     V100.2
EU
=      M7.2                         // CMD_ESTOP (seta QS de la planta, en el PLC 1)
LD     V100.3
EU
=      M7.3                         // CMD_ACK_RESET
LD     V100.4
EU
=      M7.4                         // CMD_PIEZA_ENTREGADA (Transporte dejo la pieza en la cinta)
LD     V100.6
EU
=      M7.6                         // BELT_PERMIT_RUN que el PLC 1 trae del brazo

Network 6 // Guardar las ordenes del PLC 1
LD     M7.1
S      M6.1, 1                      // Pausa remota
LD     M7.2
S      M6.2, 1                      // Emergencia remota: paro libre y espera
S      M6.1, 1
LD     M7.0
R      M6.1, 1                      // Continuar
R      M6.2, 1
LD     M7.3
S      M6.3, 1                      // ACK_RESET (se atiende en SBR_SEGURIDAD)
LD     M7.4
S      M6.4, 1                      // Pieza en la entrada de la cinta
LD     M7.6
S      M6.6, 1                      // Permiso del brazo (se atiende en el paso 60)

Network 7 // Cambio de modo del variador pedido por la red (VB102): 1 = analogico, 2 = Modbus
// Solo con la cinta parada y confirmada (VW350 = 0 y VW352 = 0), nunca en marcha.
// VW340 no se toca: en el paso 100 la secuencia Modbus ve M14.3 = 0 y vuelve a escribir la RAM
// sin cortar ninguna trama en curso.
LDB=   VB102, 1
AW<>   VW308, +1
AW=    VW350, +0
AW=    VW352, +0
MOVW   +1, VW308                    // Pasar a modo 1 (analogico/digital)
R      M14.3, 1                     // Volver a escribir la RAM (F0.03 = 2, F0.11 = 1)
LDB=   VB102, 2
AW<>   VW308, +2
AW=    VW350, +0
AW=    VW352, +0
MOVW   +2, VW308                    // Pasar a modo 2 (Modbus)
R      M14.3, 1                     // Volver a escribir la RAM (F0.03 = 9, F0.11 = 2)
MOVW   +99, VW352                   // Volver a enviar el paro por Modbus

Network 8 // Sentido de la cinta pedido desde el SCADA por el PLC 1 (VB103): 0 = sin cambio, 1 = adelante, 2 = atras
// Igual que el modo: solo con la cinta parada y confirmada. Vale para la siguiente orden de marcha.
LDB=   VB103, 1
AW<>   VW390, +1
AW=    VW350, +0
AW=    VW352, +0
MOVW   +1, VW390
LDB=   VB103, 2
AW<>   VW390, +2
AW=    VW350, +0
AW=    VW352, +0
MOVW   +2, VW390

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 2: SBR_SEGURIDAD
// ==============================================================================
SUBROUTINE_BLOCK SBR_SEGURIDAD:SBR2
TITLE=Seta de emergencia QS (I1.4) y rearme con SB1
BEGIN

Network 1 // Seta accionada (I1.4 = 0, contacto NC)
// La orden de la cinta (VW350 = 3, paro libre) y Q0.0/AQW0 se calculan en
// SBR_ACTUADORES a partir de M2.2; aqui solo se corta la secuencia.
LDN    I1.4
LPS
S      M2.2, 1                      // Seta accionada
R      M2.0, 1                      // Quitar SEGURIDAD_OK
R      M2.1, 1                      // Todavia no se puede rearmar
MOVW   +0, VW330                    // Paso automatico a 0
MOVW   +0, VW332                    // Paso manual a 0
R      M6.4, 1                      // Descartar pieza pendiente
R      M6.6, 1                      // Descartar permiso del brazo pendiente
R      M11.0, 8                     // Quitar permisos del manual
LRD
RI     Q0.0, 1                      // Cortar la marcha del variador (DI1) de inmediato
R      Q0.1, 1                      // Sentido del variador (DI2) apagado
R      Q0.4, 3                      // Retraer los 3 desviadores
LPP
R      V200.1, 1                    // Quitar STAT_BUSY
R      V200.2, 1                    // Quitar STAT_DONE
R      V200.6, 1                    // Quitar STAT_ROBOT_WAIT

Network 2 // Seta liberada (I1.4 = 1): pasar a espera de rearme
LD     I1.4
A      M2.2
R      M2.2, 1                      // Seta liberada
S      M2.1, 1                      // Esperando rearme
R      M2.0, 1                      // Sin operar hasta SB1

Network 3 // Rearme con SB1 (I1.3 -> M5.0) o ACK_RESET del PLC 1, solo esperando rearme
LD     M5.0                         // SB1 local
O      M6.3                         // ACK_RESET del PLC 1
A      M2.1                         // Solo si espera rearme
A      I1.4                         // Seta liberada
LPS
S      M2.0, 1                      // SEGURIDAD_OK
R      M2.1, 1                      // Ya no espera rearme
R      M2.2, 1                      // Seta accionada = 0
R      M4.0, 2                      // Borrar fuga (M4.0) y atasco (M4.1)
R      M14.6, 1                     // Borrar alarma de comunicacion con el variador
R      V200.3, 1                    // Quitar STAT_ALM_ATASCO
R      V200.4, 1                    // Quitar STAT_ALM_FUGA
LRD
R      M6.1, 1                      // Quitar pausa
R      M6.2, 1                      // Quitar emergencia remota
R      M6.3, 1                      // ACK_RESET atendido
MOVW   +0, VW330                    // Paso 0
MOVW   +0, VW332
LPP
R      M5.0, 1                      // El SB1 del rearme no arranca el paso 10 del manual

Network 4 // ACK_RESET con la estacion ya rearmada: solo borra alarmas, no cambia los pasos
// El PLC 1 lo envia con cada SB1 de Transporte en automatico; no debe cortar la cinta.
LD     M6.3
A      M2.0
R      M4.0, 2
R      M14.6, 1
R      V200.3, 1
R      V200.4, 1
LD     M6.3
R      M6.3, 1                      // Se borra tambien con la seta accionada

Network 5 // SB2 (I1.2 -> M5.1): volver al paso 0
LD     M5.1
LPS
MOVW   +0, VW330                    // Paso automatico a 0
MOVW   +0, VW332                    // Paso manual a 0 (tambien corta la prueba del paso 70)
R      M4.0, 2                      // Borrar atasco y fuga
R      M14.6, 1                     // Borrar alarma de comunicacion con el variador
R      V200.3, 1
R      V200.4, 1
LRD
R      M11.0, 8
R      M6.4, 1
R      M6.6, 1
LPP
R      Q0.4, 3                      // Retraer los 3 desviadores

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 3: SBR_DIAGNOSTICO
// ==============================================================================
SUBROUTINE_BLOCK SBR_DIAGNOSTICO:SBR3
TITLE=Tiempos de los desviadores (VW220..VW224) y alarmas de atasco
BEGIN

Network 1 // Desviador 1, extender: T33 (10 ms) -> VW220
// El desviador 1 actua en el paso 30 automatico o en el paso 10 manual
LD     I0.7
EU
LDW=   VW330, +30
OW=    VW332, +10
ALD
MOVW   T33, VW220                   // Cuentas de 10 ms
*I     +10, VW220                   // Cuentas de 10 ms a ms
AW>    VW220, +350                  // Mas de 350 ms: aviso de fuga
S      M4.0, 1

LDW=   VW330, +30
OW=    VW332, +10
AN     I0.7
TON    T33, +32767

LDW>   T33, +150                    // 1,5 s sin confirmar
AN     I0.7
S      M4.1, 1                      // Alarma de atasco

Network 2 // Desviador 2, extender: T34 (10 ms) -> VW222
LD     I1.0
EU
LDW=   VW330, +40
OW=    VW332, +30
ALD
MOVW   T34, VW222
*I     +10, VW222
AW>    VW222, +350
S      M4.0, 1

LDW=   VW330, +40
OW=    VW332, +30
AN     I1.0
TON    T34, +32767

LDW>   T34, +150
AN     I1.0
S      M4.1, 1

Network 3 // Desviador 3, extender: T35 (10 ms) -> VW224
LD     I1.1
EU
LDW=   VW330, +50
OW=    VW332, +50
ALD
MOVW   T35, VW224
*I     +10, VW224
AW>    VW224, +350
S      M4.0, 1

LDW=   VW330, +50
OW=    VW332, +50
AN     I1.1
TON    T35, +32767

LDW>   T35, +150
AN     I1.1
S      M4.1, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 4: SBR_MAN_STEP
// ==============================================================================
SUBROUTINE_BLOCK SBR_MAN_STEP:SBR4
TITLE=Secuencia manual paso a paso (VW332) con SB1 y prueba de la cinta
BEGIN

Network 1 // Paso 0 -> 10: extender el desviador 1
LDW=   VW332, +0
A      M2.0
AN     M4.1
A      M5.0                         // SB1 (I1.3)
MOVW   +10, VW332                   // Paso 10: extender desviador 1 (Q0.4 = 1)
R      M11.1, 1

Network 2 // Paso 10: desviador 1 extendido (I0.7)
LDW=   VW332, +10
A      I0.7
AN     M4.1
S      M11.1, 1

Network 3 // Paso 10 -> 20: retraer el desviador 1
LDW=   VW332, +10
A      M11.1
A      M5.0
AN     M4.1
MOVW   +20, VW332                   // Paso 20: retraer desviador 1 (Q0.4 = 0)
R      M11.1, 1
R      M11.2, 1

Network 4 // Paso 20: desviador 1 retraido (400 ms con T40 e I0.7 apagado)
LDW=   VW332, +20
TON    T40, +4                      // 400 ms (base 100 ms)
LDW=   VW332, +20
AN     I0.7
A      T40
AN     M4.1
S      M11.2, 1

Network 5 // Paso 20 -> 30: extender el desviador 2
LDW=   VW332, +20
A      M11.2
A      M5.0
AN     M4.1
MOVW   +30, VW332                   // Paso 30: extender desviador 2 (Q0.5 = 1)
R      M11.2, 1
R      M11.3, 1

Network 6 // Paso 30: desviador 2 extendido (I1.0)
LDW=   VW332, +30
A      I1.0
AN     M4.1
S      M11.3, 1

Network 7 // Paso 30 -> 40: retraer el desviador 2
LDW=   VW332, +30
A      M11.3
A      M5.0
AN     M4.1
MOVW   +40, VW332                   // Paso 40: retraer desviador 2 (Q0.5 = 0)
R      M11.3, 1
R      M11.4, 1

Network 8 // Paso 40: desviador 2 retraido (400 ms con T41 e I1.0 apagado)
LDW=   VW332, +40
TON    T41, +4
LDW=   VW332, +40
AN     I1.0
A      T41
AN     M4.1
S      M11.4, 1

Network 9 // Paso 40 -> 50: extender el desviador 3
LDW=   VW332, +40
A      M11.4
A      M5.0
AN     M4.1
MOVW   +50, VW332                   // Paso 50: extender desviador 3 (Q0.6 = 1)
R      M11.4, 1
R      M11.5, 1

Network 10 // Paso 50: desviador 3 extendido (I1.1)
LDW=   VW332, +50
A      I1.1
AN     M4.1
S      M11.5, 1

Network 11 // Paso 50 -> 60: retraer el desviador 3
LDW=   VW332, +50
A      M11.5
A      M5.0
AN     M4.1
MOVW   +60, VW332                   // Paso 60: retraer desviador 3 (Q0.6 = 0)
R      M11.5, 1
R      M11.6, 1

Network 12 // Paso 60: desviador 3 retraido (400 ms con T43 e I1.1 apagado)
LDW=   VW332, +60
TON    T43, +4
LDW=   VW332, +60
AN     I1.1
A      T43
AN     M4.1
S      M11.6, 1

Network 13 // Paso 60 -> 70: prueba de la cinta a 30 Hz
// La marcha no se escribe aqui: SBR_ACTUADORES pone VW350 = 1 en el paso 70.
//   Modo 1: Q0.0 = 1 y AQW0 = VW370 (19200) en el mismo ciclo.
//   Modo 2: SBR_VFD_MODBUS envia 0x1000 = VW366 y 0x2000 = 1 apenas puede.
LDW=   VW332, +60
A      M11.6
A      M5.0
AN     M4.1
MOVW   +70, VW332                   // Paso 70: prueba de la cinta
R      M11.6, 1
R      M11.7, 1                     // M11.7 = marcha confirmada (network 14)
R      M12.1, 1                     // M12.1 = el variador muestra que el motor gira

Network 14 // Paso 70: confirmar la marcha (modo 1 inmediata / modo 2 cuando VW352 = 1)
LDW=   VW332, +70
AN     M11.7
LDW=   VW308, +1                    // Modo 1: Q0.0 y AQW0 se aplican en este mismo ciclo
LDW=   VW308, +2
AW=    VW352, +1                    // Modo 2: el variador acepto 0x1000 y 0x2000 = 1
OLD
ALD
S      M11.7, 1

Network 15 // Paso 70: tiempo maximo para confirmar, T48 (6 s)
LDW=   VW332, +70
AN     M11.7
TON    T48, +60

Network 16 // Paso 70: duracion de la prueba, T44 (VW388 = 100 -> 10 s) desde la confirmacion
// 1 s de rampa y 9 s de marcha a 30 Hz.
LDW=   VW332, +70
A      M11.7
TON    T44, VW388

Network 17 // Paso 70: comprobar que el motor gira (frecuencia de salida > 5 Hz)
LDW=   VW332, +70
A      M11.7
LDW>   VW400, +500                  // VW400 = 0x1001 frecuencia real (0,01 Hz), en cualquier sentido
OW<    VW400, -500
ALD
S      M12.1, 1

Network 18 // Paso 70: fin de la prueba por T44 -> paso 0 (VW350 vuelve a 0 = paro con rampa)
LDW=   VW332, +70
A      M11.7
A      T44
MOVW   +0, VW332
R      M11.7, 1

Network 19 // Paso 70: no se confirmo (T48) -> alarma del variador y vuelta a reposo
LDW=   VW332, +70
A      T48
S      M14.6, 1                     // Alarma del variador (HL3 intermitente, bit 5 de estado)
MOVW   +0, VW332

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 5: SBR_SECUENCIA_AUTO
// ==============================================================================
SUBROUTINE_BLOCK SBR_SECUENCIA_AUTO:SBR5
TITLE=Secuencia automatica (VW330) y clasificacion
BEGIN

Network 1 // Medicion de cotas de la cinta (pasos 90/91): contador y sensores de inspeccion
// Posiciones del encoder HSC0 (HC0) guardadas en memoria V (ver CON SIGNO en la tabla de estado):
//   VD412 contador actual           VD416 la pieza deja la entrada I0.3 (flanco de bajada)
//   VD420 el inductivo I0.5 detecta VD424 el inductivo I0.5 deja de detectar
//   VD428 la fibra I0.4 detecta     VD432 la fibra I0.4 deja de detectar
// Solo se guarda el primer flanco de cada sensor (VB393 = sensores ya registrados).
LDW=   VW330, +90
OW=    VW330, +91
MOVD   HC0, VD412
LD     I0.3
ED
AW=    VW330, +90
AN     V393.0
MOVD   HC0, VD416
S      V393.0, 1
LD     I0.5
EU
AW=    VW330, +90
AN     V393.1
MOVD   HC0, VD420
S      V393.1, 1
LD     I0.5
ED
AW=    VW330, +90
AN     V393.2
MOVD   HC0, VD424
S      V393.2, 1
LD     I0.4
EU
AW=    VW330, +90
AN     V393.3
MOVD   HC0, VD428
S      V393.3, 1
LD     I0.4
ED
AW=    VW330, +90
AN     V393.4
MOVD   HC0, VD432
S      V393.4, 1

Network 2 // Medicion: SB1 con la cinta en marcha: 1.a = rampa 1, 2.a = rampa 2, 3.a = rampa 3, 4.a = fin de cinta
// Pulsar cuando el centro de la pieza pasa frente a cada desviador y frente al punto donde
// recoge el brazo. La 4.a pulsacion detiene la cinta. VB456 = pulsaciones registradas.
LDW=   VW330, +90
A      M5.0
LPS
INCB   VB456
LRD
AB=    VB456, 1
MOVD   HC0, VD436                   // Rampa 1
LRD
AB=    VB456, 2
MOVD   HC0, VD440                   // Rampa 2
LRD
AB=    VB456, 3
MOVD   HC0, VD444                   // Rampa 3
LPP
AB=    VB456, 4
MOVD   HC0, VD448                   // Fin de cinta (donde recoge el brazo)
MOVW   +91, VW330                   // Frenar la cinta

Network 3 // Medicion: entrar con auto en reposo + SB1 con V392.0 = 1 (tabla de estado) o con SB2 apretado
// La cinta va a 18 Hz (VW350 = 2). Contador en cero y PV inalcanzable: no se clasifica.
LDW=   VW330, +0
A      M5.2
A      M2.0
AN     M4.1
A      M5.0
LD     V392.0                       // Activado desde la tabla de estado
O      I1.2                         // o SB2 apretado mientras se pulsa SB1
ALD
LPS
MOVW   +90, VW330
MOVB   0, VB456
MOVB   0, VB393
FILL   +0, VW412, 22                // Borra VD412..VD455 (medicion anterior)
R      V392.0, 1
R      M6.4, 1
LPP
MOVD   +0, SMD38                    // CV = 0 en el punto de partida
MOVD   +32000, SMD42                // PV inalcanzable: sin interrupciones de clasificacion
MOVB   16#F8, SMB37
HSC    0

Network 4 // Medicion: si |HC0| > 15000 cuentas se detiene la cinta
LDW=   VW330, +90
LDD>   HC0, +15000
OD<    HC0, -15000
ALD
MOVW   +91, VW330

Network 5 // Medicion, paso 91: la cinta frena; a los 2 s guarda donde quedo (VD452) y vuelve a reposo
LDW=   VW330, +91
TON    T49, +20
LDW=   VW330, +91
A      T49
MOVD   HC0, VD452                   // Posicion donde quedo detenida (incluye el frenado)
MOVW   +0, VW330

Network 6 // Pausa y continuar en automatico
// La pausa (M6.1) detiene la cinta con VW350 (SBR_ACTUADORES) sin perder el paso.
LD     M5.0                         // SB1 local: continuar
A      M2.0
R      M6.1, 1
R      M6.2, 1

Network 7 // Paso 0 -> 10: arrancar la cinta hacia la inspeccion
// Arranca con CMD_PIEZA_ENTREGADA del PLC 1 (M6.4) o, para probar, con SB1 y pieza en I0.3.
LDW=   VW330, +0
A      M2.0
AN     M4.1
AN     M6.1
LD     M6.4
LD     M5.0
A      M2.3
OLD
ALD
LPS
R      M6.4, 1                      // Orden atendida
R      M6.6, 1                      // Descartar permisos viejos del brazo
// HSC0 a cero y PV = VW310 (cota de inspeccion)
MOVD   +0, SMD38                    // CV = 0
ITD    VW310, SMD42                 // PV = cota de inspeccion
MOVB   16#F8, SMB37                 // Habilitar HSC0, actualizar CV y PV, contar hacia arriba
HSC    0
LRD
AB=    VB101, 5                     // Tipo 5 avisado por el PLC 1 (pieza negra)
S      M6.5, 1
LRD
AB<>   VB101, 5
R      M6.5, 1
LPP
MOVW   +10, VW330                   // Paso 10: marcha a 30 Hz hasta la inspeccion
S      V200.1, 1                    // STAT_BUSY = 1
R      V200.2, 1                    // STAT_DONE = 0
R      V200.6, 1                    // STAT_ROBOT_WAIT = 0

// Pasos 10, 15 y 20: la clasificacion, el cambio a 18 Hz y la parada los hace
// INT_HSC0_CVPV (evento 12), sin depender del tiempo de ciclo.

Network 8 // Paso 25: la cinta esta frenando; el desviador espera a que la pieza quede quieta frente al cilindro
// La orden de paro sale en la cota de parada (VW312/314/316) y la cinta avanza unas 100 cuentas
// mas mientras frena. Despues de VW394 (0,7 s) actua el desviador de la rampa asignada (VW300).
LDW=   VW330, +25
TON    T50, VW394
LDW=   VW330, +25
A      T50
LPS
AW=    VW300, +1
MOVW   +30, VW330                   // Rampa 1: empuja Q0.4
LRD
AW=    VW300, +2
MOVW   +40, VW330                   // Rampa 2: empuja Q0.5
LPP
AW=    VW300, +3
MOVW   +50, VW330                   // Rampa 3: empuja Q0.6

Network 9 // Paso 30: desviador 1 extendido (I0.7)
LDW=   VW330, +30
A      I0.7
AN     M4.1
MOVW   +32, VW330                   // Paso 32: retraer desviador 1

Network 10 // Paso 32: retraer el desviador 1 y esperar 2 s (T37)
LDW=   VW330, +32
TON    T37, +20
LDW=   VW330, +32
A      T37
AN     M4.1
LPS
S      V200.2, 1                    // STAT_DONE = 1
R      V200.1, 1                    // STAT_BUSY = 0
LPP
MOVW   +0, VW330

Network 11 // Paso 40: desviador 2 extendido (I1.0)
LDW=   VW330, +40
A      I1.0
AN     M4.1
MOVW   +42, VW330

Network 12 // Paso 42: retraer el desviador 2 y esperar 2 s (T38)
LDW=   VW330, +42
TON    T38, +20
LDW=   VW330, +42
A      T38
AN     M4.1
LPS
S      V200.2, 1
R      V200.1, 1
LPP
MOVW   +0, VW330

Network 13 // Paso 50: desviador 3 extendido (I1.1)
LDW=   VW330, +50
A      I1.1
AN     M4.1
MOVW   +52, VW330

Network 14 // Paso 52: retraer el desviador 3 y esperar 2 s (T39)
LDW=   VW330, +52
TON    T39, +20
LDW=   VW330, +52
A      T39
AN     M4.1
LPS
S      V200.2, 1
R      V200.1, 1
LPP
MOVW   +0, VW330

Network 15 // Paso 60: fin de cinta (VW318), esperar BELT_PERMIT_RUN del brazo por el PLC 1
// STAT_ROBOT_WAIT (V200.6) = 1 mientras VW330 = 60. El PLC 1 le pide al PLC 6 que recoja y,
// cuando el brazo sube 5000 pulsos en Y, envia el permiso (V100.6 -> M6.6).
// SB1 local libera la cinta si la pieza se retiro a mano (para pruebas).
LDW=   VW330, +60
LD     M6.6                         // BELT_PERMIT_RUN recibido
O      M5.0                         // o SB1 local
ALD
LPS
R      M6.6, 1                      // Permiso atendido
R      V200.6, 1                    // Ya no espera al brazo
S      V200.2, 1                    // STAT_DONE = 1
R      V200.1, 1                    // STAT_BUSY = 0
LPP
MOVW   +0, VW330                    // Reposo: lista para la siguiente pieza

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 6: SBR_ACTUADORES
// ==============================================================================
SUBROUTINE_BLOCK SBR_ACTUADORES:SBR6
TITLE=Orden de la cinta VW350, marcha Q0.0 / consigna AQW0, desviadores y focos
BEGIN

Network 1 // Orden de la cinta VW350 (se escribe solo aqui, una vez por ciclo)
// 0 = paro con rampa, 1 = 30 Hz, 2 = 18 Hz (acercamiento), 3 = paro libre
LD     SM0.0
MOVW   +0, VW350
// Automatico: pasos 10 y 15 a 30 Hz
LD     M5.2
LDW=   VW330, +10
OW=    VW330, +15
ALD
MOVW   +1, VW350
// Automatico: paso 20 a 18 Hz
LD     M5.2
AW=    VW330, +20
MOVW   +2, VW350
// Medicion de cotas (paso 90): marcha continua a 18 Hz
LD     M5.2
AW=    VW330, +90
MOVW   +2, VW350
// Manual: paso 70, prueba de la cinta
LDN    M5.2
AW=    VW332, +70
MOVW   +1, VW350
// Pausa en automatico, atasco o sin rearmar -> paro con rampa
LD     M5.2
A      M6.1
O      M4.1
ON     M2.0
MOVW   +0, VW350
// Seta local o emergencia de la planta -> paro libre
LD     M2.2
ON     I1.4
O      M6.2
MOVW   +3, VW350

Network 2 // Marcha por bornes, solo en modo 1: Q0.0 -> DI1 (adelante) si VW390 = 1, Q0.1 -> DI2 (atras) si VW390 = 2
// En modo 2 las dos salidas quedan en 0 (F0.11 = 2: el variador no mira los bornes).
LDW=   VW308, +1
LDW=   VW350, +1
OW=    VW350, +2
ALD
LPS
AW=    VW390, +1
=      Q0.0
LPP
AW=    VW390, +2
=      Q0.1

Network 3 // Nunca DI1 y DI2 al mismo tiempo
LD     Q0.0
A      Q0.1
R      Q0.0, 2

Network 4 // Consigna analogica AQW0 (borne AI1, 0-10 V), solo en modo 1
// Se calcula en VW386 y se escribe una sola vez por ciclo (AQW se escribe de inmediato).
LD     SM0.0
MOVW   +0, VW386
LDW=   VW308, +1
AW=    VW350, +1
MOVW   VW370, VW386                 // 30 Hz: 19200
LDW=   VW308, +1
AW=    VW350, +2
MOVW   VW372, VW386                 // 18 Hz: 11520
LD     SM0.0
MOVW   VW386, AQW0

Network 5 // Desviador 1 Q0.4 (paso 30 auto / paso 10 manual)
LDW=   VW330, +30
A      M5.2
LDW=   VW332, +10
AN     M5.2
OLD
A      M2.0
AN     M4.1
=      Q0.4

Network 6 // Desviador 2 Q0.5 (paso 40 auto / paso 30 manual)
LDW=   VW330, +40
A      M5.2
LDW=   VW332, +30
AN     M5.2
OLD
A      M2.0
AN     M4.1
=      Q0.5

Network 7 // Desviador 3 Q0.6 (paso 50 auto / paso 50 manual)
LDW=   VW330, +50
A      M5.2
LDW=   VW332, +50
AN     M5.2
OLD
A      M2.0
AN     M4.1
=      Q0.6

Network 8 // Foco verde HL1 (Q1.0): cinta y clasificacion en marcha
LDW>   VW330, +0
A      M5.2
AN     M6.1
LDW>   VW332, +0
AN     M5.2
OLD
A      M2.0
AN     M2.2
AN     M4.1
=      Q1.0

Network 9 // Foco amarillo HL2 (Q0.7): espera en manual, pausa, espera del brazo o aviso
LDW=   VW332, +0
AN     M5.2
LD     M5.2
A      M6.1
OLD
LD     M5.2
AW=    VW330, +60                   // Esperando que el brazo recoja
OLD
O      M4.0                         // Aviso de fuga
O      M2.1                         // Esperando rearme
A      SM0.5                        // Parpadeo a 1 Hz
AN     M2.2
A      I1.4
=      Q0.7

Network 10 // Foco rojo HL3 (Q1.1): seta o atasco (fijo), falla de comunicacion con el variador (intermitente)
LDN    I1.4
O      M2.2
O      M4.1
LD     M14.6
A      SM0.5
OLD
=      Q1.1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 7: SBR_HSC0_CONFIG
// ==============================================================================
SUBROUTINE_BLOCK SBR_HSC0_CONFIG:SBR7
TITLE=Contador rapido HSC0 en modo 9 (cuadratura A/B)
BEGIN

Network 1 // HSC0 en modo 9 (I0.0 = A, I0.1 = B)
LD     SM0.0
HDEF   0, 9

Network 2 // SMB37 = 16#F8 (habilitar, actualizar CV/PV, contar hacia arriba)
LD     SM0.0
MOVB   16#F8, SMB37
MOVD   +0, SMD38                    // CV inicial = 0
ITD    VW310, SMD42                 // PV inicial = cota de inspeccion (VW310)
HSC    0

Network 3 // Interrupcion del evento 12 (HSC0 CV = PV) -> INT_HSC0_CVPV
LD     SM0.0
ATCH   INT_HSC0_CVPV, 12
ENI

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 8: SBR_VFD_MODBUS
// ==============================================================================
// Pasos de la secuencia VW340:
//     0 : esperar que MBUS_CTRL_P1 este listo (M14.0 = 1 y VB345 = 0)
//    10 : RAM 0x000D (F0.13 aceleracion)  <- VW362     [40014]
//    20 : RAM 0x000E (F0.14 desaceleracion) <- VW364   [40015]
//    30 : RAM 0x0003 (F0.03 fuente de frecuencia) <- 9 / 2 [40004]
//    40 : RAM 0x000B (F0.11 fuente de comandos)  <- 2 / 1 [40012]
//   100 : reposo; prioridad: parametros en RAM > orden (modo 2) > lectura de datos
//   110 : 0x1000 <- VW366 (30 Hz)  -> 112
//   112 : 0x2000 <- VW390 (1 adelante / 2 atras) -> 100 (orden confirmada)
//   120 : 0x1000 <- VW368 (18 Hz)  -> 112
//   130 : 0x2000 <- 6 (paro con rampa) -> 132
//   132 : 0x1000 <- 0                -> 100 (orden confirmada)
//   140 : 0x2000 <- 5 (paro libre)  -> 100 (orden confirmada)
//   200 : lee 0x1001..0x1004 (4 registros) -> VW400..VW406 -> 100
// Errores: cada trama se intenta VB343 veces (error de la libreria o T45 de 3 s).
// Si fallan todas se activa M14.6, se guarda el paso en VW358 y la secuencia
// siempre sigue:
//   - Parametros en RAM: se salta el parametro, se marca M15.1 y toda la
//     configuracion se reintenta cada 10 s (T46) mientras la cinta este parada.
//   - Orden de marcha/paro: vuelve al paso 100 sin confirmar (VW352 <> VW350) y se
//     reenvia despues de 1 s (T47).
// ==============================================================================
SUBROUTINE_BLOCK SBR_VFD_MODBUS:SBR8
TITLE=Modbus maestro puerto 1: parametros en RAM, ordenes con reintentos y lectura de datos
BEGIN

Network 1 // Modbus maestro en el puerto 1 (19200 bps, sin paridad, 1000 ms de espera)
// Se ejecuta en cada ciclo. Done = M14.0, error = VB345 (fuera de VB4000+).
LD     SM0.0
CALL   MBUS_CTRL_P1, SM0.0, 19200, 0, 1000, M14.0, VB345

Network 2 // Modo 1: marcha/paro por bornes; la orden se da por confirmada aqui mismo
// Mantiene VW352 = VW350 para que la lectura de datos no se trabe en modo 1.
LDW=   VW308, +1
MOVW   VW350, VW352

Network 3 // Tiempo maximo por trama T45 (3 s), respaldo del tiempo de espera de la libreria
LD     M14.2
TON    T45, +30

Network 4 // Cada 200 ms se piden datos al variador (T42)
LDN    T42
TON    T42, +2
LD     T42
S      M15.5, 1                     // Lectura pendiente

Network 5 // Paso 0: MBUS_CTRL_P1 listo y sin error -> paso 100
LDW=   VW340, +0
A      M14.0
AB=    VB345, 0
MOVW   +100, VW340

Network 6 // Paso 100 (a): prioridad 1, faltan parametros en RAM -> paso 10
LDW=   VW340, +100
AN     M14.2
AN     M14.3
R      M15.1, 1                     // Nueva vuelta de configuracion sin fallas
R      M15.0, 1
MOVW   +10, VW340

Network 7 // Paso 100 (b): prioridad 2, nueva orden de la cinta en modo 2 (VW350 <> VW352)
LDW=   VW340, +100
AN     M14.2
AW=    VW308, +2
AN     M15.2                        // Sin espera de reintento pendiente
AW<>   VW350, VW352
LPS
MOVW   VW350, VW354                 // Fijar la orden que se va a enviar
R      M15.0, 1
AW=    VW350, +1
MOVW   +110, VW340                  // Marcha a 30 Hz
LRD
AW=    VW350, +2
MOVW   +120, VW340                  // Marcha a 18 Hz
LRD
AW=    VW350, +0
MOVW   +130, VW340                  // Paro con rampa
LPP
AW=    VW350, +3
MOVW   +140, VW340                  // Paro libre

Network 8 // Paso 100 (c): prioridad 3, lectura periodica de datos (modo 1 y modo 2)
LDW=   VW340, +100
AN     M14.2
A      M15.5
R      M15.5, 1
R      M15.0, 1
MOVW   +200, VW340

Network 9 // Preparar la trama: direccion Modbus y valor segun el paso (solo con M15.0 = 0)
LDW=   VW340, +10
AN     M15.0
MOVD   +40014, VD376                // RAM 0x000D F0.13 aceleracion
MOVW   VW362, VW360
LDW=   VW340, +20
AN     M15.0
MOVD   +40015, VD376                // RAM 0x000E F0.14 desaceleracion
MOVW   VW364, VW360
LDW=   VW340, +30
AN     M15.0
MOVD   +40004, VD376                // RAM 0x0003 F0.03 fuente de frecuencia
MOVW   +9, VW360                    // Modo 2: 9 = comunicacion
LDW=   VW340, +30
AN     M15.0
AW=    VW308, +1
MOVW   +2, VW360                    // Modo 1: 2 = AI1 (0-10 V)
LDW=   VW340, +40
AN     M15.0
MOVD   +40012, VD376                // RAM 0x000B F0.11 fuente de comandos (antes 40018, ver C3)
MOVW   +2, VW360                    // Modo 2: 2 = comunicacion
LDW=   VW340, +40
AN     M15.0
AW=    VW308, +1
MOVW   +1, VW360                    // Modo 1: 1 = bornes DI

Network 10 // Preparar la trama: marcha, paro y consignas (solo con M15.0 = 0)
LDW=   VW340, +110
AN     M15.0
MOVD   +44097, VD376                // 0x1000 consigna
MOVW   VW366, VW360                 // 6000 = 30 Hz
LDW=   VW340, +112
AN     M15.0
MOVD   +48193, VD376                // 0x2000 comando
MOVW   VW390, VW360                 // Marcha en el sentido elegido (1 adelante / 2 atras)
LDW=   VW340, +120
AN     M15.0
MOVD   +44097, VD376
MOVW   VW368, VW360                 // 3600 = 18 Hz
LDW=   VW340, +130
AN     M15.0
MOVD   +48193, VD376
MOVW   16#0006, VW360               // Paro con rampa
LDW=   VW340, +132
AN     M15.0
MOVD   +44097, VD376
MOVW   +0, VW360                    // Consigna 0 Hz
LDW=   VW340, +140
AN     M15.0
MOVD   +48193, VD376
MOVW   16#0005, VW360               // Paro libre
LDW=   VW340, +200
AN     M15.0
MOVD   +44098, VD376                // 0x1001 frecuencia real (se leen 4 registros)

Network 11 // Preparar la trama: lectura o escritura, cantidad y puntero de datos
LDW=   VW340, +200
AN     M15.0
MOVB   0, VB375                     // RW = 0 lectura (funcion 03)
MOVW   +4, VW380                    // 4 registros: 0x1001..0x1004
MOVD   &VB400, VD382                // Destino VW400..VW406
LDW<>  VW340, +200
AN     M15.0
MOVB   1, VB375                     // RW = 1 escritura (funcion 06)
MOVW   +1, VW380                    // 1 registro
MOVD   &VB360, VD382                // Origen VW360

Network 12 // Lanzar la trama: EN se mantiene (M14.2) y First dura un ciclo (M14.4)
LDW<>  VW340, +0
AW<>   VW340, +100
AN     M15.0
S      M15.0, 1                     // Trama preparada para este paso
S      M14.2, 1                     // EN de MBUS_MSG_P1 hasta Done
S      M14.4, 1                     // First (solo este ciclo)
R      T45, 1                       // Reiniciar el tiempo maximo de la trama

Network 13 // Unica llamada a MBUS_MSG_P1 (Done = M14.1, error = VB344)
LD     M14.2
CALL   MBUS_MSG_P1, M14.4, VB374, VB375, VD376, VW380, VD382, M14.1, VB344

Network 14 // Resultado (se ignora el ciclo en que se lanzo, para no leer un Done anterior)
LD     M14.2
AN     M14.4
A      M14.1                        // Done (con o sin error)
LPS
AB=    VB344, 0
S      M15.3, 1                     // Trama correcta
LPP
AB<>   VB344, 0
S      M15.7, 1                     // Trama con error (excepcion, CRC, sin respuesta...)

Network 15 // Se paso el tiempo maximo: cortar la trama como error 99
LD     M14.2
A      T45
AN     M15.3                        // Salvo que la trama haya terminado bien en este ciclo
MOVB   99, VB344
S      M15.7, 1

Network 16 // First solo en el ciclo en que se lanza
LD     SM0.0
R      M14.4, 1

Network 17 // Trama correcta: liberar y pasar al paso siguiente (VW356 = copia del paso)
LD     M15.3
MOVW   VW340, VW356
R      M14.2, 1
R      M15.0, 1
R      M14.6, 1                     // Comunicacion con el variador normal
MOVB   0, VB346
LDW=   VW356, +10
A      M15.3
MOVW   +20, VW340
LDW=   VW356, +20
A      M15.3
MOVW   +30, VW340
LDW=   VW356, +30
A      M15.3
MOVW   +40, VW340
LDW=   VW356, +110
A      M15.3
MOVW   +112, VW340
LDW=   VW356, +120
A      M15.3
MOVW   +112, VW340
LDW=   VW356, +130
A      M15.3
MOVW   +132, VW340
LDW=   VW356, +200
A      M15.3
MOVW   +100, VW340

Network 18 // Trama correcta: termino la configuracion en RAM (paso 40) -> paso 100
LDW=   VW356, +40
A      M15.3
S      M14.3, 1                     // Configuracion completa
MOVW   +99, VW352                   // Volver a enviar la orden actual despues de reconfigurar
MOVW   +100, VW340

Network 19 // Trama correcta: el variador acepto la orden (pasos 112, 132, 140) -> paso 100
LDW=   VW356, +112
OW=    VW356, +132
OW=    VW356, +140
A      M15.3
MOVW   VW354, VW352                 // VW352 = orden aceptada por el variador
MOVW   +100, VW340

Network 20 // Trama correcta: borrar bandera
LD     SM0.0
R      M15.3, 1

Network 21 // Error: repetir la misma trama mientras VB346 < VB343
LD     M15.7
R      M14.2, 1                     // Soltar EN (corta la llamada)
INCB   VB346
LD     M15.7
AB<    VB346, VB343
R      M15.0, 1                     // Volver a lanzar el mismo paso en el siguiente ciclo
R      M15.7, 1

Network 22 // Error en todos los intentos: alarma, guardar el paso y seguir (sin trabarse)
LD     M15.7
S      M14.6, 1                     // Alarma de comunicacion con el variador
MOVW   VW340, VW358                 // Ultimo paso que fallo (diagnostico)
MOVW   VW340, VW356
MOVB   0, VB346
R      M15.0, 1
// Parametros en RAM (10..40): pasar al siguiente y marcar configuracion incompleta
LDW=   VW356, +10
A      M15.7
S      M15.1, 1
MOVW   +20, VW340
LDW=   VW356, +20
A      M15.7
S      M15.1, 1
MOVW   +30, VW340
LDW=   VW356, +30
A      M15.7
S      M15.1, 1
MOVW   +40, VW340
LDW=   VW356, +40
A      M15.7
S      M15.1, 1
S      M14.3, 1                     // Configuracion terminada (incompleta): permite enviar ordenes y leer datos
MOVW   +99, VW352
MOVW   +100, VW340
// Ordenes (110..140): volver al paso 100 sin confirmar y esperar T47 antes de reenviar
LDW>=  VW356, +110
AW<=   VW356, +140
A      M15.7
S      M15.2, 1
MOVW   +100, VW340
// Lectura de datos (200): descartar y volver al paso 100
LDW=   VW356, +200
A      M15.7
MOVW   +100, VW340

Network 23 // Error: borrar bandera
LD     SM0.0
R      M15.7, 1

Network 24 // Esperar 1 s (T47) antes de reenviar una orden que fallo
LD     M15.2
TON    T47, +10
LD     T47
R      M15.2, 1

Network 25 // Si la configuracion en RAM quedo incompleta, reintentar cada 10 s (solo con la cinta parada)
LD     M14.3
A      M15.1
AW=    VW350, +0
AW=    VW352, +0
TON    T46, +100
LD     T46
R      M14.3, 1                     // El paso 100 vuelve a hacer toda la configuracion 10..40

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 9: SBR_COMMS_PPI
// ==============================================================================
SUBROUTINE_BLOCK SBR_COMMS_PPI:SBR9
TITLE=Estado y datos del variador para el PLC 1 (VB200..VB212)
BEGIN

Network 1 // VB200 (STAT_GLOBAL): byte de estado
// Bit 0: STAT_READY (automatico, paso 0, sin pausa ni fallas: puede recibir otra pieza)
LDW=   VW330, +0
A      M5.2
A      M2.0
AN     M4.1
AN     M6.1
AN     M6.4                         // Sin pieza pendiente de arrancar
=      V200.0

// Bit 1: STAT_BUSY (clasificacion o prueba en curso)
LDW>   VW330, +0
A      M5.2
LDW>   VW332, +0
AN     M5.2
OLD
=      V200.1

// Bit 2: STAT_DONE lo maneja SBR_SECUENCIA_AUTO (pasos 32, 42, 52, 60)

// Bit 3: STAT_ALM_ATASCO
LD     M4.1
=      V200.3

// Bit 4: STAT_ALM_FUGA
LD     M4.0
=      V200.4

// Bit 5: STAT_ALM_VFD (falla de comunicacion Modbus con el variador)
LD     M14.6
=      V200.5

// Bit 6: STAT_ROBOT_WAIT (pieza tipo 4/5 detenida en VW318 esperando al brazo)
LDW=   VW330, +60
A      M5.2
=      V200.6

// Bit 7: STAT_HOMED (seguridad OK y desviadores retraidos)
LD     M2.0
AN     Q0.4
AN     Q0.5
AN     Q0.6
=      V200.7

Network 2 // VB201 (STAT_PASO): byte bajo del paso (VB331 auto / VB333 manual)
LD     M5.2
MOVB   VB331, VB201
LDN    M5.2
MOVB   VB333, VB201

Network 3 // VB202 (STAT_INPUTS): copia de IB0
LD     SM0.0
MOVB   IB0, VB202

// VB203 (STAT_DATA): rampa asignada 1..4, la escribe INT_HSC0_CVPV

Network 4 // VW204..VB212: datos del variador y salidas para el PLC 1 (NETR de 13 bytes)
LD     SM0.0
MOVW   VW400, VW204                 // 0x1001 frecuencia real (0,01 Hz)
MOVW   VW406, VW206                 // 0x1004 corriente de salida (0,01 A)
MOVW   VW402, VW208                 // 0x1002 tension del bus DC (0,1 V)
MOVB   VB309, VB210                 // Modo del variador (byte bajo de VW308)
LDN    I1.4
O      M2.2
=      V210.7                       // Bit 7: seta accionada en Seleccion (para la baliza de la planta, PLC 1)
LD     SM0.0
MOVB   0, VB211
LD     M14.6
MOVB   VB344, VB211                 // Ultimo error Modbus mientras hay alarma
LD     I1.5
=      V210.6                       // Bit 6: selector en automatico (para el SCADA)
LDW=   VW390, +2
=      V210.5                       // Bit 5: cinta hacia atras (VW390 = 2)
LD     SM0.0
MOVB   QB0, VB212                   // VB212: salidas Q0.0..Q0.7 (marcha, sentido, desviadores, focos); el PLC 1 lee 13 bytes

END_SUBROUTINE_BLOCK

// ==============================================================================
// INTERRUPCION 0: INT_HSC0_CVPV (evento 12: CV = PV en el HSC0)
// ==============================================================================
INTERRUPT_BLOCK INT_HSC0_CVPV:INT0
TITLE=Interrupcion del HSC0 cuando el encoder llega a la cota (evento 12)
BEGIN

Network 1 // Caso 1, paso 10 (PV = VW310): identificar la pieza en movimiento y asignar el tipo
// Lectura directa (AI/ANI) de los sensores, sin esperar la imagen del ciclo.
// 1A: tipo 5 (pieza negra avisada por el PLC 1, guardada en M6.5 al arrancar)
LDW=   VW330, +10
A      M6.5
MOVW   +5, VW300
MOVB   4, VB203                     // Destino: fin de cinta, para el brazo
ITD    VW328, SMD42                 // PV = cota de cambio a 18 Hz del fin de cinta
// 1B: tipo 1 (base metalica I0.5 = 1, nucleo metalico I0.4 = 1)
LDW=   VW330, +10
AN     M6.5
AI     I0.5
AI     I0.4
MOVW   +1, VW300
MOVB   1, VB203
ITD    VW322, SMD42
// 1C: tipo 2 (base de plastico I0.5 = 0, nucleo de plastico I0.4 = 0)
LDW=   VW330, +10
AN     M6.5
ANI    I0.5
ANI    I0.4
MOVW   +2, VW300
MOVB   2, VB203
ITD    VW324, SMD42
// 1D: tipo 3 (base de plastico I0.5 = 0, nucleo metalico I0.4 = 1)
LDW=   VW330, +10
AN     M6.5
ANI    I0.5
AI     I0.4
MOVW   +3, VW300
MOVB   3, VB203
ITD    VW326, SMD42
// 1E: tipo 4 (base metalica I0.5 = 1, nucleo de plastico I0.4 = 0)
LDW=   VW330, +10
AN     M6.5
AI     I0.5
ANI    I0.4
MOVW   +4, VW300
MOVB   4, VB203
ITD    VW328, SMD42

Network 2 // Caso 1: cargar la nueva PV sin tocar CV y pasar al paso 15
LDW=   VW330, +10
MOVB   16#A8, SMB37                 // Habilitar, actualizar PV, contar hacia arriba
HSC    0
MOVW   +15, VW330
CRETI

Network 3 // Caso 2, paso 15 (cota de cambio de velocidad): bajar a 18 Hz
LDW=   VW330, +15
AW=    VW308, +1
MOVW   VW372, AQW0                  // Modo 1: 11520 de inmediato
LDW=   VW330, +15
MOVW   +2, VW350                    // Los dos modos: orden 2 (en modo 2 la envia SBR_VFD_MODBUS)
// Cargar la cota de parada segun el tipo
LDW=   VW330, +15
AW=    VW300, +1
ITD    VW312, SMD42                 // Rampa 1
LDW=   VW330, +15
AW=    VW300, +2
ITD    VW314, SMD42                 // Rampa 2
LDW=   VW330, +15
AW=    VW300, +3
ITD    VW316, SMD42                 // Rampa 3
LDW=   VW330, +15
AW>=   VW300, +4
ITD    VW318, SMD42                 // Tipos 4 y 5: fin de cinta

Network 4 // Caso 2: cargar la PV de parada y pasar al paso 20
LDW=   VW330, +15
MOVB   16#A8, SMB37
HSC    0
MOVW   +20, VW330
CRETI

Network 5 // Caso 3, paso 20 (cota de parada): frenar la cinta
LDW=   VW330, +20
LPS
RI     Q0.0, 1                      // Modo 1: cortar DI1 de inmediato
RI     Q0.1, 1                      // Modo 1: cortar DI2 (sentido atras) de inmediato
MOVW   +0, AQW0                     // Modo 1: consigna a 0 V
LPP
MOVW   +0, VW350                    // Modo 2: paro con rampa (0x2000 = 6) en el siguiente envio

Network 6 // Caso 3: paso siguiente segun el tipo de pieza
LDW=   VW330, +20
AW>=   VW300, +1
AW<=   VW300, +3
MOVW   +25, VW330                   // Rampas 1..3: paso 25, frenando; el desviador espera a que la cinta pare
LDW=   VW330, +20
AW>=   VW300, +4
R      M6.6, 1                      // Descartar permisos viejos
S      V200.6, 1                    // STAT_ROBOT_WAIT = 1 para el PLC 1
MOVW   +60, VW330                   // Paso 60: esperar que el brazo recoja

END_INTERRUPT_BLOCK
