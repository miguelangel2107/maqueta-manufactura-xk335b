ORGANIZATION_BLOCK MAIN:OB1
TITLE=Unidad 4: Procesamiento (PLC 4)
// Planta XK-335B - Unidad 4: Procesamiento
// Sujeta la pieza, la lleva bajo la prensa y la prensa dos veces.
// CPU 224CN. Puerto 0: esclavo PPI, direccion 4, 19200 bps, 8-E-1.
// Subrutinas:
//   OB1: llama a las subrutinas; manual o automatico segun SA1 (I1.5)
//   SBR0 SBR_INIT: valores iniciales en el primer ciclo (SM0.1)
//   SBR1 SBR_IO_SCAN: entradas, flancos de SB1/SB2 y ordenes del PLC 1
//   SBR2 SBR_SEGURIDAD: seta QS (I1.4), corte de salidas y rearme con SB1 (I1.3)
//   SBR3 SBR_DIAGNOSTICO: tiempos de los cilindros (T33..T36, T97) y atascos
//   SBR4 SBR_MAN_STEP: secuencia manual paso a paso (VW332)
//   SBR5 SBR_AUTO: secuencia automatica de doble prensado (VW330)
//   SBR6 SBR_ACTUADORES: electrovalvulas Q0.0, Q0.2, Q0.3 y focos HL1, HL2, HL3
//   SBR7 SBR_COMMS_PPI: datos para el PLC 1 en VB200..VB207
// Los pasos estan en VW330 (auto) y VW332 (manual) para no pisar VB100..VB103,
// que escribe el PLC 1 por la red. Las ordenes PPI se toman por flanco y VB100 no se borra.
BEGIN

Network 1 // Valores iniciales (primer ciclo)
LD     SM0.1
CALL   SBR_INIT

Network 2 // Entradas, flancos y ordenes del PLC 1
LD     SM0.0
CALL   SBR_IO_SCAN

Network 3 // Seta de emergencia y rearme
LD     SM0.0
CALL   SBR_SEGURIDAD

Network 4 // Tiempos de los cilindros y atascos
LD     SM0.0
CALL   SBR_DIAGNOSTICO

Network 5 // Secuencia manual (SA1 = 0)
LDN    M5.2                         // SA1 en manual (I1.5 = 0)
CALL   SBR_MAN_STEP

Network 6 // Secuencia automatica de doble prensado (SA1 = 1)
LD     M5.2                         // SA1 en automatico (I1.5 = 1)
CALL   SBR_AUTO

Network 7 // Electrovalvulas y focos
LD     SM0.0
CALL   SBR_ACTUADORES

Network 8 // Datos para el PLC 1 (red PPI)
LD     SM0.0
CALL   SBR_COMMS_PPI

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_INIT
// ==============================================================================
SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=Valores iniciales de pasos, tiempos y banderas
BEGIN

Network 1 // Pasos en reposo y buffers de red en cero
LD     SM0.0
MOVW   +0, VW330                    // Paso automatico = 0 (reposo)
MOVW   +0, VW332                    // Paso manual = 0 (reposo)
MOVB   0, VB100                     // Ordenes del PLC 1 en cero
MOVB   0, VB101
MOVB   0, VB102
MOVB   0, VB103
MOVB   0, VB200                     // Estado para el PLC 1 en cero
MOVB   0, VB201                     // STAT_PASO en 0
MOVB   0, VB202                     // STAT_INPUTS en 0
MOVB   0, VB203                     // STAT_DATA en 0

Network 2 // Tiempos normales de los cilindros (ms)
LD     SM0.0
MOVW   +250, VW210                  // Cierre de la mordaza: 250 ms
MOVW   +350, VW212                  // Avance del carro a la prensa: 350 ms
MOVW   +400, VW214                  // Bajada de la prensa: 400 ms
MOVW   +350, VW216                  // Subida de la prensa: 350 ms
MOVW   +350, VW218                  // Regreso del carro al origen: 350 ms

Network 3 // Borrar banderas, alarmas y salidas
LD     SM0.0
R      M2.0, 8                      // M2.0 = SEGURIDAD_OK, M2.1 = ESPERA_REARME, M2.2 = EMERGENCIA_ACTIVA
R      M4.0, 8                      // M4.0 = ALM_FUGA, M4.1 = ALM_ATASCO
R      M5.0, 8                      // M5.0 = PULSO_SB1, M5.1 = PULSO_SB2, M5.2 = MODO_AUTO
R      M6.0, 8                      // M6.0 = MARCH_AUTO, M6.1 = PAUSA_AUTO, M6.4 = PIEZA_ENTREGADA, M6.6 = RETIRADO
R      M11.0, 8                     // Permisos del modo manual (M11.1..M11.7)
R      M12.0, 8                     // Permisos del modo manual (M12.0..M12.3)
R      Q0.0, 8                      // Todas las salidas apagadas al arrancar
R      Q1.0, 8

Network 4 // Estado de la seta al encender
// Con la seta liberada (I1.4 = 1) hay que rearmar con SB1
LD     I1.4
=      M2.1                         // M2.1 = esperando rearme con SB1
LDN    I1.4
=      M2.2                         // M2.2 = seta accionada

Network 5 // Estado inicial para el PLC 1
LD     SM0.0
S      V200.0, 1                    // STAT_READY = 1
S      V200.7, 1                    // STAT_HOMED = 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 1: SBR_IO_SCAN
// ==============================================================================
SUBROUTINE_BLOCK SBR_IO_SCAN:SBR1
TITLE=Entradas, flancos de pulsadores y ordenes del PLC 1
BEGIN

Network 1 // Selector SA1 (I1.5)
LD     I1.5
=      M5.2                         // 1 = automatico, 0 = manual

Network 2 // Flanco de SB1 (I1.3), marcha / avance
// Pulsador NA: 0 en reposo, 1 pulsado. Solo flanco de subida (con EU y ED juntos fallaba)
LD     I1.3
EU
=      M5.0                         // M5.0 = pulso de un ciclo al pulsar SB1

Network 3 // Flanco de SB2 (I1.2), pausa / reset
// Pulsador NA: 0 en reposo, 1 pulsado. Solo flanco de subida (con EU y ED juntos fallaba)
LD     I1.2
EU
=      M5.1                         // M5.1 = pulso de un ciclo al pulsar SB2

Network 4 // Ordenes del PLC 1 (VB100)
// El PLC 1 pone cada bit en 1 durante un solo envio NETW y luego en 0.
// Se toman por flanco y VB100 no se borra aqui, asi una misma orden
// reescrita por el maestro no se ejecuta dos veces.
LD     V100.0
EU
S      M6.0, 1                      // CMD_START

LD     V100.1
EU
S      M6.1, 1                      // CMD_PAUSE

LD     V100.3
EU
S      M6.3, 1                      // CMD_ACK_RESET

LD     V100.4
EU
S      M6.4, 1                      // CMD_PIEZA_ENTREGADA (Transporte dejo la pieza en la mordaza)

LD     V100.6
EU
S      M6.6, 1                      // CMD_RETIRO_CONFIRMADO (Transporte se llevo la pieza prensada)


END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 2: SBR_SEGURIDAD
// ==============================================================================
SUBROUTINE_BLOCK SBR_SEGURIDAD:SBR2
TITLE=Seta de emergencia QS (I1.4) y rearme con SB1
BEGIN

Network 1 // Seta accionada (I1.4 = 0)
// Seta NC: 1 = normal, 0 = accionada
LDN    I1.4
LPS
S      M2.2, 1                      // M2.2 = seta accionada
R      M2.0, 1                      // Quitar SEGURIDAD_OK
R      M2.1, 1                      // Todavia no se puede rearmar
MOVW   +0, VW330                    // Paso automatico a 0
MOVW   +0, VW332                    // Paso manual a 0
R      M6.0, 1                      // Quitar marcha
R      M6.4, 1                      // Quitar aviso de pieza entregada
R      M11.0, 8                     // Quitar permisos del manual M11.1..M11.7
R      M12.0, 8                     // Quitar permisos del manual M12.0..M12.3
LRD
R      Q0.0, 1                      // Apagar mordaza
R      Q0.2, 1                      // Apagar carro
R      Q0.3, 1                      // Apagar prensa
R      Q1.0, 1                      // HL1 verde apagada
R      Q0.7, 1                      // HL2 amarilla apagada
S      Q1.1, 1                      // HL3 roja encendida
LPP
R      V200.2, 1                    // Quitar STAT_DONE

Network 2 // Seta liberada (I1.4 = 1): pasar a espera de rearme
// Al liberar la seta la estacion no arranca sola, espera SB1
LD     I1.4
A      M2.2                         // Venia de la seta accionada
R      M2.2, 1                      // Seta liberada
S      M2.1, 1                      // Esperando rearme
R      M2.0, 1                      // Sigue sin poder operar

Network 3 // Rearme con SB1 local o con ACK_RESET del PLC 1 (SB1 de Transporte o SCADA)
// Solo con la seta liberada (I1.4 = 1) y esperando rearme (M2.1 = 1)
LD     M5.0                         // SB1 local
O      M6.3                         // ACK_RESET del PLC 1
A      M2.1
A      I1.4
S      M2.0, 1                      // SEGURIDAD_OK
R      M2.1, 1                      // Ya no espera rearme
R      M2.2, 1                      // Seta accionada = 0
R      M4.0, 2                      // Borrar atasco (M4.1) y fuga (M4.0)
R      V200.3, 1                    // Quitar STAT_ALM_ATASCO
R      V200.4, 1                    // Quitar STAT_ALM_FUGA
R      M6.1, 1                      // Quitar pausa
R      M6.3, 1                      // ACK_RESET atendido
MOVW   +0, VW330                    // Paso 0
MOVW   +0, VW332

Network 4 // ACK_RESET con la estacion ya rearmada: solo borra alarmas, no cambia el paso
// El PLC 1 lo envia con cada SB1 de Transporte en automatico; no debe cortar un prensado.
LD     M6.3
A      M2.0
R      M4.0, 2
R      V200.3, 1
R      V200.4, 1
LD     M6.3
R      M6.3, 1                      // Se borra tambien con la seta accionada

Network 5 // SB2 (M5.1): volver al paso 0
// Con SB2 se vuelve al paso 0 y se borran las alarmas en cualquier momento
LD     M5.1
LPS
MOVW   +0, VW330                    // Paso automatico a 0
MOVW   +0, VW332                    // Paso manual a 0
R      M4.0, 2                      // Borrar atasco (M4.1) y fuga (M4.0)
R      V200.3, 1                    // Borrar alarmas para el PLC 1
R      V200.4, 1
R      M11.0, 8                     // Quitar permisos del manual
R      M12.0, 8
R      M6.0, 1
R      M6.5, 1
LPP
R      M6.4, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 3: SBR_DIAGNOSTICO
// ==============================================================================
SUBROUTINE_BLOCK SBR_DIAGNOSTICO:SBR3
TITLE=Tiempos de los cilindros (T33..T36, T97) y alarmas de atasco
BEGIN

Network 1 // Cierre de la mordaza: T33 (10 ms) -> VW210
// 1. Al llegar a I0.1 se guarda el tiempo antes de que se reinicie el TON
LD     I0.1
EU
LDW=   VW330, +10
OW=    VW332, +10
ALD
MOVW   T33, VW210
*I     +10, VW210                   // Cuentas de 10 ms a ms
AW>    VW210, +450                  // Mas de 450 ms: aviso de fuga
S      M4.0, 1

// 2. Cuenta mientras el cilindro se mueve y no llega a I0.1
LDW=   VW330, +10
OW=    VW332, +10
AN     I0.1
TON    T33, +32767

// 3. Atasco: T33 > 150 (1,5 s) sin llegar a I0.1
LDW>   T33, +150
AN     I0.1
S      M4.1, 1                      // Alarma de atasco

Network 2 // Avance del carro a la prensa: T34 (10 ms) -> VW212
// 1. Al llegar a I0.3 se guarda el tiempo antes de que se reinicie el TON
LD     I0.3
EU
LDW=   VW330, +20
OW=    VW332, +20
ALD
MOVW   T34, VW212
*I     +10, VW212                   // Cuentas de 10 ms a ms
AW>    VW212, +550                  // Mas de 550 ms: aviso de fuga
S      M4.0, 1

// 2. Cuenta mientras el cilindro se mueve y no llega a I0.3
LDW=   VW330, +20
OW=    VW332, +20
AN     I0.3
TON    T34, +32767

// 3. Atasco: T34 > 150 (1,5 s) sin llegar a I0.3
LDW>   T34, +150
AN     I0.3
S      M4.1, 1

Network 3 // Bajada de la prensa, golpes 1 y 2: T35 (10 ms) -> VW214
// 1. Al llegar a I0.5 se guarda el tiempo antes de que se reinicie el TON
LD     I0.5
EU
LDW=   VW330, +30
OW=    VW330, +60
OW=    VW332, +30
OW=    VW332, +60
ALD
MOVW   T35, VW214
*I     +10, VW214                   // Cuentas de 10 ms a ms
AW>    VW214, +500                  // Mas de 500 ms: aviso de fuga
S      M4.0, 1

// 2. Cuenta mientras baja y no llega a I0.5
LDW=   VW330, +30
OW=    VW330, +60
OW=    VW332, +30
OW=    VW332, +60
AN     I0.5
TON    T35, +32767

// 3. Atasco: T35 > 150 (1,5 s) sin llegar a I0.5
LDW>   T35, +150
AN     I0.5
S      M4.1, 1

Network 4 // Subida de la prensa, golpes 1 y 2: T36 (10 ms) -> VW216
// 1. Al llegar a I0.4 se guarda el tiempo antes de que se reinicie el TON
LD     I0.4
EU
LDW=   VW330, +50
OW=    VW330, +80
OW=    VW332, +50
OW=    VW332, +80
ALD
MOVW   T36, VW216
*I     +10, VW216                   // Cuentas de 10 ms a ms
AW>    VW216, +500                  // Mas de 500 ms: aviso de fuga
S      M4.0, 1

// 2. Cuenta mientras sube y no llega a I0.4
LDW=   VW330, +50
OW=    VW330, +80
OW=    VW332, +50
OW=    VW332, +80
AN     I0.4
TON    T36, +32767

// 3. Atasco: T36 > 150 (1,5 s) sin llegar a I0.4
LDW>   T36, +150
AN     I0.4
S      M4.1, 1

Network 5 // Regreso del carro al origen: T97 (10 ms) -> VW218
// 1. Al llegar a I0.2 se guarda el tiempo antes de que se reinicie el TON
LD     I0.2
EU
LDW=   VW330, +90
OW=    VW332, +90
ALD
MOVW   T97, VW218
*I     +10, VW218                   // Cuentas de 10 ms a ms
AW>    VW218, +550                  // Mas de 550 ms: aviso de fuga
S      M4.0, 1

// 2. Cuenta mientras vuelve y no llega a I0.2
LDW=   VW330, +90
OW=    VW332, +90
AN     I0.2
TON    T97, +32767

// 3. Atasco: T97 > 150 (1,5 s) sin llegar a I0.2
LDW>   T97, +150
AN     I0.2
S      M4.1, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 4: SBR_MAN_STEP
// ==============================================================================
SUBROUTINE_BLOCK SBR_MAN_STEP:SBR4
TITLE=Secuencia manual paso a paso (VW332), avanza con SB1
BEGIN

Network 1 // Paso 0 -> 10: cerrar la mordaza
// Con VW332 = 0, seguridad OK (M2.0), sin atasco (M4.1) y SB1 (M5.0)
LDW=   VW332, +0
A      M2.0
AN     M4.1
A      M5.0                         // SB1 (I1.3)
MOVW   +10, VW332                   // Paso 10: cerrar la mordaza (Q0.0 = 1)
R      M11.1, 1                     // Borrar permiso del paso siguiente

Network 2 // Paso 10: mordaza cerrada (I0.1)
LDW=   VW332, +10
A      I0.1                         // Mordaza cerrada
AN     M4.1
S      M11.1, 1                     // Permite pasar al paso 20

Network 3 // Paso 10 -> 20: llevar el carro a la prensa
// Con la mordaza cerrada (M11.1) y otra pulsacion de SB1
LDW=   VW332, +10
A      M11.1
A      M5.0
AN     M4.1
MOVW   +20, VW332                   // Paso 20: carro hacia la prensa (Q0.2 = 1)
R      M11.1, 1
R      M11.2, 1

Network 4 // Paso 20: carro bajo la prensa (I0.3)
LDW=   VW332, +20
A      I0.3                         // Carro bajo la prensa
AN     M4.1
S      M11.2, 1                     // Permite pasar al paso 30

Network 5 // Paso 20 -> 30: bajar la prensa (golpe 1)
// Con el carro en la prensa (M11.2) y otra pulsacion de SB1
LDW=   VW332, +20
A      M11.2
A      M5.0
AN     M4.1
MOVW   +30, VW332                   // Paso 30: bajar la prensa, golpe 1 (Q0.3 = 1)
R      M11.2, 1
R      M11.3, 1

Network 6 // Paso 30: prensa abajo, golpe 1 (I0.5)
LDW=   VW332, +30
A      I0.5                         // Prensa abajo
AN     M4.1
S      M11.3, 1                     // Permite pasar al paso 40

Network 7 // Paso 30 -> 40: mantener el golpe 1
// Con la prensa abajo (M11.3) y otra pulsacion de SB1
LDW=   VW332, +30
A      M11.3
A      M5.0
AN     M4.1
MOVW   +40, VW332                   // Paso 40: mantener la prensa abajo 500 ms
R      M11.3, 1
R      M11.4, 1

Network 8 // Paso 40: tiempo del golpe 1 (500 ms con T37)
LDW=   VW332, +40
A      I0.5
TON    T37, +5                      // 500 ms (base 100 ms)

LDW=   VW332, +40
A      I0.5
A      T37
AN     M4.1
S      M11.4, 1                     // Permite pasar al paso 50

Network 9 // Paso 40 -> 50: subir la prensa (golpe 1)
// Con el tiempo cumplido (M11.4) y otra pulsacion de SB1
LDW=   VW332, +40
A      M11.4
A      M5.0
AN     M4.1
MOVW   +50, VW332                   // Paso 50: subir la prensa (Q0.3 = 0)
R      M11.4, 1
R      M11.5, 1

Network 10 // Paso 50: prensa arriba, golpe 1 (I0.4)
LDW=   VW332, +50
A      I0.4                         // Prensa arriba
AN     M4.1
S      M11.5, 1                     // Permite pasar al paso 60

Network 11 // Paso 50 -> 60: bajar la prensa (golpe 2)
// Con la prensa arriba (M11.5) y otra pulsacion de SB1
LDW=   VW332, +50
A      M11.5
A      M5.0
AN     M4.1
MOVW   +60, VW332                   // Paso 60: bajar la prensa, golpe 2 (Q0.3 = 1)
R      M11.5, 1
R      M11.6, 1

Network 12 // Paso 60: prensa abajo, golpe 2 (I0.5)
LDW=   VW332, +60
A      I0.5                         // Prensa abajo
AN     M4.1
S      M11.6, 1                     // Permite pasar al paso 70

Network 13 // Paso 60 -> 70: mantener el golpe 2
// Con la prensa abajo (M11.6) y otra pulsacion de SB1
LDW=   VW332, +60
A      M11.6
A      M5.0
AN     M4.1
MOVW   +70, VW332                   // Paso 70: mantener la prensa abajo 500 ms
R      M11.6, 1
R      M11.7, 1

Network 14 // Paso 70: tiempo del golpe 2 (500 ms con T38)
LDW=   VW332, +70
A      I0.5
TON    T38, +5                      // 500 ms (base 100 ms)

LDW=   VW332, +70
A      I0.5
A      T38
AN     M4.1
S      M11.7, 1                     // Permite pasar al paso 80

Network 15 // Paso 70 -> 80: subir la prensa (golpe 2)
// Con el tiempo cumplido (M11.7) y otra pulsacion de SB1
LDW=   VW332, +70
A      M11.7
A      M5.0
AN     M4.1
MOVW   +80, VW332                   // Paso 80: subir la prensa (Q0.3 = 0)
R      M11.7, 1
R      M12.0, 1

Network 16 // Paso 80: prensa arriba, golpe 2 (I0.4)
LDW=   VW332, +80
A      I0.4                         // Prensa arriba
AN     M4.1
S      M12.0, 1                     // Permite pasar al paso 90

Network 17 // Paso 80 -> 90: volver el carro al origen
// Con la prensa arriba (M12.0) y otra pulsacion de SB1
LDW=   VW332, +80
A      M12.0
A      M5.0
AN     M4.1
MOVW   +90, VW332                   // Paso 90: carro al origen (Q0.2 = 0)
R      M12.0, 1
R      M12.1, 1

Network 18 // Paso 90: carro en el origen (I0.2)
LDW=   VW332, +90
A      I0.2                         // Carro en el origen
AN     M4.1
S      M12.1, 1                     // Permite pasar al paso 100

Network 19 // Paso 90 -> 100: abrir la mordaza
// Con el carro en el origen (M12.1) y otra pulsacion de SB1
LDW=   VW332, +90
A      M12.1
A      M5.0
AN     M4.1
MOVW   +100, VW332                  // Paso 100: abrir la mordaza (Q0.0 = 0)
R      M12.1, 1
R      M12.2, 1

Network 20 // Paso 100: mordaza abierta (I0.1 apagado + T39)
LDW=   VW332, +100
TON    T39, +4                      // 400 ms para que abra

LDW=   VW332, +100
AN     I0.1                         // Sensor de mordaza cerrada apagado
A      T39
AN     M4.1
S      M12.2, 1                     // Permite pasar al paso 110

Network 21 // Paso 100 -> 110: fin del ciclo manual
// Con la mordaza abierta (M12.2) y otra pulsacion de SB1
LDW=   VW332, +100
A      M12.2
A      M5.0
AN     M4.1
MOVW   +110, VW332                  // Paso 110: ciclo terminado
S      V200.2, 1                    // STAT_DONE = 1
R      M12.2, 1

Network 22 // Paso 110 -> 0: volver a reposo
// Con otra pulsacion de SB1
LDW=   VW332, +110
A      M5.0                         // SB1 para empezar otro ciclo
MOVW   +0, VW332                    // Paso 0 (reposo)
R      V200.2, 1                    // Quitar STAT_DONE

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 5: SBR_AUTO
// ==============================================================================
SUBROUTINE_BLOCK SBR_AUTO:SBR5
TITLE=Secuencia automatica de doble prensado (VW330)
BEGIN

Network 1 // Marcha y pausa en automatico
// Marcha por orden del PLC 1 (V100.0 -> M6.0) o por SB1 local (M5.0)
LD     M6.0
O      M5.0
A      M2.0                         // Seguridad OK
AN     M2.2                         // Seta no accionada
S      M6.0, 1                      // Marcha
R      M6.1, 1                      // Quitar pausa

// Pausa por orden del PLC 1 (V100.1 -> M6.1) o por SB2 local (M5.1)
LD     M6.1
O      M5.1
S      M6.1, 1                      // Pausa

Network 2 // SB1 en automatico con la pieza ya en la mordaza (I0.0) y la estacion en reposo
// Los avisos que llegan fuera del paso 0 se descartan.
LD     M5.0
A      I0.0
AW=    VW330, +0
S      M6.5, 1
LDW<>  VW330, +0
R      M6.4, 1
R      M6.5, 1

Network 3 // Paso 0 -> 10: empezar el ciclo
// Desde el 12-10-2026 ya no arranca solo por ver la pieza con la marcha activa. Antes la
// mordaza cerraba y el carro salia con la pinza de Transporte todavia sujetando la pieza, que se caia.
// Arranca solo si:
// 1. Paso 0, seguridad OK (M2.0), sin atasco (M4.1) y sin pausa (M6.1)
// 2. Cilindros en reposo (I0.2 = 1 carro en origen, I0.4 = 1 prensa arriba, I0.1 = 0 mordaza abierta)
// 3. Llega CMD_PIEZA_ENTREGADA (M6.4), que el PLC 1 envia cuando su pinza ya solto la pieza, subio y
//    se retiro, o SB1 local (M6.5)
// 4. La pieza esta presente (I0.0) y quieta 0,8 s (T40) antes de cerrar la mordaza
LDW=   VW330, +0
A      M2.0
AN     M4.1
AN     M6.1
A      I0.2                         // Carro en el origen
A      I0.4                         // Prensa arriba
AN     I0.1                         // Mordaza abierta
A      I0.0                         // Pieza en la mordaza
LD     M6.4                         // Transporte dejo la pieza y se retiro
O      M6.5                         // o SB1 local con la pieza presente
ALD
TON    T40, +8                      // 0,8 s para que la pieza se asiente

LD     T40
AW=    VW330, +0
MOVW   +10, VW330                   // Paso 10: cerrar la mordaza
R      M6.4, 1                      // Aviso de pieza atendido
R      M6.5, 1                      // Orden local atendida

Network 4 // Paso 10 -> 20: mordaza cerrada (I0.1)
LDW=   VW330, +10
A      I0.1                         // Mordaza cerrada
AN     M4.1
MOVW   +20, VW330                   // Paso 20: carro hacia la prensa (Q0.2 = 1)

Network 5 // Paso 20 -> 30: carro bajo la prensa (I0.3)
LDW=   VW330, +20
A      I0.3                         // Carro bajo la prensa
AN     M4.1
MOVW   +30, VW330                   // Paso 30: bajar la prensa, golpe 1 (Q0.3 = 1)

Network 6 // Paso 30 -> 40: prensa abajo, golpe 1 (I0.5)
LDW=   VW330, +30
A      I0.5                         // Prensa abajo
AN     M4.1
MOVW   +40, VW330                   // Paso 40: mantener el golpe 1

Network 7 // Paso 40 -> 50: fin del golpe 1 (500 ms con T37)
LDW=   VW330, +40
A      I0.5
TON    T37, +5                      // 500 ms (base 100 ms)

LDW=   VW330, +40
A      I0.5
A      T37
AN     M4.1
MOVW   +50, VW330                   // Paso 50: subir la prensa (Q0.3 = 0)

Network 8 // Paso 50 -> 60: prensa arriba, golpe 1 (I0.4)
LDW=   VW330, +50
A      I0.4                         // Prensa arriba
AN     M4.1
MOVW   +60, VW330                   // Paso 60: bajar la prensa, golpe 2 (Q0.3 = 1)

Network 9 // Paso 60 -> 70: prensa abajo, golpe 2 (I0.5)
LDW=   VW330, +60
A      I0.5                         // Prensa abajo
AN     M4.1
MOVW   +70, VW330                   // Paso 70: mantener el golpe 2

Network 10 // Paso 70 -> 80: fin del golpe 2 (500 ms con T38)
LDW=   VW330, +70
A      I0.5
TON    T38, +5                      // 500 ms (base 100 ms)

LDW=   VW330, +70
A      I0.5
A      T38
AN     M4.1
MOVW   +80, VW330                   // Paso 80: subir la prensa (Q0.3 = 0)

Network 11 // Paso 80 -> 90: prensa arriba, golpe 2 (I0.4)
LDW=   VW330, +80
A      I0.4                         // Prensa arriba
AN     M4.1
MOVW   +90, VW330                   // Paso 90: carro al origen (Q0.2 = 0)

Network 12 // Paso 90 -> 100: carro en el origen (I0.2)
LDW=   VW330, +90
A      I0.2                         // Carro en el origen
AN     M4.1
MOVW   +100, VW330                  // Paso 100: abrir la mordaza (Q0.0 = 0)

Network 13 // Paso 100 -> 110: mordaza abierta (I0.1 apagado + T39)
LDW=   VW330, +100
TON    T39, +4                      // 400 ms para que abra

LDW=   VW330, +100
AN     I0.1                         // Sensor de mordaza cerrada apagado
A      T39
AN     M4.1
MOVW   +110, VW330                  // Paso 110: esperar que Transporte retire la pieza
S      V200.2, 1                    // STAT_DONE = 1 para el PLC 1

Network 14 // Paso 110 -> 0: Transporte retiro la pieza
// Se confirma cuando el sensor I0.0 se apaga
// o cuando llega CMD_RETIRO_CONFIRMADO (M6.6 = 1)
LDW=   VW330, +110
A      M6.6                         // Aviso de retiro del PLC 1
LDW=   VW330, +110
AN     I0.0                         // o sensor libre
OLD
MOVW   +0, VW330                    // Paso 0 (reposo)
R      V200.2, 1                    // Quitar STAT_DONE
R      M6.6, 1                      // Aviso atendido

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 6: SBR_ACTUADORES
// ==============================================================================
SUBROUTINE_BLOCK SBR_ACTUADORES:SBR6
TITLE=Salidas: electrovalvulas y focos HL1, HL2, HL3
BEGIN

Network 1 // Mordaza Q0.0 (1 = cerrar, 0 = abrir)
// Cerrada durante el viaje del carro, los dos golpes y el regreso:
// - Automatico: pasos 10 a 90 (VW330)
// - Manual: pasos 10 a 90 (VW332)
// Solo con seguridad OK (M2.0 = 1), sin atasco (M4.1 = 0) y seta liberada (I1.4 = 1)
LDW>=  VW330, +10
AW<=   VW330, +90
A      M5.2                         // Automatico
LDW>=  VW332, +10
AW<=   VW332, +90
AN     M5.2                         // Manual
OLD
A      M2.0                         // Seguridad OK
AN     M4.1                         // Sin atasco
A      I1.4                         // Seta liberada
=      Q0.0

Network 2 // Carro Q0.2 (1 = hacia la prensa, 0 = al origen)
// Bajo la prensa durante los dos golpes:
// - Automatico: pasos 20 a 80 (VW330)
// - Manual: pasos 20 a 80 (VW332)
// Solo con seguridad OK (M2.0 = 1), sin atasco (M4.1 = 0) y seta liberada (I1.4 = 1)
LDW>=  VW330, +20
AW<=   VW330, +80
A      M5.2                         // Automatico
LDW>=  VW332, +20
AW<=   VW332, +80
AN     M5.2                         // Manual
OLD
A      M2.0                         // Seguridad OK
AN     M4.1                         // Sin atasco
A      I1.4                         // Seta liberada
=      Q0.2

Network 3 // Prensa Q0.3 (1 = bajar, 0 = subir)
// Baja solo en los dos golpes:
// - Automatico: pasos 30 y 40 (golpe 1), 60 y 70 (golpe 2)
// - Manual: pasos 30 y 40 (golpe 1), 60 y 70 (golpe 2)
// Condiciones:
// 1. Seguridad OK (M2.0 = 1) y seta liberada (I1.4 = 1)
// 2. Sin atasco (M4.1 = 0)
// 3. Carro confirmado bajo la prensa (I0.3 = 1)
LDW=   VW330, +30
OW=    VW330, +40
OW=    VW330, +60
OW=    VW330, +70
A      M5.2                         // Automatico
LDW=   VW332, +30
OW=    VW332, +40
OW=    VW332, +60
OW=    VW332, +70
AN     M5.2                         // Manual
OLD
A      M2.0                         // Seguridad OK
AN     M4.1                         // Sin atasco
A      I1.4                         // Seta liberada
A      I0.3                         // Nunca bajar si el carro no esta bajo la prensa
=      Q0.3

Network 4 // Foco verde HL1 (Q1.0): ciclo en marcha
// Encendido mientras la estacion trabaja:
// - Automatico: VW330 entre 1 y 109
// - Manual: VW332 entre 1 y 109
// Apagado con la seta o con atasco
LDW>   VW330, +0
AW<    VW330, +110
A      M5.2
LDW>   VW332, +0
AW<    VW332, +110
AN     M5.2
OLD
A      M2.0
AN     M4.1
=      Q1.0

Network 5 // Foco amarillo HL2 (Q0.7): manual, pausa o aviso
// 1. Manual en reposo: parpadea a 1 Hz (SM0.5), listo para SB1
LDN    M5.2
AW=    VW332, +0
A      SM0.5
// 2. Manual con el movimiento confirmado, esperando SB1: parpadea a 2 Hz (SM0.4)
LDN    M5.2
A      M11.1
O      M11.2
O      M11.3
O      M11.4
O      M11.5
O      M11.6
O      M11.7
O      M12.0
O      M12.1
O      M12.2
AN     M5.2
A      SM0.4
OLD
// 3. Automatico en pausa o esperando retiro (paso 110): fijo
LD     M5.2
A      M6.1
LD     M5.2
AW=    VW330, +110
OLD
OLD
// 4. Automatico con aviso de fuga o lentitud (M4.0 = 1): parpadea a 1 Hz
LD     M5.2
A      M4.0
A      SM0.5
OLD
// 5. Esperando rearme despues de la seta (M2.1 = 1): parpadea a 2 Hz
LD     M2.1
A      SM0.4
OLD
// Apagado con la seta accionada
AN     M2.2
A      I1.4
=      Q0.7

Network 6 // Foco rojo HL3 (Q1.1): seta accionada o atasco
// 1. Seta accionada (I1.4 = 0 o M2.2 = 1): fijo
// 2. Atasco, un cilindro tardo mas de lo permitido (M4.1 = 1): fijo
LDN    I1.4
O      M2.2
O      M4.1
=      Q1.1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 7: SBR_COMMS_PPI
// ==============================================================================
SUBROUTINE_BLOCK SBR_COMMS_PPI:SBR7
TITLE=Datos para el PLC 1 (VB200..VB207)
BEGIN

Network 1 // VB200 (STAT_GLOBAL): byte de estado
// Bit 0: STAT_READY (en reposo y lista)
LDW=   VW330, +0
A      M5.2
A      M2.0
AN     M4.1
A      I0.2                         // Carro en el origen
A      I0.4                         // Prensa arriba
AN     I0.1                         // Mordaza abierta
AN     I0.0                         // Mordaza vacia, esperando pieza
LDW=   VW332, +0
AN     M5.2
A      M2.0
AN     M4.1
OLD
=      V200.0

// Bit 1: STAT_BUSY (secuencia en curso)
LDW>   VW330, +0
AW<    VW330, +110
A      M5.2
LDW>   VW332, +0
AW<    VW332, +110
AN     M5.2
OLD
=      V200.1

// Bit 2: STAT_DONE (prensado terminado, pieza lista en la mordaza)
LDW=   VW330, +110
A      M5.2
LDW=   VW332, +110
AN     M5.2
OLD
=      V200.2

// Bit 3: STAT_ALM_ATASCO (un cilindro tardo mas de lo permitido)
LD     M4.1
=      V200.3

// Bit 4: STAT_ALM_FUGA (aviso de fuga o lentitud)
LD     M4.0
=      V200.4

// Bit 5: sin uso (0)
LD     SM0.0
R      V200.5, 1

// Bit 6: seta QS (I1.4) accionada o sin liberar (para la baliza de la planta)
LDN    I1.4
O      M2.2
=      V200.6

// Bit 7: STAT_HOMED (carro en el origen I0.2 y prensa arriba I0.4)
LD     I0.2                         // Carro en el origen
A      I0.4                         // Prensa arriba
A      M2.0                         // Seguridad OK
=      V200.7

Network 2 // VB201 (STAT_PASO): paso actual para el SCADA
// Automatico: VB331 (byte bajo de VW330: 0, 10, 20... 110)
// Manual: VB333 (byte bajo de VW332: 0, 10, 20... 110)
LD     M5.2
MOVB   VB331, VB201
LDN    M5.2
MOVB   VB333, VB201

Network 3 // VB202 (STAT_INPUTS): copia de IB0
LD     SM0.0
MOVB   IB0, VB202

Network 4 // VB203 (STAT_DATA): sin uso
LD     SM0.0
MOVB   0, VB203

Network 5 // VB204..VB207: datos extra para el SCADA (el PLC 1 lee 8 bytes)
// VB204 = IB1 (SB2, SB1, seta, selector), VB205 = QB0 (electrovalvulas), VB206 = QB1 (focos), VB207 libre
LD     SM0.0
MOVB   IB1, VB204
MOVB   QB0, VB205
MOVB   QB1, VB206
MOVB   0, VB207

END_SUBROUTINE_BLOCK
