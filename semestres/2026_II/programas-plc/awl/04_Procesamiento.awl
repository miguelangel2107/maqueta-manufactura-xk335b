ORGANIZATION_BLOCK MAIN:OB1
TITLE=UNIDAD 4: PROCESAMIENTO - ARQUITECTURA MODULAR CONGELADA XL-335B
// ==============================================================================
// SISTEMA: CELDA DE MANUFACTURA FLEXIBLE XL-335B
// MODULO: UNIDAD 4 - ESTACION DE PROCESAMIENTO Y PRENSADO (ESTAMPADO DOBLE)
// CPU: SIEMENS SIMATIC S7-200 CPU 224CN (1 PUERTO RS-485 INTEGRADO)
// PUERTO 0: ESCLAVO EN BUS PPI (DIRECCION DE ESTACION 4, 19200 BPS, 8-E-1)
// ==============================================================================
// ARQUITECTURA MODULAR DE SUBRUTINAS:
//   - OB1: Coordinador general y despacho condicional segun selector SA1 (I1.5)
//   - SBR0 (SBR_INIT): Reset de variables y buffers en primer ciclo (SM0.1)
//   - SBR1 (SBR_IO_SCAN): Captura de entradas, flancos EU de pulsadores y handshake
//   - SBR2 (SBR_SEGURIDAD): Logica QS fail-safe (I1.4), corte y rearme con SB1 (I1.3)
//   - SBR3 (SBR_DIAGNOSTICO): Temporizadores T33..T36 y T97 para medicion Delta-t y atascos
//   - SBR4 (SBR_MAN_STEP): Secuenciador manual paso a paso por palabras (VW332)
//   - SBR5 (SBR_AUTO): Secuencia automatica doble estampado por palabras (VW330)
//   - SBR6 (SBR_ACTUADORES): Mapeo de electrovalvulas Q0.0, Q0.2, Q0.3 y balizas HL1, HL2, HL3
//   - SBR7 (SBR_COMMS_PPI): Empaquetado estandarizado de registros de red VB200..VB203
// REVISION AUDITADA: Paso Auto VW100 -> VW330 y Paso Manual VW102 -> VW332. Antes se
// solapaban con el buffer PPI VB100..VB103 escrito por el PLC 1 (NETW de 4 bytes).
// Comandos PPI capturados por flanco EU (sin borrado local de VB100).
// ==============================================================================
BEGIN

Network 1 // Modulo 0: Inicializacion General en Primer Scan (SM0.1)
LD     SM0.1
CALL   SBR_INIT

Network 2 // Modulo 1: Escaneo de Entradas Digitales, Flancos EU y Handshake PPI
LD     SM0.0
CALL   SBR_IO_SCAN

Network 3 // Modulo 2: Supervision de Seguridad Fail-Safe y Rearme Local (Siempre Activo)
LD     SM0.0
CALL   SBR_SEGURIDAD

Network 4 // Modulo 3: Diagnostico Neumatico Delta-t, Supervision y Atascos (Siempre Activo)
LD     SM0.0
CALL   SBR_DIAGNOSTICO

Network 5 // Modulo 4: Secuenciador Manual Paso a Paso (Activo si SA1 = 0 / Manual)
LDN    M5.2                         // Selector SA1 en Manual / Diagnostico (I1.5 = 0)
CALL   SBR_MAN_STEP

Network 6 // Modulo 5: Secuenciador Automatico Doble Estampado (Activo si SA1 = 1 / Auto)
LD     M5.2                         // Selector SA1 en Modo Automatico (I1.5 = 1)
CALL   SBR_AUTO

Network 7 // Modulo 6: Mapeo de Actuadores y Balizas HL1, HL2, HL3 (Siempre Activo)
LD     SM0.0
CALL   SBR_ACTUADORES

Network 8 // Modulo 7: Sincronizacion de Buffers de Red PPI Nodo 4 (Siempre Activo)
LD     SM0.0
CALL   SBR_COMMS_PPI

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_INIT (INICIALIZACION EN PRIMER SCAN)
// ==============================================================================
SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=INICIALIZACION GENERAL DE VARIABLES, REGISTROS Y BUFFERS
BEGIN

Network 1 // Inicializacion de Maquinas de Estados en Reposo (Paso 0)
LD     SM0.0
MOVW   +0, VW330                    // Maquina de Estados Auto: Paso 0 = Reposo
MOVW   +0, VW332                    // Maquina de Estados Manual: Paso 0 = Reposo
MOVB   0, VB100                     // Buffer Comandos Maestro PPI limpio
MOVB   0, VB101
MOVB   0, VB102
MOVB   0, VB103
MOVB   0, VB200                     // Buffer Telemetria Esclavo limpio
MOVB   0, VB201                     // STAT_PASO en 0
MOVB   0, VB202                     // STAT_INPUTS en 0
MOVB   0, VB203                     // STAT_DATA en 0

Network 2 // Valores Nominales Calibrados de Tiempos Neumaticos Delta-t (ms)
LD     SM0.0
MOVW   +250, VW210                  // Delta-t nominal Cierre Mordaza (250 ms)
MOVW   +350, VW212                  // Delta-t nominal Avance Carro a Prensa (350 ms)
MOVW   +400, VW214                  // Delta-t nominal Descenso Prensa (400 ms)
MOVW   +350, VW216                  // Delta-t nominal Ascenso Prensa (350 ms)
MOVW   +350, VW218                  // Delta-t nominal Retorno Carro a Origen (350 ms)

Network 3 // Limpieza de Banderas de Control, Alarmas y Enclavamientos
LD     SM0.0
R      M2.0, 8                      // M2.0 = SEGURIDAD_OK, M2.1 = ESPERA_REARME, M2.2 = EMERGENCIA_ACTIVA
R      M4.0, 8                      // M4.0 = ALM_FUGA, M4.1 = ALM_ATASCO
R      M5.0, 8                      // M5.0 = PULSO_SB1, M5.1 = PULSO_SB2, M5.2 = MODO_AUTO
R      M6.0, 8                      // M6.0 = MARCH_AUTO, M6.1 = PAUSA_AUTO, M6.4 = PIEZA_ENTREGADA, M6.6 = RETIRADO
R      M11.0, 8                     // Flags de permisos paso a paso manual (M11.1..M11.7)
R      M12.0, 8                     // Flags de permisos paso a paso manual (M12.0..M12.3)
R      Q0.0, 8                      // Desenergizacion de salidas fisicas al arranque
R      Q1.0, 8

Network 4 // Configuracion Inicial de Seguridad Fail-Safe al Energizar
// Si la seta esta liberada (I1.4=1), exigir confirmacion fisica con SB1 (Espera de Rearme)
LD     I1.4
=      M2.1                         // M2.1 = Espera Rearme con SB1
LDN    I1.4
=      M2.2                         // M2.2 = Emergencia Activa fisica

Network 5 // Banderas de Estado PPI Iniciales
LD     SM0.0
S      V200.0, 1                    // STAT_READY = 1 (Listo en reposo)
S      V200.7, 1                    // STAT_HOMED = 1 (Origen referenciado)

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 1: SBR_IO_SCAN (CAPTURA DE ENTRADAS, FLANCOS EU Y DESACOPLO PPI)
// ==============================================================================
SUBROUTINE_BLOCK SBR_IO_SCAN:SBR1
TITLE=CAPTURA DE ENTRADAS, FILTRADO DE FLANCOS EU Y DESACOPLO DE COMANDOS PPI
BEGIN

Network 1 // Captura del Selector de Modo SA1 (I1.5)
LD     I1.5
=      M5.2                         // 1 = Modo Automatico, 0 = Modo Manual / Diagnostico

Network 2 // Evaluacion de Flanco Ascendente (EU) de Marcha / Avance SB1 (I1.3)
// Boton NA (Normalmente Abierto): reposo 0, presionado 1 -> Evaluacion estricta EU (Elimina bug EU+ED)
LD     I1.3
EU
=      M5.0                         // M5.0 = Pulso de activacion de un ciclo de scan para SB1

Network 3 // Evaluacion de Flanco Ascendente (EU) de Parada / Reset SB2 (I1.2)
// Boton NA (Normalmente Abierto): reposo 0, presionado 1 -> Evaluacion estricta EU (Elimina bug EU+ED)
LD     I1.2
EU
=      M5.1                         // M5.1 = Pulso de activacion de un ciclo de scan para SB2

Network 4 // Captura y Desacoplo de Comandos Entrantes PPI desde Maestro PLC 1
// El PLC 1 entrega cada bit en modo "envio unico" (1 durante un ciclo NETW y luego 0).
// Se enclava por flanco EU y NO se borra VB100 localmente: una reescritura del maestro
// nunca duplica una orden y el buffer ya no comparte memoria con las palabras de paso.
LD     V100.0
EU
S      M6.0, 1                      // CMD_START remoto

LD     V100.1
EU
S      M6.1, 1                      // CMD_PAUSE remoto

LD     V100.3
EU
S      M6.3, 1                      // CMD_ACK_RESET remoto

LD     V100.4
EU
S      M6.4, 1                      // CMD_PIEZA_ENTREGADA remoto (Transporte coloco pieza en mordaza)

LD     V100.6
EU
S      M6.6, 1                      // CMD_RETIRO_CONFIRMADO remoto (Transporte retiro pieza estampada)


END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 2: SBR_SEGURIDAD (LOGICA QS FAIL-SAFE Y REARME POR SB1)
// ==============================================================================
SUBROUTINE_BLOCK SBR_SEGURIDAD:SBR2
TITLE=LOGICA DE PARADA DE EMERGENCIA FAIL-SAFE QS (I1.4) Y REARME POR SB1
BEGIN

Network 1 // Deteccion de Parada de Emergencia Activa (I1.4 = 0)
// Seta de Parada de Emergencia NC fail-safe: 1 = Seguro, 0 = Emergencia activa
LDN    I1.4
LPS
S      M2.2, 1                      // M2.2 = Flag de Emergencia Activa
R      M2.0, 1                      // Cancelar bandera de Seguridad OK
R      M2.1, 1                      // Cancelar espera de rearme (emergencia fisica en curso)
MOVW   +0, VW330                    // Abortar ciclo Automatico a Reposo (Paso 0)
MOVW   +0, VW332                    // Abortar ciclo Manual a Reposo (Paso 0)
R      M6.0, 1                      // Reset comando de Marcha
R      M6.4, 1                      // Reset bandera pieza entregada
R      M11.0, 8                     // Reset permisos manuales M11.1..M11.7
R      M12.0, 8                     // Reset permisos manuales M12.0..M12.3
LRD
R      Q0.0, 1                      // Desenergizacion inmediata electrovalvula mordaza
R      Q0.2, 1                      // Desenergizacion inmediata electrovalvula carro
R      Q0.3, 1                      // Desenergizacion inmediata electrovalvula prensa
R      Q1.0, 1                      // Baliza verde HL1 OFF
R      Q0.7, 1                      // Baliza amarilla HL2 OFF
S      Q1.1, 1                      // Baliza roja HL3 ON (Emergencia)
LPP
R      V200.2, 1                    // Reset STAT_DONE

Network 2 // Deteccion de Seta Desenclavada (I1.4 = 1) - Transicion a Espera de Rearme
// Cuando I1.4 retorna a 1 tras emergencia, NO arrancar: pasar a Espera de Rearme
LD     I1.4
A      M2.2                         // Venia de emergencia activa
R      M2.2, 1                      // Seta liberada fisicamente
S      M2.1, 1                      // Entrar en estado de Espera de Rearme
R      M2.0, 1                      // Mantener bloqueada la operacion

Network 3 // Rearme: SB1 local o ACK_RESET remoto (SB1 de Transporte / SCADA), solo en Espera de Rearme
// Requiere: Seta desenclavada (I1.4=1) y estado de Espera de Rearme (M2.1=1)
LD     M5.0                         // Operario pulsa fisicamente Marcha SB1
O      M6.3                         // O comando remoto ACK_RESET desde Maestro
A      M2.1
A      I1.4
S      M2.0, 1                      // M2.0 = SEGURIDAD_OK (Habilita operacion de la celda)
R      M2.1, 1                      // Fin de Espera de Rearme
R      M2.2, 1                      // Limpiar Emergencia Activa
R      M4.0, 2                      // Reset alarmas de Atasco (M4.1) y Fuga (M4.0)
R      V200.3, 1                    // Reset STAT_ALM_ATASCO PPI
R      V200.4, 1                    // Reset STAT_ALM_FUGA PPI
R      M6.1, 1                      // Reset pausa
R      M6.3, 1                      // Consumir comando ACK_RESET
MOVW   +0, VW330                    // Confirmar Paso 0 Reposo
MOVW   +0, VW332

Network 4 // ACK_RESET remoto con la estacion ya rearmada: solo borra alarmas (los pasos NO se reinician)
// El PLC 1 lo envia con cada SB1 de Transporte en Automatico: no debe interrumpir un prensado.
LD     M6.3
A      M2.0
R      M4.0, 2
R      V200.3, 1
R      V200.4, 1
LD     M6.3
R      M6.3, 1                      // Consumir (tambien durante una emergencia)

Network 5 // Desbloqueo y Reset Manual con Pulsador SB2 (I1.2 -> M5.1)
// Permite al operador en cualquier momento reiniciar a Paso 0 y borrar alarmas de atasco
LD     M5.1
LPS
MOVW   +0, VW330                    // Reset a Paso 0
MOVW   +0, VW332                    // Reset a Paso 0
R      M4.0, 2                      // Borrar alarmas Atasco (M4.1) y Fuga (M4.0)
R      V200.3, 1                    // Borrar alarmas PPI
R      V200.4, 1
R      M11.0, 8                     // Reset permisos manuales
R      M12.0, 8
R      M6.0, 1
R      M6.5, 1
LPP
R      M6.4, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 3: SBR_DIAGNOSTICO (SUPERVISION NEUMATICA DELTA-T Y ATASCOS)
// ==============================================================================
SUBROUTINE_BLOCK SBR_DIAGNOSTICO:SBR3
TITLE=SUPERVISION NEUMATICA, MEDICION DELTA-T (T33..T36, T97) Y ALARMAS DE ATASCO
BEGIN

Network 1 // Delta-t Cierre Mordaza (T33 base 10ms) -> Destino VW210
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.1 antes de reset TON
LD     I0.1
EU
LDW=   VW330, +10
OW=    VW332, +10
ALD
MOVW   T33, VW210
*I     +10, VW210                   // Conversion de cuentas base 10ms a ms
AW>    VW210, +450                  // Umbral alerta preventiva de fuga (>450 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el movimiento y no alcance I0.1
LDW=   VW330, +10
OW=    VW332, +10
AN     I0.1
TON    T33, +32767

// 3. Deteccion de atasco critico: T33 > 150 (1.5 s) sin activar reed I0.1
LDW>   T33, +150
AN     I0.1
S      M4.1, 1                      // Alarma Atasco Critico Neumatico

Network 2 // Delta-t Avance Carro a Prensa (T34 base 10ms) -> Destino VW212
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.3 antes de reset TON
LD     I0.3
EU
LDW=   VW330, +20
OW=    VW332, +20
ALD
MOVW   T34, VW212
*I     +10, VW212                   // Conversion a ms
AW>    VW212, +550                  // Umbral alerta preventiva de fuga (>550 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el movimiento y no alcance I0.3
LDW=   VW330, +20
OW=    VW332, +20
AN     I0.3
TON    T34, +32767

// 3. Deteccion de atasco critico: T34 > 150 (1.5 s) sin activar reed I0.3
LDW>   T34, +150
AN     I0.3
S      M4.1, 1

Network 3 // Delta-t Descenso Prensa Golpe 1 y Golpe 2 (T35 base 10ms) -> Destino VW214
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.5 antes de reset TON
LD     I0.5
EU
LDW=   VW330, +30
OW=    VW330, +60
OW=    VW332, +30
OW=    VW332, +60
ALD
MOVW   T35, VW214
*I     +10, VW214                   // Conversion a ms
AW>    VW214, +500                  // Umbral alerta preventiva de fuga (>500 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el descenso y no alcance I0.5
LDW=   VW330, +30
OW=    VW330, +60
OW=    VW332, +30
OW=    VW332, +60
AN     I0.5
TON    T35, +32767

// 3. Deteccion de atasco critico: T35 > 150 (1.5 s) sin activar reed I0.5
LDW>   T35, +150
AN     I0.5
S      M4.1, 1

Network 4 // Delta-t Ascenso Prensa Golpe 1 y Golpe 2 (T36 base 10ms) -> Destino VW216
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.4 antes de reset TON
LD     I0.4
EU
LDW=   VW330, +50
OW=    VW330, +80
OW=    VW332, +50
OW=    VW332, +80
ALD
MOVW   T36, VW216
*I     +10, VW216                   // Conversion a ms
AW>    VW216, +500                  // Umbral alerta preventiva de fuga (>500 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el ascenso y no alcance I0.4
LDW=   VW330, +50
OW=    VW330, +80
OW=    VW332, +50
OW=    VW332, +80
AN     I0.4
TON    T36, +32767

// 3. Deteccion de atasco critico: T36 > 150 (1.5 s) sin activar reed I0.4
LDW>   T36, +150
AN     I0.4
S      M4.1, 1

Network 5 // Delta-t Retorno Carro a Origen (T97 base 10ms) -> Destino VW218
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.2 antes de reset TON
LD     I0.2
EU
LDW=   VW330, +90
OW=    VW332, +90
ALD
MOVW   T97, VW218
*I     +10, VW218                   // Conversion a ms
AW>    VW218, +550                  // Umbral alerta preventiva de fuga (>550 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el retorno y no alcance I0.2
LDW=   VW330, +90
OW=    VW332, +90
AN     I0.2
TON    T97, +32767

// 3. Deteccion de atasco critico: T97 > 150 (1.5 s) sin activar reed I0.2
LDW>   T97, +150
AN     I0.2
S      M4.1, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 4: SBR_MAN_STEP (MODO MANUAL PASO A PASO POR PALABRAS VW332)
// ==============================================================================
SUBROUTINE_BLOCK SBR_MAN_STEP:SBR4
TITLE=SECUENCIADOR MANUAL PASO A PASO POR PALABRAS (VW332) CON PULSADOR SB1
BEGIN

Network 1 // Transicion Paso 0 (Reposo) -> Paso 10 (Cierre de Mordaza)
// Requiere: VW332=0, Seguridad OK (M2.0=1), Sin Atasco (M4.1=0), Pulsacion SB1 (M5.0)
LDW=   VW332, +0
A      M2.0
AN     M4.1
A      M5.0                         // Operario presiona SB1 (I1.3)
MOVW   +10, VW332                   // Paso 10: Cierre de mordaza (Q0.0=1)
R      M11.1, 1                     // Limpiar permiso de siguiente paso

Network 2 // Paso 10: Confirmacion de Mordaza Cerrada (I0.1)
LDW=   VW332, +10
A      I0.1                         // Reed mordaza cerrada confirmado
AN     M4.1
S      M11.1, 1                     // Habilita permiso para avanzar a Paso 20

Network 3 // Transicion Paso 10 -> Paso 20 (Avance Carro a Prensa)
// Requiere: Confirmacion previa (M11.1) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +10
A      M11.1
A      M5.0
AN     M4.1
MOVW   +20, VW332                   // Paso 20: Carro avanza bajo prensa (Q0.2=1)
R      M11.1, 1
R      M11.2, 1

Network 4 // Paso 20: Confirmacion de Carro Bajo Prensa (I0.3)
LDW=   VW332, +20
A      I0.3                         // Reed carro en prensa confirmado
AN     M4.1
S      M11.2, 1                     // Habilita permiso para avanzar a Paso 30

Network 5 // Transicion Paso 20 -> Paso 30 (Descenso Prensa Golpe 1)
// Requiere: Confirmacion previa (M11.2) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +20
A      M11.2
A      M5.0
AN     M4.1
MOVW   +30, VW332                   // Paso 30: Descenso prensa Golpe 1 (Q0.3=1)
R      M11.2, 1
R      M11.3, 1

Network 6 // Paso 30: Confirmacion de Prensa Abajo Golpe 1 (I0.5)
LDW=   VW332, +30
A      I0.5                         // Reed prensa abajo estampado confirmado
AN     M4.1
S      M11.3, 1                     // Habilita permiso para avanzar a Paso 40

Network 7 // Transicion Paso 30 -> Paso 40 (Sostenimiento Prensado 1)
// Requiere: Confirmacion previa (M11.3) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +30
A      M11.3
A      M5.0
AN     M4.1
MOVW   +40, VW332                   // Paso 40: Sostenimiento de prensado 1 (500 ms)
R      M11.3, 1
R      M11.4, 1

Network 8 // Paso 40: Temporizador de Sostenimiento Golpe 1 (500 ms con T37)
LDW=   VW332, +40
A      I0.5
TON    T37, +5                      // 500 ms (Base 100ms: 5 x 100ms)

LDW=   VW332, +40
A      I0.5
A      T37
AN     M4.1
S      M11.4, 1                     // Habilita permiso para avanzar a Paso 50

Network 9 // Transicion Paso 40 -> Paso 50 (Ascenso Prensa Golpe 1)
// Requiere: Sostenimiento cumplido (M11.4) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +40
A      M11.4
A      M5.0
AN     M4.1
MOVW   +50, VW332                   // Paso 50: Ascenso prensa Golpe 1 (Q0.3=0)
R      M11.4, 1
R      M11.5, 1

Network 10 // Paso 50: Confirmacion de Prensa Arriba Golpe 1 (I0.4)
LDW=   VW332, +50
A      I0.4                         // Reed prensa arriba cota de seguridad
AN     M4.1
S      M11.5, 1                     // Habilita permiso para avanzar a Paso 60

Network 11 // Transicion Paso 50 -> Paso 60 (Descenso Prensa Golpe 2)
// Requiere: Confirmacion previa (M11.5) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +50
A      M11.5
A      M5.0
AN     M4.1
MOVW   +60, VW332                   // Paso 60: Descenso prensa Golpe 2 (Q0.3=1)
R      M11.5, 1
R      M11.6, 1

Network 12 // Paso 60: Confirmacion de Prensa Abajo Golpe 2 (I0.5)
LDW=   VW332, +60
A      I0.5                         // Reed prensa abajo confirmado
AN     M4.1
S      M11.6, 1                     // Habilita permiso para avanzar a Paso 70

Network 13 // Transicion Paso 60 -> Paso 70 (Sostenimiento Prensado 2)
// Requiere: Confirmacion previa (M11.6) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +60
A      M11.6
A      M5.0
AN     M4.1
MOVW   +70, VW332                   // Paso 70: Sostenimiento de prensado 2 (500 ms)
R      M11.6, 1
R      M11.7, 1

Network 14 // Paso 70: Temporizador de Sostenimiento Golpe 2 (500 ms con T38)
LDW=   VW332, +70
A      I0.5
TON    T38, +5                      // 500 ms (Base 100ms: 5 x 100ms)

LDW=   VW332, +70
A      I0.5
A      T38
AN     M4.1
S      M11.7, 1                     // Habilita permiso para avanzar a Paso 80

Network 15 // Transicion Paso 70 -> Paso 80 (Ascenso Prensa Golpe 2 Definitivo)
// Requiere: Sostenimiento cumplido (M11.7) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +70
A      M11.7
A      M5.0
AN     M4.1
MOVW   +80, VW332                   // Paso 80: Ascenso prensa definitivo (Q0.3=0)
R      M11.7, 1
R      M12.0, 1

Network 16 // Paso 80: Confirmacion de Prensa Arriba Golpe 2 (I0.4)
LDW=   VW332, +80
A      I0.4                         // Reed prensa arriba cota de seguridad
AN     M4.1
S      M12.0, 1                     // Habilita permiso para avanzar a Paso 90

Network 17 // Transicion Paso 80 -> Paso 90 (Retorno de Carro a Origen)
// Requiere: Prensa arriba confirmada (M12.0) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +80
A      M12.0
A      M5.0
AN     M4.1
MOVW   +90, VW332                   // Paso 90: Retorno carro a origen (Q0.2=0)
R      M12.0, 1
R      M12.1, 1

Network 18 // Paso 90: Confirmacion de Carro en Origen (I0.2)
LDW=   VW332, +90
A      I0.2                         // Reed carro en origen confirmado
AN     M4.1
S      M12.1, 1                     // Habilita permiso para avanzar a Paso 100

Network 19 // Transicion Paso 90 -> Paso 100 (Apertura de Mordaza)
// Requiere: Carro en origen (M12.1) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +90
A      M12.1
A      M5.0
AN     M4.1
MOVW   +100, VW332                  // Paso 100: Apertura de mordaza (Q0.0=0)
R      M12.1, 1
R      M12.2, 1

Network 20 // Paso 100: Confirmacion de Mordaza Abierta (AN I0.1 + T39)
LDW=   VW332, +100
TON    T39, +4                      // 400 ms retardo de apertura y escape

LDW=   VW332, +100
AN     I0.1                         // Reed mordaza cerrada apagado (mordaza abierta)
A      T39
AN     M4.1
S      M12.2, 1                     // Habilita permiso para finalizar en Paso 110

Network 21 // Transicion Paso 100 -> Paso 110 (Fin de Ciclo Manual)
// Requiere: Mordaza abierta confirmada (M12.2) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +100
A      M12.2
A      M5.0
AN     M4.1
MOVW   +110, VW332                  // Paso 110: Fin de ciclo de estampado manual
S      V200.2, 1                    // STAT_DONE = 1
R      M12.2, 1

Network 22 // Transicion Paso 110 -> Paso 0 (Retorno a Reposo Manual)
// Requiere: NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +110
A      M5.0                         // Operario pulsa SB1 para reiniciar ciclo
MOVW   +0, VW332                    // Retorno a Reposo (Paso 0)
R      V200.2, 1                    // Reset STAT_DONE

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 5: SBR_AUTO (MODO AUTOMATICO POR PALABRAS VW330 Y RED PPI)
// ==============================================================================
SUBROUTINE_BLOCK SBR_AUTO:SBR5
TITLE=SECUENCIADOR AUTOMATICO POR PALABRAS (VW330) DOBLE ESTAMPADO
BEGIN

Network 1 // Gestion de Comandos de Marcha y Pausa en Modo Automatico
// Marcha solicitada por comando PPI (flanco V100.0 -> M6.0) o por pulsador local SB1 (M5.0)
LD     M6.0
O      M5.0
A      M2.0                         // Seguridad OK
AN     M2.2                         // Sin emergencia
S      M6.0, 1                      // Marcha activa
R      M6.1, 1                      // Reset Pausa

// Pausa solicitada por PPI (flanco V100.1 -> M6.1) o por pulsador local SB2 (M5.1)
LD     M6.1
O      M5.1
S      M6.1, 1                      // Pausa activa

Network 2 // Orden local: SB1 en Automatico con pieza ya presente en la mordaza (I0.0) y estacion en reposo
// Avisos recibidos fuera del Paso 0 se descartan (evita arrancar con una pieza fantasma).
LD     M5.0
A      I0.0
AW=    VW330, +0
S      M6.5, 1
LDW<>  VW330, +0
R      M6.4, 1
R      M6.5, 1

Network 3 // Enclavamiento de Inicio de Secuencia: Paso 0 -> Paso 10
// REV. 2026-10-12 (banco): ya NO arranca solo por ver la pieza con la marcha enclavada. Antes la
// mordaza cerraba y el carro se iba mientras la pinza de Transporte aun sostenia la pieza y esta caia.
// Inicia solo si:
// 1. En Reposo (VW330 = 0), Seguridad OK (M2.0 = 1), Sin Atasco (M4.1 = 0) y sin Pausa (M6.1 = 0)
// 2. Actuadores en reposo fisico (I0.2=1 Carro origen, I0.4=1 Prensa arriba, I0.1=0 Mordaza abierta)
// 3. Disparo: CMD_PIEZA_ENTREGADA (M6.4), que el PLC 1 envia cuando su pinza ya solto, subio y
//    se retiro, u orden local SB1 (M6.5)
// 4. Pieza presente (I0.0) y asentada durante 0.8 s (T40) antes de cerrar la mordaza
LDW=   VW330, +0
A      M2.0
AN     M4.1
AN     M6.1
A      I0.2                         // Carro en origen (zona intercambio)
A      I0.4                         // Prensa arriba reposo
AN     I0.1                         // Mordaza abierta
A      I0.0                         // Sensor fotoelectrico: pieza presente en mordaza
LD     M6.4                         // Transporte dejo la pieza y se retiro
O      M6.5                         // O SB1 local con la pieza presente
ALD
TON    T40, +8                      // 0.8 s de asentamiento de la pieza

LD     T40
AW=    VW330, +0
MOVW   +10, VW330                   // Iniciar Paso 10: Cierre de mordaza
R      M6.4, 1                      // Consumir aviso de pieza entregada
R      M6.5, 1                      // Consumir orden local

Network 4 // Transicion Paso 10 -> Paso 20: Confirmacion Cierre Mordaza (I0.1)
LDW=   VW330, +10
A      I0.1                         // Reed confirmacion mordaza cerrada
AN     M4.1
MOVW   +20, VW330                   // Paso 20: Avance carro a prensa (Q0.2=1)

Network 5 // Transicion Paso 20 -> Paso 30: Confirmacion Carro en Prensa (I0.3)
LDW=   VW330, +20
A      I0.3                         // Reed carro bajo la prensa
AN     M4.1
MOVW   +30, VW330                   // Paso 30: Descenso prensa Golpe 1 (Q0.3=1)

Network 6 // Transicion Paso 30 -> Paso 40: Contacto Estampado Golpe 1 (I0.5)
LDW=   VW330, +30
A      I0.5                         // Reed prensa abajo alcanzado
AN     M4.1
MOVW   +40, VW330                   // Paso 40: Sostenimiento de prensado 1

Network 7 // Transicion Paso 40 -> Paso 50: Fin Sostenimiento Golpe 1 (500 ms con T37)
LDW=   VW330, +40
A      I0.5
TON    T37, +5                      // 500 ms (Base 100ms: 5 x 100ms)

LDW=   VW330, +40
A      I0.5
A      T37
AN     M4.1
MOVW   +50, VW330                   // Paso 50: Ascenso prensa Golpe 1 (Q0.3=0)

Network 8 // Transicion Paso 50 -> Paso 60: Confirmacion Prensa Arriba Golpe 1 (I0.4)
LDW=   VW330, +50
A      I0.4                         // Reed prensa arriba
AN     M4.1
MOVW   +60, VW330                   // Paso 60: Descenso prensa Golpe 2 (Q0.3=1)

Network 9 // Transicion Paso 60 -> Paso 70: Contacto Estampado Golpe 2 (I0.5)
LDW=   VW330, +60
A      I0.5                         // Reed prensa abajo alcanzado
AN     M4.1
MOVW   +70, VW330                   // Paso 70: Sostenimiento de prensado 2

Network 10 // Transicion Paso 70 -> Paso 80: Fin Sostenimiento Golpe 2 (500 ms con T38)
LDW=   VW330, +70
A      I0.5
TON    T38, +5                      // 500 ms (Base 100ms: 5 x 100ms)

LDW=   VW330, +70
A      I0.5
A      T38
AN     M4.1
MOVW   +80, VW330                   // Paso 80: Ascenso prensa definitivo (Q0.3=0)

Network 11 // Transicion Paso 80 -> Paso 90: Confirmacion Prensa Arriba Golpe 2 (I0.4)
LDW=   VW330, +80
A      I0.4                         // Reed prensa arriba
AN     M4.1
MOVW   +90, VW330                   // Paso 90: Retorno carro a origen (Q0.2=0)

Network 12 // Transicion Paso 90 -> Paso 100: Confirmacion Carro en Origen (I0.2)
LDW=   VW330, +90
A      I0.2                         // Reed carro en origen (zona intercambio)
AN     M4.1
MOVW   +100, VW330                  // Paso 100: Apertura de mordaza (Q0.0=0)

Network 13 // Transicion Paso 100 -> Paso 110: Apertura de Mordaza Confirmada (AN I0.1 + T39)
LDW=   VW330, +100
TON    T39, +4                      // 400 ms tiempo de apertura y liberacion

LDW=   VW330, +100
AN     I0.1                         // Reed mordaza cerrada desactivado (mordaza abierta)
A      T39
AN     M4.1
MOVW   +110, VW330                  // Paso 110: Fin de ciclo (espera retirada pieza)
S      V200.2, 1                    // Conmuta STAT_DONE = 1 hacia Maestro PLC 1

Network 14 // Transicion Paso 110 -> Paso 0: Retirada de Pieza Estampada por Transporte
// La pieza conformada es retirada por el manipulador de Transporte:
// Se confirma por caida del sensor fotoelectrico I0.0 = 0 o comando remoto CMD_RETIRO_CONFIRMADO (M6.6=1)
LDW=   VW330, +110
A      M6.6                         // Comando remoto confirmando retirada de Transporte
LDW=   VW330, +110
AN     I0.0                         // O fotocelula libre (pieza retirada fisicamente)
OLD
MOVW   +0, VW330                    // Retorno a Reposo (Paso 0)
R      V200.2, 1                    // Reset STAT_DONE
R      M6.6, 1                      // Consumir comando

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 6: SBR_ACTUADORES (MAPEO DE ELECTROVALVULAS Y BALIZAS)
// ==============================================================================
SUBROUTINE_BLOCK SBR_ACTUADORES:SBR6
TITLE=MAPEO DE SALIDAS FISICAS: ELECTROVALVULAS Y BALIZAS HL1, HL2, HL3
BEGIN

Network 1 // Electrovalvula Mordaza Q0.0 (1 = Cerrar Sujecion, 0 = Abrir / Liberar)
// Permanece cerrada durante todo el traslado, prensado doble y retorno de carro:
// - Modo Auto: Pasos 10 a 90 (VW330 >= 10 y VW330 <= 90)
// - Modo Manual: Pasos 10 a 90 (VW332 >= 10 y VW332 <= 90)
// Enclavamiento critico: SOLO si Seguridad OK (M2.0=1), Sin Atasco (M4.1=0) y Seta OK (I1.4=1)
LDW>=  VW330, +10
AW<=   VW330, +90
A      M5.2                         // En Modo Auto
LDW>=  VW332, +10
AW<=   VW332, +90
AN     M5.2                         // En Modo Manual
OLD
A      M2.0                         // Enclavamiento de Seguridad
AN     M4.1                         // Sin atasco activo
A      I1.4                         // Seta de emergencia desenclavada
=      Q0.0

Network 2 // Electrovalvula Carro Traslacion Q0.2 (1 = Avanzar a Prensa, 0 = Retorno Origen)
// Avanza y permanece bajo la prensa durante el ciclo de doble estampado:
// - Modo Auto: Pasos 20 a 80 (VW330 >= 20 y VW330 <= 80)
// - Modo Manual: Pasos 20 a 80 (VW332 >= 20 y VW332 <= 80)
// Enclavamiento critico: SOLO si Seguridad OK (M2.0=1), Sin Atasco (M4.1=0) y Seta OK (I1.4=1)
LDW>=  VW330, +20
AW<=   VW330, +80
A      M5.2                         // En Modo Auto
LDW>=  VW332, +20
AW<=   VW332, +80
AN     M5.2                         // En Modo Manual
OLD
A      M2.0                         // Enclavamiento de Seguridad
AN     M4.1                         // Sin atasco activo
A      I1.4                         // Seta de emergencia desenclavada
=      Q0.2

Network 3 // Electrovalvula Prensa Estampado Q0.3 (1 = Descenso Estampado, 0 = Ascenso Seguro)
// Desciende exclusivamente en los impactos de estampado Golpe 1 y Golpe 2:
// - Modo Auto: Pasos 30, 40 (Golpe 1) y Pasos 60, 70 (Golpe 2)
// - Modo Manual: Pasos 30, 40 (Golpe 1) y Pasos 60, 70 (Golpe 2)
// Enclavamientos criticos:
// 1. Seguridad OK (M2.0=1) y Seta desenclavada (I1.4=1)
// 2. Sin Atasco activo (M4.1=0)
// 3. INTERLOCK MECANICO: Carro posicionado y confirmado bajo la prensa (I0.3=1)
LDW=   VW330, +30
OW=    VW330, +40
OW=    VW330, +60
OW=    VW330, +70
A      M5.2                         // En Modo Auto
LDW=   VW332, +30
OW=    VW332, +40
OW=    VW332, +60
OW=    VW332, +70
AN     M5.2                         // En Modo Manual
OLD
A      M2.0                         // Seguridad OK
AN     M4.1                         // Sin atasco activo
A      I1.4                         // Seta OK
A      I0.3                         // Interlock indispensable: carro en posicion bajo prensa
=      Q0.3

Network 4 // Baliza Verde HL1 (Q1.0): Ciclo de Estampado en Ejecucion
// Se enciende cuando la estacion esta operando activamente en ciclo:
// - Auto en ejecucion: VW330 > 0 y VW330 < 110
// - Manual en ejecucion: VW332 > 0 y VW332 < 110
// Bloqueada en emergencia o atasco
LDW>   VW330, +0
AW<    VW330, +110
A      M5.2
LDW>   VW332, +0
AW<    VW332, +110
AN     M5.2
OLD
A      M2.0
AN     M4.1
=      Q1.0

Network 5 // Baliza Amarilla HL2 (Q0.7): Modo Manual en Espera, Pausa o Alerta Preventiva
// 1. Modo Manual en Reposo: Titila a 1 Hz (SM0.5) indicando listo para SB1
LDN    M5.2
AW=    VW332, +0
A      SM0.5
// 2. Modo Manual esperando siguiente pulsacion SB1 con carrera confirmada: Titila a 2 Hz (SM0.4)
LDN    M5.2
A      M11.1
O      M11.2
O      M11.3
O      M11.4
O      M11.5
O      M11.6
O      M11.7
O      M12.0
O      M12.1
O      M12.2
AN     M5.2
A      SM0.4
OLD
// 3. Modo Auto en Pausa o en Espera de Retiro Paso 110: Luz Fija
LD     M5.2
A      M6.1
LD     M5.2
AW=    VW330, +110
OLD
OLD
// 4. Modo Auto con Alerta Preventiva de Fuga / Lentitud (M4.0=1): Titila a 1 Hz
LD     M5.2
A      M4.0
A      SM0.5
OLD
// 5. Espera de Rearme tras liberacion de Seta QS (M2.1=1): Titila a 2 Hz
LD     M2.1
A      SM0.4
OLD
// Enclavamiento fail-safe: apagada si hay emergencia activa
AN     M2.2
A      I1.4
=      Q0.7

Network 6 // Baliza Roja HL3 (Q1.1): Parada de Emergencia Activa o Atasco Neumatico
// 1. Emergencia activa por seta accionada (I1.4 = 0 o M2.2 = 1): Fija
// 2. Atasco neumatico critico por timeout de carrera (M4.1 = 1): Fija
LDN    I1.4
O      M2.2
O      M4.1
=      Q1.1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 7: SBR_COMMS_PPI (EMPAQUETADO ESTANDARIZADO DE TELEMETRIA PPI)
// ==============================================================================
SUBROUTINE_BLOCK SBR_COMMS_PPI:SBR7
TITLE=EMPAQUETADO ESTANDARIZADO DE TELEMETRIA PPI (VB200..VB203) HACIA MAESTRO
BEGIN

Network 1 // Empaquetado de Byte de Estado Global: VB200 (STAT_GLOBAL)
// Bit 0: STAT_READY (En reposo y listo para operar)
LDW=   VW330, +0
A      M5.2
A      M2.0
AN     M4.1
A      I0.2                         // Carro en origen
A      I0.4                         // Prensa arriba
AN     I0.1                         // Mordaza abierta
AN     I0.0                         // Mordaza libre esperando entrega
LDW=   VW332, +0
AN     M5.2
A      M2.0
AN     M4.1
OLD
=      V200.0

// Bit 1: STAT_BUSY (Secuencia local en ejecucion)
LDW>   VW330, +0
AW<    VW330, +110
A      M5.2
LDW>   VW332, +0
AW<    VW332, +110
AN     M5.2
OLD
=      V200.1

// Bit 2: STAT_DONE (Secuencia de estampado terminada con exito, pieza lista en mordaza)
LDW=   VW330, +110
A      M5.2
LDW=   VW332, +110
AN     M5.2
OLD
=      V200.2

// Bit 3: STAT_ALM_ATASCO (Alarma por tiempo de carrera excedido)
LD     M4.1
=      V200.3

// Bit 4: STAT_ALM_FUGA (Alerta predictiva de lentitud o fuga de aire)
LD     M4.0
=      V200.4

// Bit 5: Reservado (0)
LD     SM0.0
R      V200.5, 1

// Bit 6: STAT_EMERGENCIA (seta QS I1.4 pulsada o emergencia aun no liberada) -> baliza de planta
LDN    I1.4
O      M2.2
=      V200.6

// Bit 7: STAT_HOMED (Origen fisico referenciado: Carro en origen I0.2 y prensa arriba I0.4)
LD     I0.2                         // Carro en origen
A      I0.4                         // Prensa arriba en reposo
A      M2.0                         // Seguridad normal
=      V200.7

Network 2 // VB201 (STAT_PASO): Copia del Paso Activo para Animacion Web SCADA
// En Auto copia VB331 (byte bajo de VW330 = VB331: 0, 10, 20... 110)
// En Manual copia VB333 (byte bajo de VW332 = VB333: 0, 10, 20... 110)
LD     M5.2
MOVB   VB331, VB201
LDN    M5.2
MOVB   VB333, VB201

Network 3 // VB202 (STAT_INPUTS): Espejo Directo de Entradas Fisicas IB0
LD     SM0.0
MOVB   IB0, VB202

Network 4 // VB203 (STAT_DATA): Estado de Proceso / Spare
LD     SM0.0
MOVB   0, VB203

Network 5 // VB204..VB207: datos extra para el SCADA (el PLC 1 lee 8 bytes)
// VB204 IB1 (SB2, SB1, seta, selector)   VB205 QB0 (electrovalvulas)   VB206 QB1 (focos)   VB207 reservado
LD     SM0.0
MOVB   IB1, VB204
MOVB   QB0, VB205
MOVB   QB1, VB206
MOVB   0, VB207

END_SUBROUTINE_BLOCK
