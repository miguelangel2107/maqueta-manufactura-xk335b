ORGANIZATION_BLOCK MAIN:OB1
TITLE=Unidad 6: Brazo 4DOF (PLC 6)
// Planta XK-335B - Unidad 6: Brazo de 4 grados de libertad (pantografo)
// Retira de la cinta de Seleccion las piezas tipo 4 y 5 y las deja en la mesa.
// CPU 224CN. Puerto 0: esclavo PPI, direccion 6, 19200 bps.
// Funcionamiento:
//   1. Recoge al final de la cinta de Seleccion las piezas tipo 4 (metal + plastico)
//      y tipo 5 (plastico negro, sin nucleo).
//   2. BELT_PERMIT_RUN (V301.6 -> V200.6): apenas la garra sujeta la pieza y el eje Y
//      la levanta 5000 pulsos, se avisa que la cinta de Seleccion ya puede moverse.
//   3. Los ejes X e Y comparten el PTO 1; el rele K1 (Q0.5) lo conecta a X y K2 (Q0.6) a Y.
//   4. El eje Z (giro de la base) usa el PTO 0 (pulsos Q0.0, direccion Q0.2).
//   5. Homing: X (I0.1) -> Z (inductivo I0.0) -> Y (I0.3) -> abrir garra. En este orden no se arrastran los cables.
//   6. Manual: jog con los pulsadores I1.0 a I1.5; I0.7 abre o cierra la garra.
// Intercambio con la planta por PPI (las trayectorias no se cambiaron):
//   a) El PLC 5 detiene la pieza tipo 4/5 en VW318 y pone STAT_ROBOT_WAIT (V200.6 del PLC 5).
//   b) El PLC 1 envia CMD_START (V100.0 de este PLC) = orden de recogida -> M1.0.
//   c) Secuencia 1 si hace falta, luego cierra la garra y sube Y 5000 p -> BELT_PERMIT_RUN
//      (V301.6 -> V200.6). El PLC 1 lo pasa a V100.6 del PLC 5 y la cinta vuelve a andar.
//   d) Deja la pieza en la mesa y vuelve a la zona de recogida -> STAT_DONE (V200.2).
// Los pasos del automatico y del homing estaban en VW100 / VW102 y pisaban VB100..VB103,
// que escribe el PLC 1: ahora estan en VW320 / VW322.
// Las variables internas que estaban desde VB1000 pasaron a VB300 / VB301 / VB302 / VD304 / VD308.
BEGIN
Network 1 // Primer ciclo
// Valores iniciales en el primer ciclo
LD     SM0.1
// Puerto 0: esclavo PPI a 19200 bps (direccion 6 en el bloque de sistema)
R      Q0.0, 8                     // Salidas apagadas
R      M0.0, 32                    // Borrar marcas
MOVB   16#00, VB100                // Ordenes del PLC 1
MOVB   16#00, VB200                // Estado para el PLC 1
MOVB   16#00, VB300               // Ordenes del PLC 1 (copia interna)
MOVB   16#00, VB301               // Estado para el PLC 1 (copia interna)
MOVD   +0, VD304                  // Posicion Z en 0
MOVD   +0, VD308                  // Posicion X/Y en 0
MOVW   +0, VW320                   // Secuencia automatica en reposo
MOVW   +0, VW322                   // Homing en reposo
S      M0.0, 1                     // Al encender hay que hacer homing
// Recorridos del eje X en pulsos (se pueden cambiar en la tabla de estado):
//   VD330 = extension desde el home hasta la zona de recogida en la cinta: 20000 (antes 14000)
//   VD334 = retroceso desde la recogida hasta la mesa y nueva extension al volver: 14000 (antes 8000).
//           La mesa queda en el mismo lugar que antes (20000 - 14000 = 6000 = 14000 - 8000).
MOVD   +20000, VD330
MOVD   +14000, VD334

Network 2 // Reset y parada
// Reset local (flanco de I0.6), STOP (I1.0) o CMD_ESTOP del PLC 1 (V300.2 <- flanco de V100.2)
LD     I0.6                        // Pulsador RESET
EU                                 // Flanco de subida
O      V300.2                     // CMD_ESTOP del PLC 1 (network 5)
O      I1.0                       // STOP en automatico
A      I0.5                        // En automatico
LPS
R      Q0.0, 8                     // Apagar salidas
MOVB   16#00, SMB67                // Parar PTO 0 (eje Z)
MOVB   16#00, SMB77                // Parar PTO 1 (ejes X / Y)
PLS    0
PLS    1
LRD
MOVW   +0, VW320                   // Secuencia automatica a 0
MOVW   +0, VW322                   // Homing a 0
MOVB   16#00, VB301               // Borrar estado
R      V300.2, 1
R      M1.0, 1                     // Descartar una orden de recogida pendiente
S      M0.0, 1                    // Hay que volver a hacer homing
R      M0.3, 1                     // Sin referencia
LPP
R      M0.4, 1                     // Permitir las secuencias

Network 3 // Modo manual
// Modo manual (I0.5 = 0)
LDN    I0.5
LPS
EU
R      M0.3, 1                     // Al volver de manual hay que hacer homing
MOVB   16#00, VB301
R      M1.0, 1                     // En manual no se aceptan ordenes de la red
LPP
CALL   SBR20                      // Subrutina manual

Network 4 // Modo automatico
// Modo automatico (I0.5 = 1)
LD     I0.5
LPS
EU
S      M0.0, 1                     // Al pasar a automatico se revisa la referencia
LPP
CALL   SBR21                       // Subrutina automatica

Network 5 // Ordenes del PLC 1 (VB100; cada bit llega una sola vez, se toma el flanco)
// V100.0 CMD_START = orden de recogida en el fin de cinta (el PLC 5 aviso STAT_ROBOT_WAIT)
//   -> activa M1.0. Si el brazo no esta en la zona de recogida, primero hace la secuencia 1
//      y despues sigue con la recogida (SBR_AUTO networks 2 y 12).
// V100.2 CMD_ESTOP = seta QS de la planta -> parada y nuevo homing (network 2).
LD     V100.0
EU
A      I0.5                        // Solo en automatico
S      M1.0, 1
LD     V100.2
EU
S      V300.2, 1

Network 6 // Estado para el PLC 1 (VB200..VB203)
// VB301 interno: .0 homing, .1 listo, .2 sec. 1, .3 en recogida, .4 recogiendo, .5 ciclo terminado, .6 cinta libre
LD     I0.5
AW=    VW320, +0
AW=    VW322, +0
=      V200.0                      // Bit 0 STAT_READY: en automatico y en reposo (sin referencia, la orden lanza el homing)
LDW>   VW320, +0
OW>    VW322, +0
=      V200.1                      // Bit 1 STAT_BUSY: secuencia 1, recogida u homing
LD     V301.5
=      V200.2                      // Bit 2 STAT_DONE: pieza dejada en la mesa
LD     SM0.0
R      V200.3, 3                   // Bits 3..5 sin uso en el brazo
LD     V301.6
=      V200.6                      // Bit 6 BELT_PERMIT_RUN: pieza levantada 5000 p en Y
LD     M0.3
=      V200.7                      // Bit 7 STAT_HOMED
LD     SM0.0
MOVB   VB321, VB201                // STAT_PASO: byte bajo de VW320
MOVB   IB0, VB202                  // STAT_INPUTS
MOVB   VB323, VB203                // STAT_DATA: fase del homing (byte bajo de VW322)

Network 7 // Eje X en automatico: corta el PTO 1 al tocar el limite de extension (I0.2) o el home (I0.1)
// Hace falta desde que se duplico la extension: si VD330 es mayor que el recorrido real, el brazo se
// detiene en el limite y la secuencia sigue desde ahi (M1.1 = aviso de limite).
LD     I0.2                        // Limite de extension...
AN     Q0.3                        // ...yendo hacia adelante
LD     I0.1                        // Home X...
A      Q0.3                        // ...yendo hacia atras
OLD
A      I0.5                        // Solo en automatico (en manual lo cuida el jog)
A      Q0.5                        // K1: PTO 1 conectado al eje X
AN     SM76.7                      // PTO 1 en marcha
MOVB   16#00, SMB77
PLS    1
S      M1.1, 1

Network 8 // Posicion actual
LD     SM0.0
MOVD   VD210, VD304
MOVD   VD220, VD308

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_HOMING (X -> Z -> Y -> garra)
// ==============================================================================
SUBROUTINE_BLOCK SBR_HOMING:SBR0
TITLE=Homing: X atras -> Z hasta el inductivo -> Y arriba -> abrir garra
// Orden cambiado el 12-10-2026 para que el brazo no arrastre los cables:
//   10/11 Eje X retrocede hasta su Home I0.1 (brazo recogido)
//   20/21 Eje Z gira en sentido horario hasta el inductivo I0.0
//   30/31 Eje Y sube hasta su Home I0.3
//   40    Apertura de garra (ya en posicion segura)
//   50    Fin: posiciones en 0, M0.3 = con referencia
BEGIN
Network 1 // Inicio del homing (M0.0 = falta homing)
LD     M0.0
AW=    VW322, +0
S      V301.0, 1                   // Estado: haciendo homing
R      V301.1, 1                   // No listo
MOVW   +10, VW322                   // Empieza por el eje X

Network 2 // Paso 10: eje X, pasar el PTO 1 al driver X (K1) y esperar 50 ms
LDW=   VW322, +10
R      Q0.6, 1                      // K2 apagado
S      Q0.5, 1                      // K1 encendido (driver X)
S      Q0.3, 1                      // DIR X = 1 (hacia el home I0.1, brazo recogido)
TON    T34, +5                      // 50 ms para que se asiente K1
LD     T34
MOVW   +11, VW322

Network 3 // Paso 11: eje X atras hasta I0.1
LDW=   VW322, +11
LPS
EU
MOVB   16#85, SMB77
MOVW   +250, SMW78                  // Frecuencia de homing
MOVD   +500000, SMD82
PLS    1
LPP
LDW=   VW322, +11
A      I0.1                         // Home X
LPS
MOVB   16#00, SMB77
PLS    1
LRD
R      Q0.5, 1                      // Soltar K1
LPP
MOVW   +20, VW322                   // Sigue el eje Z

Network 4 // Paso 20: eje Z en sentido horario hasta el inductivo I0.0 (PTO 0, sin reles)
LDW=   VW322, +20
LPS
EU
S      Q0.2, 1                      // DIR Z = 1 (horario, hacia el inductivo)
MOVB   16#85, SMB67
MOVW   +400, SMW68                  // 2,5 kHz
MOVD   +500000, SMD72
PLS    0
LPP
LDW=   VW322, +20
A      I0.0                         // Inductivo Z
LPS
MOVB   16#00, SMB67                 // Frenar Z
PLS    0
LPP
MOVW   +30, VW322                   // Sigue el eje Y

Network 5 // Paso 30: eje Y, pasar el PTO 1 al driver Y (K2) y esperar 50 ms
LDW=   VW322, +30
R      Q0.5, 1                      // K1 apagado
S      Q0.6, 1                      // K2 encendido (driver Y)
S      Q0.4, 1                      // DIR Y = 1 (hacia el home I0.3, arriba)
TON    T33, +5                      // 50 ms para que se asiente K2
LD     T33
MOVW   +31, VW322

Network 6 // Paso 31: eje Y arriba hasta I0.3
LDW=   VW322, +31
LPS
EU
MOVB   16#85, SMB77
MOVW   +250, SMW78
MOVD   +500000, SMD82
PLS    1
LPP
LDW=   VW322, +31
A      I0.3                         // Home Y
LPS
MOVB   16#00, SMB77
PLS    1
LRD
R      Q0.6, 1                      // Soltar K2
LPP
MOVW   +40, VW322

Network 7 // Paso 40: abrir la garra (400 ms)
LDW=   VW322, +40
R      Q0.7, 1
TON    T37, +4
LD     T37
MOVW   +50, VW322

Network 8 // Paso 50: homing terminado
LDW=   VW322, +50
MOVD   +0, VD210
MOVD   +0, VD220
MOVD   +0, VD304
MOVD   +0, VD308
R      M0.0, 1                      // Ya no falta homing
S      M0.3, 1                      // Con referencia
R      M0.4, 1                      // Permitir las secuencias
R      V301.0, 1
S      V301.1, 1                   // Listo
MOVW   +0, VW322

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 20: SBR_MANUAL (jog por ejes y garra)
// ==============================================================================
SUBROUTINE_BLOCK SBR_MANUAL:SBR20
TITLE=Manual con los pulsadores del tablero
BEGIN
Network 1 // Garra
// I0.7 abre o cierra la garra en cada pulsacion
LD     I0.7
EU
LPS
AN     Q0.7
S      M10.0, 1
LRD
A      Q0.7
R      Q0.7, 1
LPP
A      M10.0
S      Q0.7, 1
R      M10.0, 1

Network 2 // Z antihorario
// Eje Z antihorario (I1.0)
LD     I1.0
AN     I1.1
A      SM66.7
R      Q0.2, 1
MOVB   16#85, SMB67
MOVW   +250, SMW68                 // 4 kHz
MOVD   +100, SMD72
PLS    0

Network 3 // Z horario
// Eje Z horario (I1.1)
LD     I1.1
AN     I1.0
A      SM66.7
S      Q0.2, 1
MOVB   16#85, SMB67
MOVW   +250, SMW68                 // 4 kHz
MOVD   +100, SMD72
PLS    0

Network 4 // Parar Z al soltar
LDN    I1.0
AN     I1.1
LPS
EU
MOVB   16#00, SMB67
PLS    0
LPP

Network 5 // X sentido 1
// Eje X sentido 1 (I1.2), se detiene en I0.2
LD     I1.2
AN     I1.3
AN     I0.2                        // No avanza si toca el limite
AN     Q0.6
LPS
S      Q0.5, 1
R      Q0.3, 1                     // DIR X = 0 (alejandose del home)
TON    T35, +3                     // 30 ms para que se asiente K1
LPP
LD     T35
A      I1.2
AN     I0.2
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 6 // X sentido 2
// Eje X sentido 2 (I1.3), se detiene en I0.1 (home)
LD     I1.3
AN     I1.2
AN     I0.1                        // No avanza si toca el home
AN     Q0.6
LPS
S      Q0.5, 1
S      Q0.3, 1                     // DIR X = 1 (hacia el home)
TON    T36, +3                     // 30 ms para que se asiente K1
LPP
LD     T36
A      I1.3
AN     I0.1
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 7 // Y abajo
// Eje Y abajo (I1.4), se detiene en I0.4
LD     I1.4
AN     I1.5
AN     I0.4                        // No avanza si toca el tope inferior
AN     Q0.5
LPS
S      Q0.6, 1
R      Q0.4, 1                     // DIR Y = 0 (bajar)
TON    T97, +3                     // 30 ms para que se asiente K2
LPP
LD     T97
A      I1.4
AN     I0.4
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 8 // Y arriba
// Eje Y arriba (I1.5), se detiene en I0.3 (home)
LD     I1.5
AN     I1.4
AN     I0.3                        // No avanza si toca el home superior
AN     Q0.5
LPS
S      Q0.6, 1
S      Q0.4, 1                     // DIR Y = 1 (subir al home)
TON    T98, +3                     // 30 ms para que se asiente K2
LPP
LD     T98
A      I1.5
AN     I0.3
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 9 // Parar X/Y al soltar y soltar los reles
LDN    I1.2
AN     I1.3
AN     I1.4
AN     I1.5
LPS
EU
MOVB   16#00, SMB77
PLS    1
LPP
TON    T99, +3
LD     T99
R      Q0.5, 1
R      Q0.6, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 21: SBR_AUTO (secuencias 1, 2, 3 y retorno)
// ==============================================================================
SUBROUTINE_BLOCK SBR_AUTO:SBR21
TITLE=Ciclo automatico: recogida en la cinta y descarga en la mesa
BEGIN
Network 1 // Sin referencia
// Sin referencia (M0.3 = 0) o despues de un reset: borrar banderas
LDN    M0.3
R      V302.0, 1
R      V301.6, 1                  // Cinta libre = 0
MOVW   +0, VW320

// Sin referencia y con START: hacer homing
// Una orden de recogida del PLC 1 (M1.0) sin referencia tambien lanza el homing; al terminar
// siguen solas la secuencia 1 y la recogida (networks 2 y 12).
LD     M1.0
AN     M0.3
S      M0.0, 1
LD     I0.7
O      M1.0
AN     M0.3
O      M0.0
AN     M0.3
CALL   SBR0
CRET

// ============================================================================
// INICIO DE LA SECUENCIA 1: IR A LA ZONA DE RECOGIDA (SOLO CON REFERENCIA)
// ============================================================================
Network 2 // Inicio de la secuencia 1
// Arranca con START local (I0.7) o con una orden de recogida pendiente (M1.0). M1.0 no se
// borra aqui: al terminar la secuencia 1 (paso 40) el network 12 sigue con la recogida.
LD     I0.7
EU
O      M1.0                        // Orden de recogida del PLC 1
A      M0.3                        // Con referencia
AN     V302.0                     // Todavia no esta en la zona de recogida
AW=    VW320, +0                   // En reposo
S      V301.2, 1                  // Haciendo la secuencia 1
R      V301.1, 1                  // No listo
R      V301.5, 1                  // Borrar STAT_DONE del ciclo anterior
R      V301.6, 1                  // Cinta libre = 0
MOVW   +10, VW320                 // Empezar la secuencia 1

// ============================================================================
// SECUENCIA 1 - PASO 1: EJE Y 12000 PASOS (K2 = Q0.6, DIR Y = 0)
// ============================================================================
Network 3 // Sec. 1 paso 1: preparar el eje Y
LDW=   VW320, +10
S      Q0.6, 1                     // K2 encendido (Y)
R      Q0.5, 1                     // K1 apagado (X)
R      Q0.4, 1                     // DIR Y = 0
TON    T38, +2                     // 200 ms para que se asiente el rele
LD     T38
MOVW   +11, VW320

Network 4 // Sec. 1 paso 1: mover Y
LDW=   VW320, +11
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +12000, SMD82               // 12000 pasos
PLS    1
MOVW   +12, VW320

Network 5 // Sec. 1 paso 1: esperar fin de Y
LDW=   VW320, +12
TON    T39, +1                     // 100 ms para que arranquen los pulsos
LDW=   VW320, +12
A      T39
A      SM76.7                      // PTO 1 terminado
R      Q0.6, 1                     // K2 apagado
MOVW   +20, VW320

// ============================================================================
// SECUENCIA 1 - PASO 2: EJE Z ANTIHORARIO 17000 PASOS (DIR Z = 0)
// ============================================================================
Network 6 // Sec. 1 paso 2: girar Z
LDW=   VW320, +20
R      Q0.2, 1                     // DIR Z = 0 (antihorario)
MOVB   16#85, SMB67
MOVW   +250, SMW68                 // 4 kHz
MOVD   +17000, SMD72               // 17000 pasos antihorario
PLS    0
MOVW   +21, VW320

Network 7 // Sec. 1 paso 2: esperar fin de Z
LDW=   VW320, +21
TON    T37, +1
LDW=   VW320, +21
A      T37
A      SM66.7                      // PTO 0 terminado
MOVW   +30, VW320

// ============================================================================
// SECUENCIA 1 - PASO 3: EJE X ADELANTE VD330 PASOS (K1 = Q0.5, DIR X = 0)
// ============================================================================
Network 8 // Sec. 1 paso 3: preparar el eje X
LDW=   VW320, +30
S      Q0.5, 1                     // K1 encendido (X)
R      Q0.6, 1                     // K2 apagado (Y)
R      Q0.3, 1                     // DIR X = 0 (adelante)
TON    T40, +2                     // 200 ms para que se asiente el rele
LD     T40
MOVW   +31, VW320

Network 9 // Sec. 1 paso 3: extender X
LDW=   VW320, +31
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   VD330, SMD82                // Extension hasta la zona de recogida (VD330 = 20000)
PLS    1
MOVW   +32, VW320

Network 10 // Sec. 1 paso 3: esperar fin de X
LDW=   VW320, +32
TON    T41, +1
LDW=   VW320, +32
A      T41
A      SM76.7                      // PTO 1 terminado
R      Q0.5, 1                     // K1 apagado
MOVW   +40, VW320

// ============================================================================
// FIN DE LA SECUENCIA 1: EN LA ZONA DE RECOGIDA, ESPERA START U ORDEN
// ============================================================================
Network 11 // Fin de la secuencia 1
LDW=   VW320, +40
R      Q0.7, 1                     // Garra abierta
R      V301.2, 1
R      V301.6, 1                  // Esperando sobre la cinta
S      V301.3, 1                  // En la zona de recogida
S      V301.1, 1                  // Listo
S      V302.0, 1                  // Brazo en posicion
MOVW   +0, VW320                   // Reposo hasta el START

// ============================================================================
// RECOGIDA: ARRANCA CON START (I0.7) O CON LA ORDEN DEL PLC 1 CUANDO V302.0 = 1
// ============================================================================
Network 12 // Inicio de la recogida
LD     I0.7
EU
O      M1.0                        // Orden de recogida del PLC 1 (STAT_ROBOT_WAIT del PLC 5)
A      M0.3                        // Con referencia
A      V302.0                     // En la zona de recogida
AW=    VW320, +0                   // Secuencia en reposo
S      V301.4, 1                  // Recogiendo
R      V301.1, 1
R      V301.6, 1                  // Cinta libre = 0
R      M1.0, 1                     // Orden de recogida atendida
R      V301.5, 1                  // Borrar STAT_DONE del ciclo anterior
MOVW   +100, VW320                 // Empezar la secuencia 2

// ============================================================================
// SECUENCIA 2 - PASO 1: CERRAR LA GARRA
// ============================================================================
Network 13 // Sec. 2 paso 1: cerrar la garra
LDW=   VW320, +100
S      Q0.7, 1                     // Cerrar garra
TON    T42, +4                     // 400 ms para sujetar la pieza
LD     T42
MOVW   +110, VW320

// ============================================================================
// SECUENCIA 2 - PASO 2: EJE Y 5000 PASOS (K2 = Q0.6, DIR Y = 0)
// ============================================================================
Network 14 // Sec. 2 paso 2: preparar el eje Y
LDW=   VW320, +110
S      Q0.6, 1                     // K2 encendido (Y)
R      Q0.5, 1
R      Q0.4, 1                     // DIR Y = 0
TON    T43, +2
LD     T43
MOVW   +111, VW320

Network 15 // Sec. 2 paso 2: levantar la pieza
LDW=   VW320, +111
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +5000, SMD82                // 5000 pasos
PLS    1
MOVW   +112, VW320

Network 16 // Sec. 2 paso 2: pieza levantada
// PIEZA LEVANTADA: LA CINTA YA SE PUEDE MOVER (BELT_PERMIT_RUN = 1)
LDW=   VW320, +112
TON    T44, +1
LDW=   VW320, +112
A      T44
A      SM76.7                      // PTO 1 terminado
R      Q0.6, 1
S      V301.6, 1                  // Cinta libre: la pieza ya no toca la cinta
MOVW   +120, VW320                 // Sigue la secuencia 3

// ============================================================================
// SECUENCIA 3 - PASO 1: EJE X ATRAS VD334 PASOS (K1 = Q0.5, DIR X = 1)
// ============================================================================
Network 17 // Sec. 3 paso 1: preparar el eje X
LDW=   VW320, +120
S      Q0.5, 1                     // K1 encendido (X)
R      Q0.6, 1
S      Q0.3, 1                     // DIR X = 1 (atras)
TON    T45, +2
LD     T45
MOVW   +121, VW320

Network 18 // Sec. 3 paso 1: retraer X
LDW=   VW320, +121
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
