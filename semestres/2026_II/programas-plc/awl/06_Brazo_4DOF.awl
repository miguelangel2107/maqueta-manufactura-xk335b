ORGANIZATION_BLOCK MAIN:OB1
TITLE=UNIDAD 6: MANIPULADOR ROBOTICO 4-DOF - KINEMATICA FISICA VALIDADA Y PROTOCOLO PPI (NODO 6)
// ==============================================================================
// SISTEMA: CELDA DE MANUFACTURA FLEXIBLE XK-335B + BRAZO 4-DOF
// MODULO: UNIDAD 6 - MANIPULADOR ROBOTICO 4-DOF (MECANISMO PANTOGRAFO)
// CPU: SIEMENS SIMATIC S7-200 CPU 224CN (1 PUERTO RS-485 INTEGRADO)
// PUERTO 0: ESCLAVO EN BUS PPI (DIRECCION DE ESTACION 6, 19200 BPS)
// ==============================================================================
// GOBIERNO CINEMATICO Y REGLAS DE NEGOCIO VALIDADAS EN HARDWARE REAL:
//   1. Recogida al final de la cinta transportadora de Seleccion (cota de rampa)
//      de las piezas Tipo 4 (Metal + Plastico) y Tipo 5 (Plastico Negro Bypass).
//   2. Emision mandatoria de la bandera BELT_PERMIT_RUN (alias V301.6 -> V200.6 ICD):
//      Apenas la pinza sujeta la pieza y el eje vertical Y la despega de la cinta (5000 pulsos arriba),
//      se emite BELT_PERMIT_RUN = 1 para liberar inmediatamente la cinta de Seleccion.
//   3. Multiplexacion PTO 1 entre Eje X (Rele K1 Q0.5) y Eje Y (Rele K2 Q0.6) con retardo de estabilizacion.
//   4. Control de Eje Z de rotacion base mediante PTO 0 independiente (Q0.0 / DIR Q0.2).
//   5. Secuencia de Homing estricta: X (I0.1) -> Z (inductivo I0.0) -> Y (I0.3) -> Apertura Pinza (orden revisado: no arrastra cables).
//   6. Modo Manual completo con Jogging por pulsadores I1.0 a I1.5 y Toggle biestable de Pinza en I0.7.
// ==============================================================================
// INTEGRACION PPI CON LA CELDA (REV. AUDITADA) - LAS TRAYECTORIAS NO SE MODIFICAN:
//   a) PLC 5 detiene la pieza Tipo 4/5 en VW318 y publica STAT_ROBOT_WAIT (V200.6 del PLC 5).
//   b) PLC 1 envia CMD_START (V100.0 aqui) = orden de recogida -> M1.0.
//   c) Sec. 1 (si hace falta) + bucle: cierra pinza, eleva Y 5000 p -> BELT_PERMIT_RUN
//      (V301.6 -> V200.6). PLC 1 lo releva a V100.6 del PLC 5 y la cinta reanuda.
//   d) Descarga en la mesa exterior y retorno a zona de toma -> STAT_DONE (V200.2).
// MEMORIA REUBICADA: el paso Auto (antes VW100) y el de Homing (antes VW102) se
// solapaban con el buffer PPI VB100..VB103 escrito por el maestro: ahora VW320 / VW322.
// Alias internos VB1000..VD1008 (>= VB1000) movidos a VB300 / VB301 / VB302 / VD304 / VD308.
// ==============================================================================
BEGIN
Network 1 
// Inicializacion en el primer escaneo y configuracion de comunicaciones
LD     SM0.1
// Puerto 0: 19200 bps PPI esclavo nativo (Estacion 6 en Bloque de Sistema)
R      Q0.0, 8                     // Apagar salidas fisicas
R      M0.0, 32                    // Limpiar marcas auxiliares
MOVB   16#00, VB100                // Buffer comandos maestro PPI
MOVB   16#00, VB200                // Buffer estados hacia maestro PPI
MOVB   16#00, VB300               // Limpiar comandos maestro (alias)
MOVB   16#00, VB301               // Limpiar estados maestro (alias)
MOVD   +0, VD304                  // Reset cota Z
MOVD   +0, VD308                  // Reset cota X/Y
MOVW   +0, VW320                   // Secuencia Auto en reposo
MOVW   +0, VW322                   // Secuencia Homing en reposo
S      M0.0, 1                     // Exigir Home obligatorio al energizar
// Recorridos del Eje X (pulsos), ajustables en la Tabla de Estado:
//   VD330 = extension desde Home hasta la zona de toma en fin de cinta: 20000 (antes 14000)
//   VD334 = retraccion de la toma hacia la mesa y nueva extension al volver: 14000 (antes 8000).
//           La mesa queda en el mismo punto que antes (20000 - 14000 = 6000 = 14000 - 8000).
MOVD   +20000, VD330
MOVD   +14000, VD334

Network 2 
// Parada y Reset local (I0.6 flanco), STOP I1.0 o CMD_ESTOP remoto (V300.2 <- flanco V100.2)
LD     I0.6                        // Pulsador RESET local
EU                                 // Flanco ascendente
O      V300.2                     // CMD_ESTOP desde maestro PLC 1 (flanco de V100.2, Network 5)
O      I1.0                       // Pulsador STOP en Auto
A      I0.5                        // En modo Automatico
LPS
R      Q0.0, 8                     // Desconectar salidas inmediatamente
MOVB   16#00, SMB67                // Parar PTO 0 (Eje Z)
MOVB   16#00, SMB77                // Parar PTO 1 (Ejes X / Y)
PLS    0
PLS    1
LRD
MOVW   +0, VW320                   // Reiniciar secuenciador automatico
MOVW   +0, VW322                   // Reiniciar secuenciador homing
MOVB   16#00, VB301               // Limpiar estados
R      V300.2, 1
R      M1.0, 1                     // Descartar orden de recogida pendiente
S      M0.0, 1                    // Exigir nuevo Homing tras reset
R      M0.3, 1                     // Desreferenciar origen
LPP
R      M0.4, 1                     // Liberar ejecucion de secuencias

Network 3 
// Modo Manual (I0.5 = 0)
LDN    I0.5
LPS
EU
R      M0.3, 1                     // Requiere validar origen tras salir de manual
MOVB   16#00, VB301
R      M1.0, 1                     // Sin ordenes de red en Manual
LPP
CALL   SBR20                      // Subrutina Manual

Network 4 
// Modo Automatico (I0.5 = 1)
LD     I0.5
LPS
EU
S      M0.0, 1                     // Conmutar a Auto exige verificar origen
LPP
CALL   SBR21                       // Subrutina Automatica

Network 5 // Comandos PPI desde Maestro PLC 1 (VB100, entrega "envio unico" -> flanco EU)
// V100.0 CMD_START = ORDEN DE RECOGIDA en fin de cinta (PLC 5 reporto STAT_ROBOT_WAIT)
//   -> enclava M1.0. Si el brazo no esta en zona de toma ejecuta primero la Secuencia 1
//      y encadena el bucle de recogida al terminarla (SBR_AUTO Networks 2 y 12).
// V100.2 CMD_ESTOP = Seta QS de la celda -> aborto y re-homing (Network 2).
LD     V100.0
EU
A      I0.5                        // Solo en Automatico
S      M1.0, 1
LD     V100.2
EU
S      V300.2, 1

Network 6 // Estado hacia Maestro PLC 1 segun Contrato ICD Unificado (VB200..VB203)
// Alias internos VB301: .0 Homing, .1 Listo, .2 Sec.1, .3 En toma, .4 Bucle, .5 Fin ciclo, .6 Cinta libre
LD     I0.5
AW=    VW320, +0
AW=    VW322, +0
=      V200.0                      // Bit 0 STAT_READY: en Auto y en reposo (si no esta referenciado, la orden lanza el homing)
LDW>   VW320, +0
OW>    VW322, +0
=      V200.1                      // Bit 1 STAT_BUSY: Secuencia 1, bucle de recogida u homing
LD     V301.5
=      V200.2                      // Bit 2 STAT_DONE: pieza depositada en la mesa exterior
LD     SM0.0
R      V200.3, 3                   // Bits 3..5 sin uso en el Brazo
LD     V301.6
=      V200.6                      // Bit 6 BELT_PERMIT_RUN: pieza elevada 5000 p en Y
LD     M0.3
=      V200.7                      // Bit 7 STAT_HOMED
LD     SM0.0
MOVB   VB321, VB201                // STAT_PASO: byte bajo de VW320
MOVB   IB0, VB202                  // STAT_INPUTS
MOVB   VB323, VB203                // STAT_DATA: fase de homing (byte bajo de VW322)

Network 7 // Proteccion del Eje X en Automatico: corta PTO 1 al tocar el limite de extension (I0.2) o el Home (I0.1)
// Necesaria al duplicar la extension: si VD330 supera el recorrido fisico, el brazo se detiene en el
// limite y la secuencia continua desde ahi (M1.1 = aviso de limite alcanzado).
LD     I0.2                        // Limite de extension maxima...
AN     Q0.3                        // ...moviendo hacia adelante
LD     I0.1                        // Home X...
A      Q0.3                        // ...moviendo hacia atras
OLD
A      I0.5                        // Solo en Automatico (en Manual ya lo protege el jog)
A      Q0.5                        // Rele K1: PTO 1 conectado al Eje X
AN     SM76.7                      // PTO 1 en marcha
MOVB   16#00, SMB77
PLS    1
S      M1.1, 1

Network 8 // Monitoreo de Posicion
LD     SM0.0
MOVD   VD210, VD304
MOVD   VD220, VD308

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_HOMING (CALIBRACION CINEMATICA: Y -> X -> PINZA -> Z)
// ==============================================================================
SUBROUTINE_BLOCK SBR_HOMING:SBR0
TITLE=REFERENCIADO: X (RETRAER) -> Z (GIRO A INDUCTIVO) -> Y (SUBIR) -> APERTURA DE GARRA
// ORDEN REVISADO 2026-10-12 (evita que el brazo arrastre los cables):
//   10/11 Eje X retrocede hasta su Home I0.1 (brazo recogido)
//   20/21 Eje Z gira en sentido horario hasta el inductivo I0.0
//   30/31 Eje Y sube hasta su Home I0.3
//   40    Apertura de garra (ya en posicion segura)
//   50    Consolidacion: posiciones a 0, M0.3 = referenciado
BEGIN
Network 1 // Inicio del Homing (M0.0 = homing requerido)
LD     M0.0
AW=    VW322, +0
S      V301.0, 1                   // Estado: En Homing
R      V301.1, 1                   // No listo
MOVW   +10, VW322                   // Empezar por el Eje X (retraer)

Network 2 // Paso 10: Eje X - conmutar PTO 1 al driver X (K1) con 50 ms de estabilizacion
LDW=   VW322, +10
R      Q0.6, 1                      // K2 OFF
S      Q0.5, 1                      // K1 ON (Driver X)
S      Q0.3, 1                      // DIR X = 1 (hacia Home I0.1, brazo recogido)
TON    T34, +5                      // 50 ms estabilizacion K1
LD     T34
MOVW   +11, VW322

Network 3 // Paso 11: Eje X retrocede hasta I0.1
LDW=   VW322, +11
LPS
EU
MOVB   16#85, SMB77
MOVW   +250, SMW78                  // Frecuencia homing
MOVD   +500000, SMD82
PLS    1
LPP
LDW=   VW322, +11
A      I0.1                         // Home X detectado
LPS
MOVB   16#00, SMB77
PLS    1
LRD
R      Q0.5, 1                      // Liberar K1
LPP
MOVW   +20, VW322                   // Pasar al Eje Z

Network 4 // Paso 20: Eje Z gira en sentido horario hasta el inductivo I0.0 (PTO 0, sin reles)
LDW=   VW322, +20
LPS
EU
S      Q0.2, 1                      // DIR Z = 1 (horario hacia el inductivo)
MOVB   16#85, SMB67
MOVW   +400, SMW68                  // 2.5 kHz
MOVD   +500000, SMD72
PLS    0
LPP
LDW=   VW322, +20
A      I0.0                         // Inductivo Z detectado
LPS
MOVB   16#00, SMB67                 // Frenar Z de inmediato
PLS    0
LPP
MOVW   +30, VW322                   // Pasar al Eje Y

Network 5 // Paso 30: Eje Y - conmutar PTO 1 al driver Y (K2) con 50 ms de estabilizacion
LDW=   VW322, +30
R      Q0.5, 1                      // K1 OFF
S      Q0.6, 1                      // K2 ON (Driver Y)
S      Q0.4, 1                      // DIR Y = 1 (hacia Home I0.3, arriba)
TON    T33, +5                      // 50 ms estabilizacion K2
LD     T33
MOVW   +31, VW322

Network 6 // Paso 31: Eje Y sube hasta I0.3
LDW=   VW322, +31
LPS
EU
MOVB   16#85, SMB77
MOVW   +250, SMW78
MOVD   +500000, SMD82
PLS    1
LPP
LDW=   VW322, +31
A      I0.3                         // Home Y detectado
LPS
MOVB   16#00, SMB77
PLS    1
LRD
R      Q0.6, 1                      // Liberar K2
LPP
MOVW   +40, VW322

Network 7 // Paso 40: Apertura de garra en origen (400 ms)
LDW=   VW322, +40
R      Q0.7, 1
TON    T37, +4
LD     T37
MOVW   +50, VW322

Network 8 // Paso 50: Consolidacion de Home completado
LDW=   VW322, +50
MOVD   +0, VD210
MOVD   +0, VD220
MOVD   +0, VD304
MOVD   +0, VD308
R      M0.0, 1                      // Fin requerimiento de Home
S      M0.3, 1                      // Origen referenciado OK
R      M0.4, 1                      // Habilitar ejecucion de secuencias
R      V301.0, 1
S      V301.1, 1                   // Sistema Listo
MOVW   +0, VW322

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 20: SBR_MANUAL (JOGGING POR EJES Y TOGGLE BIESTABLE DE GARRA)
// ==============================================================================
SUBROUTINE_BLOCK SBR_MANUAL:SBR20
TITLE=CONTROL MANUAL POR PULSADORES DE TABLERO
BEGIN
Network 1 
// Garra I0.7: Biestable (Toggle limpio)
LD     I0.7
EU
LPS
AN     Q0.7
S      M10.0, 1
LRD
A      Q0.7
R      Q0.7, 1
LPP
A      M10.0
S      Q0.7, 1
R      M10.0, 1

Network 2 
// Eje Z Antihorario (I1.0)
LD     I1.0
AN     I1.1
A      SM66.7
R      Q0.2, 1
MOVB   16#85, SMB67
MOVW   +250, SMW68                 // 4 kHz
MOVD   +100, SMD72
PLS    0

Network 3 
// Eje Z Horario (I1.1)
LD     I1.1
AN     I1.0
A      SM66.7
S      Q0.2, 1
MOVB   16#85, SMB67
MOVW   +250, SMW68                 // 4 kHz
MOVD   +100, SMD72
PLS    0

Network 4 
LDN    I1.0
AN     I1.1
LPS
EU
MOVB   16#00, SMB67
PLS    0
LPP

Network 5 
// Eje X Sentido 1 (I1.2) - Protegido por sensor I0.2
LD     I1.2
AN     I1.3
AN     I0.2                        // Bloqueo si toca final de carrera contrario
AN     Q0.6
LPS
S      Q0.5, 1
R      Q0.3, 1                     // DIR X = 0 (Salida de Home)
TON    T35, +3                     // 30 ms estabilizacion K1
LPP
LD     T35
A      I1.2
AN     I0.2
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 6 
// Eje X Sentido 2 (I1.3) - Protegido por sensor I0.1 (Home)
LD     I1.3
AN     I1.2
AN     I0.1                        // Bloqueo si toca sensor Home
AN     Q0.6
LPS
S      Q0.5, 1
S      Q0.3, 1                     // DIR X = 1 (Hacia sensor Home)
TON    T36, +3                     // 30 ms estabilizacion K1
LPP
LD     T36
A      I1.3
AN     I0.1
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 7 
// Eje Y Sentido Abajo (I1.4) - Protegido por sensor I0.4
LD     I1.4
AN     I1.5
AN     I0.4                        // Bloqueo por tope inferior
AN     Q0.5
LPS
S      Q0.6, 1
R      Q0.4, 1                     // DIR Y = 0 (Bajar)
TON    T97, +3                     // 30 ms estabilizacion K2
LPP
LD     T97
A      I1.4
AN     I0.4
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 8 
// Eje Y Sentido Arriba (I1.5) - Protegido por sensor I0.3 (Home)
LD     I1.5
AN     I1.4
AN     I0.3                        // Bloqueo por sensor Home superior
AN     Q0.5
LPS
S      Q0.6, 1
S      Q0.4, 1                     // DIR Y = 1 (Subir a Home)
TON    T98, +3                     // 30 ms estabilizacion K2
LPP
LD     T98
A      I1.5
AN     I0.3
A      SM76.7
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +100, SMD82
PLS    1

Network 9 
LDN    I1.2
AN     I1.3
AN     I1.4
AN     I1.5
LPS
EU
MOVB   16#00, SMB77
PLS    1
LPP
TON    T99, +3
LD     T99
R      Q0.5, 1
R      Q0.6, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 21: SBR_AUTO (SECUENCIAS 1, 2, 3 Y RETORNO CONTINUO A RAMPA)
// ==============================================================================
SUBROUTINE_BLOCK SBR_AUTO:SBR21
TITLE=CICLO AUTOMATICO Y GOBIERNO DE TOMA/DESCARGA
BEGIN
Network 1 
// Si se pierde referencia (M0.3=0) o hay Reset, limpiar banderas
LDN    M0.3
R      V302.0, 1
R      V301.6, 1                  // Reset bandera cinta libre
MOVW   +0, VW320

// Si no esta referenciado y pulsan START, forzar Homing
// Una ORDEN DE RECOGIDA del PLC 1 (M1.0) sin referencia tambien lanza el homing; al terminar,
// la Secuencia 1 y el bucle se encadenan solos (Networks 2 y 12).
LD     M1.0
AN     M0.3
S      M0.0, 1
LD     I0.7
O      M1.0
AN     M0.3
O      M0.0
AN     M0.3
CALL   SBR0
CRET

// ============================================================================
// ARRANQUE SECUENCIA 1: POSICIONAMIENTO A ZONA DE RECOGIDA (SOLO TRAS HOMING)
// ============================================================================
Network 2 
// Disparo: START local (I0.7) u ORDEN DE RECOGIDA PPI pendiente (M1.0). M1.0 NO se
// consume aqui: al terminar la Secuencia 1 (Paso 40) el Network 12 encadena el bucle.
LD     I0.7
EU
O      M1.0                        // Orden de recogida del PLC 1
A      M0.3                        // Referenciado
AN     V302.0                     // No esta en posicion de bucle
AW=    VW320, +0                   // En reposo
S      V301.2, 1                  // STAT_BUSY_SEQ1
R      V301.1, 1                  // Reset Ready
R      V301.5, 1                  // Reset STAT_DONE del ciclo anterior
R      V301.6, 1                  // Reset al iniciar secuencia
MOVW   +10, VW320                 // Iniciar Secuencia 1

// ============================================================================
// SECUENCIA 1 - PASO 1: EJE Y SUBIR 12000 PASOS (K2=Q0.6, DIR Y=0)
// ============================================================================
Network 3 
LDW=   VW320, +10
S      Q0.6, 1                     // Activar K2 (Y)
R      Q0.5, 1                     // Desactivar K1 (X)
R      Q0.4, 1                     // DIR Y = 0 (SUBIR)
TON    T38, +2                     // 200 ms estabilizacion rele
LD     T38
MOVW   +11, VW320

Network 4 
LDW=   VW320, +11
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +12000, SMD82               // 12000 pasos arriba
PLS    1
MOVW   +12, VW320

Network 5 
LDW=   VW320, +12
TON    T39, +1                     // 100 ms arranque de pulsos
LDW=   VW320, +12
A      T39
A      SM76.7                      // PTO 1 finalizado
R      Q0.6, 1                     // Desactivar K2
MOVW   +20, VW320

// ============================================================================
// SECUENCIA 1 - PASO 2: EJE Z GIRAR ANTIHORARIO 17000 PASOS (DIR Z=0)
// ============================================================================
Network 6 
LDW=   VW320, +20
R      Q0.2, 1                     // DIR Z = 0 (Antihorario)
MOVB   16#85, SMB67
MOVW   +250, SMW68                 // 4 kHz
MOVD   +17000, SMD72               // 17000 pasos antihorario
PLS    0
MOVW   +21, VW320

Network 7 
LDW=   VW320, +21
TON    T37, +1
LDW=   VW320, +21
A      T37
A      SM66.7                      // PTO 0 finalizado
MOVW   +30, VW320

// ============================================================================
// SECUENCIA 1 - PASO 3: EJE X ADELANTE 14000 PASOS (K1=Q0.5, DIR X=0)
// ============================================================================
Network 8 
LDW=   VW320, +30
S      Q0.5, 1                     // Activar K1 (X)
R      Q0.6, 1                     // Desactivar K2 (Y)
R      Q0.3, 1                     // DIR X = 0 (Adelante)
TON    T40, +2                     // 200 ms estabilizacion rele
LD     T40
MOVW   +31, VW320

Network 9 
LDW=   VW320, +31
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   VD330, SMD82                // Extension X en zona de toma (VD330 = 20000)
PLS    1
MOVW   +32, VW320

Network 10 
LDW=   VW320, +32
TON    T41, +1
LDW=   VW320, +32
A      T41
A      SM76.7                      // PTO 1 finalizado
R      Q0.5, 1                     // Desactivar K1
MOVW   +40, VW320

// ============================================================================
// FIN SECUENCIA 1: EN ZONA DE TOMA -> ESPERA START PARA BUCLE
// ============================================================================
Network 11 
LDW=   VW320, +40
R      Q0.7, 1                     // Pinza abierta
R      V301.2, 1
R      V301.6, 1                  // Reset: en posicion de espera sobre cinta
S      V301.3, 1                  // Posicion de toma alcanzada
S      V301.1, 1                  // Listo
S      V302.0, 1                  // Bandera activa: Brazo posicionado
MOVW   +0, VW320                   // Reposo esperando START

// ============================================================================
// BUCLE CONTINUO: ARRANQUE POR START (I0.7) O PPI CUANDO V302.0 = 1
// ============================================================================
Network 12 
LD     I0.7
EU
O      M1.0                        // ORDEN DE RECOGIDA del PLC 1 (STAT_ROBOT_WAIT del PLC 5)
A      M0.3                        // Referenciado
A      V302.0                     // En posicion de toma
AW=    VW320, +0                   // Secuenciador en reposo
S      V301.4, 1                  // Bucle en ejecucion
R      V301.1, 1
R      V301.6, 1                  // Reset al iniciar ciclo de recogida
R      M1.0, 1                     // Consumir la orden de recogida
R      V301.5, 1                  // Reset STAT_DONE del ciclo anterior
MOVW   +100, VW320                 // Iniciar Secuencia 2

// ============================================================================
// SECUENCIA 2 - PASO 1: CERRAR PINZA (SUJECION)
// ============================================================================
Network 13 
LDW=   VW320, +100
S      Q0.7, 1                     // Cerrar pinza
TON    T42, +4                     // 400 ms tiempo de sujecion mecanica
LD     T42
MOVW   +110, VW320

// ============================================================================
// SECUENCIA 2 - PASO 2: EJE Y SUBIR 5000 PASOS (K2=Q0.6, DIR Y=0)
// ============================================================================
Network 14 
LDW=   VW320, +110
S      Q0.6, 1                     // Activar K2 (Y)
R      Q0.5, 1
R      Q0.4, 1                     // DIR Y = 0 (SUBIR)
TON    T43, +2
LD     T43
MOVW   +111, VW320

Network 15 
LDW=   VW320, +111
MOVB   16#85, SMB77
MOVW   +250, SMW78                 // 4 kHz
MOVD   +5000, SMD82                // 5000 pasos arriba
PLS    1
MOVW   +112, VW320

Network 16 
// PIEZA ELEVADA: LIBERACION DE LA CINTA TRANSPORTADORA (BELT_PERMIT_RUN = 1)
LDW=   VW320, +112
TON    T44, +1
LDW=   VW320, +112
A      T44
A      SM76.7                      // PTO 1 finalizado
R      Q0.6, 1
S      V301.6, 1                  // Bandera: Pieza elevada, cinta libre de colision
MOVW   +120, VW320                 // Enlaza directo a Secuencia 3

// ============================================================================
// SECUENCIA 3 - PASO 1: EJE X ATRAS 8000 PASOS (K1=Q0.5, DIR X=1)
// ============================================================================
Network 17 
LDW=   VW320, +120
