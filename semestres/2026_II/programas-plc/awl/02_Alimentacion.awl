ORGANIZATION_BLOCK MAIN:OB1
TITLE=UNIDAD 2: ALIMENTACION - ARQUITECTURA MODULAR CONGELADA XL-335B
// ==============================================================================
// SISTEMA: CELDA DE MANUFACTURA FLEXIBLE XL-335B
// MODULO: UNIDAD 2 - ESTACION DE ALIMENTACION Y DISCRIMINACION DE BASE
// CPU: SIEMENS SIMATIC S7-200 CPU 224CN (1 PUERTO RS-485 INTEGRADO)
// PUERTO 0: ESCLAVO EN BUS PPI (DIRECCION DE ESTACION 2, 19200 BPS)
// ==============================================================================
// ARQUITECTURA MODULAR DE SUBRUTINAS:
//   - OB1: Coordinador general y despacho condicional segun selector SA1 (I1.5)
//   - SBR0 (SBR_INIT): Reset de variables y buffers en primer ciclo (SM0.1)
//   - SBR1 (SBR_IO_SCAN): Captura de entradas, flancos EU de pulsadores y material
//   - SBR2 (SBR_SEGURIDAD): Logica QS fail-safe (I1.4), corte y rearme con SB1
//   - SBR3 (SBR_DIAGNOSTICO): Temporizadores T33..T36 para medicion Delta-t y atascos
//   - SBR4 (SBR_MAN_STEP): Secuenciador manual paso a paso por palabras (VW332)
//   - SBR5 (SBR_AUTO): Secuencia automatica por palabras (VW330) y triangulacion PPI
//   - SBR6 (SBR_ACTUADORES): Mapeo de electrovalvulas Q0.0, Q0.1 y balizas HL1, HL2, HL3
//   - SBR7 (SBR_COMMS_PPI): Empaquetado estandarizado de registros de red VB200..VB203
// REVISION AUDITADA: Paso Auto VW100 -> VW330 y Paso Manual VW102 -> VW332. Antes se
// solapaban con el buffer PPI VB100..VB103 escrito por el PLC 1 (NETW de 4 bytes).
// Comandos PPI capturados por flanco EU (sin borrado local de VB100).
// ==============================================================================
BEGIN

Network 1 // Modulo 0: Inicializacion General en Primer Scan (SM0.1)
LD     SM0.1
CALL   SBR_INIT

Network 2 // Modulo 1: Escaneo de Entradas Digitales y Flancos EU (Siempre Activo)
LD     SM0.0
CALL   SBR_IO_SCAN

Network 3 // Modulo 2: Supervision de Seguridad Fail-Safe y Rearme Local (Siempre Activo)
LD     SM0.0
CALL   SBR_SEGURIDAD

Network 4 // Modulo 3: Diagnostico de Presion, Tiempos Delta-t y Atascos (Siempre Activo)
LD     SM0.0
CALL   SBR_DIAGNOSTICO

Network 5 // Modulo 4: Secuenciador Manual Paso a Paso (Activo si SA1 = 0 / Manual)
LDN    M5.2                         // Selector SA1 en Manual / Diagnostico (I1.5 = 0)
CALL   SBR_MAN_STEP

Network 6 // Modulo 5: Secuenciador Automatico con Triangulacion PPI (Activo si SA1 = 1 / Auto)
LD     M5.2                         // Selector SA1 en Modo Automatico (I1.5 = 1)
CALL   SBR_AUTO

Network 7 // Modulo 6: Mapeo de Actuadores y Balizas HL1, HL2, HL3 (Siempre Activo)
LD     SM0.0
CALL   SBR_ACTUADORES

Network 8 // Modulo 7: Sincronizacion de Buffers de Red PPI Nodo 2 (Siempre Activo)
LD     SM0.0
CALL   SBR_COMMS_PPI

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_INIT (INICIALIZACION EN PRIMER SCAN)
// ==============================================================================
SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=INICIALIZACION GENERAL DE VARIABLES, REGISTROS Y BUFFERS
BEGIN

Network 1 // Inicializacion de Maquinas de Estados en Reposo (Paso 0)
LD     SM0.0
MOVW   +0, VW330                    // Maquina de Estados Auto: Paso 0 = Reposo
MOVW   +0, VW332                    // Maquina de Estados Manual: Paso 0 = Reposo
MOVB   0, VB100                     // Buffer Comandos Maestro PPI limpio
MOVB   0, VB101
MOVB   0, VB102
MOVB   0, VB103
MOVB   0, VB200                     // Buffer Telemetria Esclavo limpio
MOVB   0, VB201                     // STAT_PASO en 0
MOVB   0, VB202                     // STAT_INPUTS en 0
MOVB   0, VB203                     // STAT_DATA (Material base) en 0

Network 2 // Valores Nominales Calibrados de Tiempos Neumaticos Delta-t (ms)
LD     SM0.0
MOVW   +350, VW210                  // Delta-t nominal Extension Empujador (350 ms)
MOVW   +300, VW212                  // Delta-t nominal Retraccion Empujador (300 ms)
MOVW   +200, VW214                  // Delta-t nominal Extension Sujetador (200 ms)
MOVW   +200, VW216                  // Delta-t nominal Retraccion Sujetador (200 ms)

Network 3 // Limpieza de Banderas de Control, Alarmas y Enclavamientos
LD     SM0.0
R      M2.0, 8                      // M2.0 = SEGURIDAD_OK, M2.1 = ESPERA_REARME, M2.2 = EMERGENCIA_ACTIVA
R      M4.0, 8                      // M4.0 = ALM_FUGA, M4.1 = ALM_ATASCO
R      M5.0, 8                      // M5.0 = PULSO_SB1, M5.1 = PULSO_SB2, M5.2 = MODO_AUTO
R      M6.0, 8                      // M6.0 = MARCH_AUTO, M6.1 = PAUSA_AUTO, M6.5 = AUTORIZADO, M6.6 = RETIRADO
R      M11.0, 8                     // Flags de permisos paso a paso manual (M11.1..M11.4)
R      Q0.0, 8                      // Desenergizacion de salidas fisicas al arranque
R      Q1.0, 8

Network 4 // Configuracion Inicial de Seguridad Fail-Safe al Energizar
// Si la seta esta liberada (I1.4=1), exigir confirmacion fisica con SB1 (Espera de Rearme)
LD     I1.4
=      M2.1                         // M2.1 = Espera Rearme con SB1
LDN    I1.4
=      M2.2                         // M2.2 = Emergencia Activa fisica

Network 5 // Banderas de Estado PPI Iniciales
LD     SM0.0
S      V200.0, 1                    // STAT_READY = 1 (Listo en reposo)
S      V200.7, 1                    // STAT_HOMED = 1 (Origen referenciado)

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 1: SBR_IO_SCAN (CAPTURA DE ENTRADAS, FLANCOS EU Y DISCRIMINACION)
// ==============================================================================
SUBROUTINE_BLOCK SBR_IO_SCAN:SBR1
TITLE=CAPTURA DE ENTRADAS, FILTRADO DE FLANCOS EU Y DISCRIMINACION INDUCTIVA
BEGIN

Network 1 // Captura del Selector de Modo SA1 (I1.5)
LD     I1.5
=      M5.2                         // 1 = Modo Automatico, 0 = Modo Manual / Diagnostico

Network 2 // Evaluacion de Flanco Ascendente (EU) de Marcha / Avance SB1 (I1.3)
// Boton NA (Normalmente Abierto): reposo 0, presionado 1 -> Evaluacion estricta EU
LD     I1.3
EU
=      M5.0                         // M5.0 = Pulso de activacion de un ciclo de scan para SB1

Network 3 // Evaluacion de Flanco Ascendente (EU) de Parada / Reset SB2 (I1.2)
// Boton NA (Normalmente Abierto): reposo 0, presionado 1 -> Evaluacion estricta EU
LD     I1.2
EU
=      M5.1                         // M5.1 = Pulso de activacion de un ciclo de scan para SB2

Network 4 // Captura y Desacoplo de Comandos Entrantes PPI desde Maestro PLC 1
// El PLC 1 entrega cada bit en modo "envio unico" (1 durante un ciclo NETW y luego 0).
// Se enclava por flanco EU y NO se borra VB100 localmente: una reescritura del maestro
// nunca duplica una orden y el buffer ya no comparte memoria con las palabras de paso.
LD     V100.0
EU
S      M6.0, 1                      // CMD_START remoto

LD     V100.1
EU
S      M6.1, 1                      // CMD_PAUSE remoto

LD     V100.3
EU
S      M6.3, 1                      // CMD_ACK_RESET remoto

LD     V100.5
EU
S      M6.5, 1                      // CMD_AUTORIZAR_DOSIF remoto

LD     V100.6
EU
S      M6.6, 1                      // CMD_RETIRO_CONFIRMADO remoto

Network 5 // Discriminacion Inductiva de Material Base (Sensor I0.7)
// Pieza en base del silo (I0.6=1) inspeccionada por inductivo I0.7:
// VB203 = 1 si es Metalico, VB203 = 0 si es Plastico
LD     I0.6
A      I0.7
MOVB   1, VB203                     // Material Base: Metalico (1)
LD     I0.6
AN     I0.7
MOVB   0, VB203                     // Material Base: Plastico (0)

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 2: SBR_SEGURIDAD (LOGICA QS FAIL-SAFE Y REARME POR SB1)
// ==============================================================================
SUBROUTINE_BLOCK SBR_SEGURIDAD:SBR2
TITLE=LOGICA DE PARADA DE EMERGENCIA FAIL-SAFE QS (I1.4) Y REARME POR SB1
BEGIN

Network 1 // Deteccion de Parada de Emergencia Activa (I1.4 = 0)
// Seta de Parada de Emergencia NC fail-safe: 1 = Seguro, 0 = Emergencia activa
LDN    I1.4
LPS
S      M2.2, 1                      // M2.2 = Flag de Emergencia Activa
R      M2.0, 1                      // Cancelar bandera de Seguridad OK
R      M2.1, 1                      // Cancelar espera de rearme (emergencia fisica en curso)
MOVW   +0, VW330                    // Abortar ciclo Automatico a Reposo (Paso 0)
MOVW   +0, VW332                    // Abortar ciclo Manual a Reposo (Paso 0)
R      M6.0, 1                      // Reset comando de Marcha
R      M6.5, 1                      // Reset autorizacion remota
R      M11.0, 8                     // Reset permisos manuales
LPP
R      V200.2, 1                    // Reset STAT_DONE

Network 2 // Deteccion de Seta Desenclavada (I1.4 = 1) - Transicion a Espera de Rearme
// Cuando I1.4 retorna a 1 tras emergencia, NO arrancar: pasar a Espera de Rearme
LD     I1.4
A      M2.2                         // Venia de emergencia activa
R      M2.2, 1                      // Seta liberada fisicamente
S      M2.1, 1                      // Entrar en estado de Espera de Rearme
R      M2.0, 1                      // Mantener bloqueada la operacion

Network 3 // Rearme: SB1 local o ACK_RESET remoto (SB1 de Transporte / SCADA), solo en Espera de Rearme
// Requiere: Seta desenclavada (I1.4=1) y estado de Espera de Rearme (M2.1=1)
LD     M5.0                         // Operario pulsa fisicamente Marcha SB1
O      M6.3                         // O comando remoto ACK_RESET desde Maestro
A      M2.1
A      I1.4
S      M2.0, 1                      // M2.0 = SEGURIDAD_OK (Habilita operacion de la celda)
R      M2.1, 1                      // Fin de Espera de Rearme
R      M2.2, 1                      // Limpiar Emergencia Activa
R      M4.0, 2                      // Reset alarmas de Atasco (M4.1) y Fuga (M4.0)
R      M6.1, 1                      // Reset pausa
R      M6.3, 1                      // Consumir comando ACK_RESET
MOVW   +0, VW330                    // Confirmar Paso 0 Reposo
MOVW   +0, VW332

Network 4 // ACK_RESET remoto con la estacion ya rearmada: solo borra alarmas (los pasos NO se reinician)
// El PLC 1 lo envia con cada SB1 de Transporte en Automatico: no debe interrumpir un empuje.
LD     M6.3
A      M2.0
R      M4.0, 2
LD     M6.3
R      M6.3, 1                      // Consumir (tambien durante una emergencia)

Network 5 // Desbloqueo y Reset Manual con Pulsador SB2 (I1.2 -> M5.1)
// Permite al operador en cualquier momento reiniciar a Paso 0 y borrar alarmas de atasco
LD     M5.1
LPS
MOVW   +0, VW330                    // Reset a Paso 0
MOVW   +0, VW332                    // Reset a Paso 0
R      M4.0, 2                      // Borrar alarmas Atasco y Fuga
R      M11.0, 8                     // Reset permisos manuales
R      M6.0, 1
LPP
R      M6.5, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 3: SBR_DIAGNOSTICO (SUPERVISION NEUMATICA DELTA-T Y ATASCOS)
// ==============================================================================
SUBROUTINE_BLOCK SBR_DIAGNOSTICO:SBR3
TITLE=SUPERVISION NEUMATICA, MEDICION DELTA-T (T33..T36) Y ALARMAS DE ATASCO
BEGIN

Network 1 // Delta-t Extension Cilindro Empujador (T33 base 10ms) -> Destino VW210
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.2 antes de reset TON
LD     I0.2
EU
LDW=   VW330, +20
OW=    VW332, +20
ALD
MOVW   T33, VW210
*I     +10, VW210                   // Conversion de cuentas base 10ms a ms
AW>    VW210, +550                  // Umbral alerta preventiva de fuga (>550 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el movimiento y no alcance I0.2
LDW=   VW330, +20
OW=    VW332, +20
AN     I0.2
TON    T33, +32767

// 3. Deteccion de atasco critico: T33 > 120 (1.2 s) sin activar reed I0.2
LDW>   T33, +120
AN     I0.2
S      M4.1, 1                      // Alarma Atasco Critico Neumatico

Network 2 // Delta-t Retraccion Cilindro Empujador (T34 base 10ms) -> Destino VW212
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.3 antes de reset TON
LD     I0.3
EU
LDW=   VW330, +30
OW=    VW332, +30
ALD
MOVW   T34, VW212
*I     +10, VW212                   // Conversion a ms
AW>    VW212, +500                  // Umbral alerta preventiva de fuga (>500 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el movimiento y no alcance I0.3
LDW=   VW330, +30
OW=    VW332, +30
AN     I0.3
TON    T34, +32767

// 3. Deteccion de atasco critico: T34 > 120 (1.2 s) sin activar reed I0.3
LDW>   T34, +120
AN     I0.3
S      M4.1, 1

Network 3 // Delta-t Extension Cilindro Sujetador (T35 base 10ms) -> Destino VW214
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.0 antes de reset TON
LD     I0.0
EU
LDW=   VW330, +10
OW=    VW332, +10
ALD
MOVW   T35, VW214
*I     +10, VW214                   // Conversion a ms
AW>    VW214, +350                  // Umbral alerta preventiva de fuga (>350 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el movimiento y no alcance I0.0
LDW=   VW330, +10
OW=    VW332, +10
AN     I0.0
TON    T35, +32767

// 3. Deteccion de atasco critico: T35 > 100 (1.0 s) sin activar reed I0.0
LDW>   T35, +100
AN     I0.0
S      M4.1, 1

Network 4 // Delta-t Retraccion Cilindro Sujetador (T36 base 10ms) -> Destino VW216
// 1. Captura de tiempo real acumulado en flanco de llegada a reed I0.1 antes de reset TON
LD     I0.1
EU
LDW=   VW330, +40
OW=    VW332, +40
ALD
MOVW   T36, VW216
*I     +10, VW216                   // Conversion a ms
AW>    VW216, +350                  // Umbral alerta preventiva de fuga (>350 ms)
S      M4.0, 1

// 2. Temporizador activo mientras dure el movimiento y no alcance I0.1
LDW=   VW330, +40
OW=    VW332, +40
AN     I0.1
TON    T36, +32767

// 3. Deteccion de atasco critico: T36 > 100 (1.0 s) sin activar reed I0.1
LDW>   T36, +100
AN     I0.1
S      M4.1, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 4: SBR_MAN_STEP (MODO MANUAL PASO A PASO POR PALABRAS VW332)
// ==============================================================================
SUBROUTINE_BLOCK SBR_MAN_STEP:SBR4
TITLE=SECUENCIADOR MANUAL PASO A PASO POR PALABRAS (VW332) CON PULSADOR SB1
BEGIN

Network 1 // Transicion Paso 0 (Reposo) -> Paso 10 (Sujeta Columna)
// Requiere: VW332=0, Seguridad OK (M2.0=1), Sin Atasco (M4.1=0), Pulsacion SB1 (M5.0)
LDW=   VW332, +0
A      M2.0
AN     M4.1
A      M5.0                         // Operario presiona SB1 (I1.3)
MOVW   +10, VW332                   // Paso 10: Sujetador extiende (Q0.0=1)
R      M11.1, 1                     // Limpiar permiso de siguiente paso

Network 2 // Paso 10: Confirmacion de Carrera de Sujetador Extendido (I0.0)
LDW=   VW332, +10
A      I0.0                         // Reed sensor sujetador extendido confirmado
AN     M4.1
S      M11.1, 1                     // Habilita permiso para avanzar a Paso 20

Network 3 // Transicion Paso 10 -> Paso 20 (Empuja Pieza a Cuna)
// Requiere: Carrera confirmada (M11.1) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +10
A      M11.1
A      M5.0
AN     M4.1
MOVW   +20, VW332                   // Paso 20: Empujador extiende (Q0.1=1)
R      M11.1, 1
R      M11.2, 1

Network 4 // Paso 20: Confirmacion de Carrera de Empujador Extendido (I0.2)
LDW=   VW332, +20
A      I0.2                         // Reed sensor empujador extendido confirmado
O      I0.4                         // O presencia detectada en cuna de salida
AW=    VW332, +20
AN     M4.1
S      M11.2, 1                     // Habilita permiso para avanzar a Paso 30

Network 5 // Transicion Paso 20 -> Paso 30 (Retrae Empujador a Reposo)
// Requiere: Carrera confirmada (M11.2) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +20
A      M11.2
A      M5.0
AN     M4.1
MOVW   +30, VW332                   // Paso 30: Empujador retrae (Q0.1=0)
R      M11.2, 1
R      M11.3, 1

Network 6 // Paso 30: Confirmacion de Retraccion de Empujador (I0.3)
LDW=   VW332, +30
A      I0.3                         // Reed sensor empujador retraido confirmado
AN     M4.1
S      M11.3, 1                     // Habilita permiso para avanzar a Paso 40

Network 7 // Transicion Paso 30 -> Paso 40 (Retrae Sujetador / Caida Columna)
// Requiere: Carrera confirmada (M11.3) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +30
A      M11.3
A      M5.0
AN     M4.1
MOVW   +40, VW332                   // Paso 40: Sujetador retrae (Q0.0=0)
R      M11.3, 1
R      M11.4, 1

Network 8 // Paso 40: Confirmacion de Retraccion de Sujetador (I0.1)
LDW=   VW332, +40
A      I0.1                         // Reed sensor sujetador retraido confirmado
AN     M4.1
S      M11.4, 1                     // Habilita permiso para finalizar ciclo

Network 9 // Transicion Paso 40 -> Paso 0 (Fin de Ciclo Manual / Retorno a Reposo)
// Requiere: Carrera confirmada (M11.4) y NUEVA pulsacion fisica de SB1 (M5.0)
LDW=   VW332, +40
A      M11.4
A      M5.0
MOVW   +0, VW332                    // Retorno a Reposo (Paso 0)
R      M11.4, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 5: SBR_AUTO (MODO AUTOMATICO POR PALABRAS VW330 Y RED PPI)
// ==============================================================================
SUBROUTINE_BLOCK SBR_AUTO:SBR5
TITLE=SECUENCIADOR AUTOMATICO POR PALABRAS (VW330) Y TRIANGULACION PPI
BEGIN

Network 1 // Gestion de Comandos de Marcha y Pausa en Modo Automatico
// Marcha solicitada por comando PPI (flanco V100.0 -> M6.0) o por pulsador local SB1 (M5.0)
// MARCHA CONTINUA (autonoma): SB1 local, CMD_START o la primera CMD_AUTORIZAR_DOSIF del
// PLC 1 enclavan M6.0. Desde ahi la estacion repone sola una base cada vez que la cuna
// queda libre (I0.4 = 0). Se detiene con SB2, pausa remota o seta QS.
LD     M6.0
O      M5.0
O      M6.5
A      M2.0                         // Seguridad OK
S      M6.0, 1                      // Marcha continua activa
R      M6.1, 1                      // Reset Pausa

// Pausa solicitada por PPI (flanco V100.1 -> M6.1) o por pulsador local SB2 (M5.1)
LD     M6.1
O      M5.1
S      M6.1, 1                      // Pausa activa

Network 2 // Enclavamiento de Inicio de Dosificacion: Paso 0 -> Paso 10
// Inicia solo si:
// 1. En Reposo (VW330 = 0) y Seguridad OK (M2.0 = 1) y Sin Atasco (M4.1 = 0)
// 2. Autorizacion PPI (CMD_AUTORIZAR_DOSIF M6.5 o CMD_START M6.0) o Marcha local (M5.0)
// 3. Silo con existencias en la base (I0.6 = 1)
// 4. Cuna de salida libre (I0.4 = 0)
// 5. Cilindros en reposo fisico (I0.1 = 1 y I0.3 = 1)
// 6. Sin Pausa activa (M6.1 = 0)
LDW=   VW330, +0
A      M2.0
AN     M4.1
AN     M6.1
A      I0.6                         // Stock disponible en base de silo
AN     I0.4                         // Cuna libre de pieza
A      I0.1                         // Sujetador en reposo
A      I0.3                         // Empujador en reposo
LD     M6.5                         // Autorizacion PPI Transporte
O      M6.0                         // O Start general celda
O      M5.0                         // O Marcha local SB1
ALD
MOVW   +10, VW330                   // Iniciar Paso 10: Sujetar columna (Q0.0=1)
R      M6.5, 1                      // Consumir autorizacion

Network 3 // Pieza YA presente en la cuna con la estacion en reposo -> Paso 50 (pieza disponible, STAT_DONE)
// Evita el bloqueo mutuo: con la cuna ocupada la estacion no puede dosificar y, sin este
// paso, Transporte esperaria indefinidamente un STAT_DONE que nunca llegaria.
LDW=   VW330, +0
A      M2.0
AN     M4.1
A      I0.4                         // Pieza en la cuna de salida
A      I0.1                         // Sujetador en reposo
A      I0.3                         // Empujador en reposo
MOVW   +50, VW330
R      M6.5, 1                      // La autorizacion pendiente ya no hace falta

Network 4 // Paso 10 -> Paso 20: Sujecion Confirmada -> Empujar Pieza a Cuna
// Requiere: Sujetador extendido (I0.0 = 1)
LDW=   VW330, +10
A      I0.0                         // Confirmacion fisica reed I0.0
AN     M4.1
MOVW   +20, VW330                   // Iniciar Paso 20: Empujar pieza (Q0.1=1)

Network 5 // Paso 20 -> Paso 30: Empuje Confirmado -> Retraer Empujador
// Requiere: Empujador extendido (I0.2 = 1) y presencia de pieza en cuna (I0.4 = 1)
LDW=   VW330, +20
A      I0.2                         // Confirmacion fisica reed I0.2
A      I0.4                         // Pieza alcanzando cuna de salida
AN     M4.1
MOVW   +30, VW330                   // Iniciar Paso 30: Retraer empujador (Q0.1=0)

Network 6 // Paso 30 -> Paso 40: Retraccion Empujador Confirmada -> Retraer Sujetador
// Requiere: Empujador retraido en reposo (I0.3 = 1)
LDW=   VW330, +30
A      I0.3                         // Confirmacion fisica reed I0.3
AN     M4.1
MOVW   +40, VW330                   // Iniciar Paso 40: Retraer sujetador (Q0.0=0)

Network 7 // Paso 40: Temporizador de Estabilizacion de Caida por Gravedad (T37)
// Al retraer el sujetador, la columna desciende; T37 da 300 ms de asentamiento
LDW=   VW330, +40
A      I0.1                         // Reed sujetador retraido
TON    T37, +3                      // Base 100ms: 3 = 300 ms

Network 8 // Paso 40 -> Paso 50: Caida Estabilizada -> Espera Recogida por Transporte
LDW=   VW330, +40
A      I0.1                         // Sujetador en reposo
A      T37                          // Caida asentada en base
AN     M4.1
MOVW   +50, VW330                   // Iniciar Paso 50: Espera recogida por Transporte
S      V200.2, 1                    // Señalizar STAT_DONE (Pieza disponible en cuna)

Network 9 // Paso 50 -> Paso 0: Pieza Retirada por Transporte -> Retorno a Reposo
// Disparado por:
// 1. Confirmacion PPI de Transporte: CMD_RETIRO_CONFIRMADO (M6.6 = 1)
// 2. O sensor optico de cuna liberado fisicamente (I0.4 = 0)
// 3. O pulsador local SB1 (M5.0 = 1) en modo de prueba individual
LDW=   VW330, +50
LD     M6.6                         // Comando remoto Transporte
O      M5.0                         // O liberacion manual local con SB1
LDW=   VW330, +50
AN     I0.4                         // O cuna liberada fisicamente
OLD
ALD
MOVW   +0, VW330                    // Retorno a Reposo (Paso 0)
R      V200.2, 1                    // Reset STAT_DONE
R      M6.6, 1                      // Consumir comando

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 6: SBR_ACTUADORES (MAPEO DE ELECTROVALVULAS Y BALIZAS)
// ==============================================================================
SUBROUTINE_BLOCK SBR_ACTUADORES:SBR6
TITLE=MAPEO DE SALIDAS FISICAS: ELECTROVALVULAS Y BALIZAS HL1, HL2, HL3
BEGIN

Network 1 // Cilindro Superior Sujetador Q0.0 (Retiene Columna de Piezas)
// Activo en:
// - Modo Auto: Pasos 10, 20 y 30 (VW330 = 10, 20, 30)
// - Modo Manual: Pasos 10, 20 y 30 (VW332 = 10, 20, 30)
// Enclavamiento critico: SOLO si Seguridad OK (M2.0=1) y Sin Atasco (M4.1=0)
LDW=   VW330, +10
OW=    VW330, +20
OW=    VW330, +30
A      M5.2                         // En Modo Auto
LDW=   VW332, +10
OW=    VW332, +20
OW=    VW332, +30
AN     M5.2                         // En Modo Manual
OLD
A      M2.0                         // Enclavamiento de Seguridad
AN     M4.1                         // Sin atasco activo
=      Q0.0

Network 2 // Cilindro Inferior Empujador Q0.1 (Expulsa Pieza Base a Cuna)
// Activo en:
// - Modo Auto: Paso 20 (VW330 = 20)
// - Modo Manual: Paso 20 (VW332 = 20)
// Enclavamiento critico: SOLO si Seguridad OK (M2.0=1) y Sin Atasco (M4.1=0)
LDW=   VW330, +20
A      M5.2                         // En Modo Auto
LDW=   VW332, +20
AN     M5.2                         // En Modo Manual
OLD
A      M2.0                         // Enclavamiento de Seguridad
AN     M4.1                         // Sin atasco activo
=      Q0.1

Network 3 // Baliza Verde HL1 (Q1.0): Ciclo Activo en Ejecucion
// Se enciende cuando la estacion esta operando activamente:
// - Auto en ejecucion: VW330 > 0 y VW330 < 50
// - Manual en ejecucion: VW332 > 0
// Bloqueado en emergencia o atasco
LDW>   VW330, +0
AW<    VW330, +50
A      M5.2
LDW>   VW332, +0
AN     M5.2
OLD
A      M2.0
AN     M4.1
=      Q1.0

Network 4 // Baliza Amarilla HL2 (Q0.7): Modo Manual en Espera, Pausa o Alerta Preventiva
// 1. Modo Manual en Reposo: Titila a 1 Hz (SM0.5) indicando listo para SB1
LDN    M5.2
AW=    VW332, +0
A      SM0.5
// 2. Modo Manual esperando siguiente pulsacion SB1 (carrera confirmada): Titila a 2 Hz (SM0.4)
LDN    M5.2
A      M11.1
O      M11.2
O      M11.3
O      M11.4
AN     M5.2
A      SM0.4
OLD
// 3. Modo Auto en Pausa o en Espera de retirada Paso 50: Fija
LD     M5.2
A      M6.1
LD     M5.2
AW=    VW330, +50
OLD
OLD
// 4. Modo Auto con alerta preventiva de fuga/lentitud: Titila a 1 Hz
LD     M5.2
A      M4.0
A      SM0.5
OLD
// 5. Espera de Rearme de Seguridad tras liberacion de QS (M2.1=1): Titila a 2 Hz
LD     M2.1
A      SM0.4
OLD
// Enclavamiento: Apagada si hay emergencia fisica activa
AN     M2.2
=      Q0.7

Network 5 // Baliza Roja HL3 (Q1.1): Emergencia Activa, Atasco o Silo Vacio
// 1. Emergencia activa (I1.4 = 0 o M2.2 = 1): Fija
// 2. Atasco neumatico critico (M4.1 = 1): Fija
// 3. Silo vacio en Auto reposo (VW330 = 0 y I0.6 = 0): Fija
LDN    I1.4
O      M2.2
O      M4.1
LDW=   VW330, +0
A      M5.2
AN     I0.6
OLD
=      Q1.1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 7: SBR_COMMS_PPI (EMPAQUETADO ESTANDARIZADO DE TELEMETRIA PPI)
// ==============================================================================
SUBROUTINE_BLOCK SBR_COMMS_PPI:SBR7
TITLE=EMPAQUETADO ESTANDARIZADO DE TELEMETRIA PPI (VB200..VB203) HACIA MAESTRO
BEGIN

Network 1 // Empaquetado de Byte de Estado Global: VB200 (STAT_GLOBAL)
// Bit 0: STAT_READY (En reposo y listo para operar)
LDW=   VW330, +0
A      M5.2
A      M2.0
AN     M4.1
A      I0.6
AN     I0.4
LDW=   VW332, +0
AN     M5.2
A      M2.0
AN     M4.1
OLD
=      V200.0

// Bit 1: STAT_BUSY (Secuencia local en ejecucion)
LDW>   VW330, +0
AW<    VW330, +50
A      M5.2
LDW>   VW332, +0
AN     M5.2
OLD
=      V200.1

// Bit 2: STAT_DONE (Secuencia terminada con exito, pieza en cuna lista)
LDW=   VW330, +50
A      I0.4
A      M5.2
=      V200.2

// Bit 3: STAT_ALM_ATASCO (Alarma por tiempo de carrera excedido)
LD     M4.1
=      V200.3

// Bit 4: STAT_ALM_FUGA (Alerta predictiva de fuga o lentitud)
LD     M4.0
=      V200.4

// Bit 5: STAT_SILO_EMPTY (Alarma silo sin existencias en base I0.6=0)
LDW=   VW330, +0
A      M5.2
AN     I0.6
=      V200.5

// Bit 6: STAT_EMERGENCIA (seta QS I1.4 pulsada o emergencia aun no liberada) -> baliza de planta
LDN    I1.4
O      M2.2
=      V200.6

// Bit 7: STAT_HOMED (Origen fisico referenciado: ambos cilindros en reposo)
LD     I0.1                         // Sujetador retraido
A      I0.3                         // Empujador retraido
A      M2.0                         // Seguridad normal
=      V200.7

Network 2 // VB201 (STAT_PASO): Copia del Paso Activo para Telemetria SCADA
// En Auto copia VB331 (byte bajo de VW330 = VB331: 0, 10, 20, 30, 40, 50)
// En Manual copia VB333 (byte bajo de VW332 = VB333: 0, 10, 20, 30, 40)
LD     M5.2
MOVB   VB331, VB201
LDN    M5.2
MOVB   VB333, VB201

Network 3 // VB202 (STAT_INPUTS): Espejo Directo de Entradas Fisicas IB0
LD     SM0.0
MOVB   IB0, VB202

Network 4 // VB203 (STAT_DATA): Material Base Clasificado (1 = Metal, 0 = Plastico)
// El dato ya se mantiene actualizado en SBR_IO_SCAN segun sensor inductivo I0.7

Network 5 // VB204..VB207: datos extra para el SCADA (el PLC 1 lee 8 bytes)
// VB204 IB1 (SB2, SB1, seta, selector)   VB205 QB0 (electrovalvulas)   VB206 QB1 (focos)   VB207 reservado
LD     SM0.0
MOVB   IB1, VB204
MOVB   QB0, VB205
MOVB   QB1, VB206
MOVB   0, VB207

END_SUBROUTINE_BLOCK
