ORGANIZATION_BLOCK MAIN:OB1
TITLE=Unidad 1: Transporte, maestro de la planta (PLC 1)
// Planta XK-335B - Unidad 1: Transporte
// Carro con servomotor y manipulador. Coordina a las demas estaciones por la red PPI.
// CPU 226CN (2 puertos RS-485).
// Puerto 0: esclavo Modbus RTU para el SCADA (direccion 1, 19200 bps, 8-N-1).
// Puerto 1: maestro PPI (SMB130 = 2), 19200 bps, nodos 2 a 6.
// Selector del PLC: RUN = Modbus en el puerto 0 y maestro PPI en el puerto 1 (produccion)
//                   TERM = los dos puertos como esclavos PPI: la PC programa y mira con el PLC en RUN
// Cableado (comprobado en la planta):
//   Entradas: I0.0 inductivo home (NA)      I0.1 FC izquierdo (NA, 24 V = choque)
//             I0.2 FC derecho (NA, 24 V = choque)   I0.3 CilV abajo   I0.4 CilV arriba
//             I0.5 giro antihorario (Seleccion)  I0.6 giro horario (nidos)  I0.7 CilDV extendido
//             I1.0 CilDV retraido  I1.1 pinza cerrada  I1.2 servo RDY
//             I2.0..I2.2 fin de rampa 1..3   I2.4 SB2 (NA)  I2.5 SB1 (NA)
//             I2.6 QS (NC)  I2.7 SA1 (1 = auto)
//   Salidas:  Q0.0 pulsos PTO0  Q0.2 direccion (1 = derecha, hacia Seleccion)
//             Q0.3 CilV (1 = arriba, 0 = abajo)  Q0.4 giro antihorario  Q0.5 giro horario (= NOT Q0.4)
//             Q0.6 CilDV (1 = extender)  Q0.7 abrir pinza  Q1.0 cerrar pinza
//             Q1.5 HL2 amarilla  Q1.6 HL1 verde  Q1.7 HL3 roja  Q1.1 segunda HL3 roja
// Home y finales de carrera:
//   - I0.0 (inductivo) es la referencia de posicion: el homing (SBR_HOMING) toma
//     su flanco por interrupcion (evento 0) y pone VD250 = 0. La cota de
//     Alimentacion coincide con este sensor, por eso VD204 = 0.
//   - I0.1 / I0.2 son solo de seguridad y nunca se usan como referencia. Si se activan
//     con el PTO moviendose hacia ese lado, se cortan los pulsos, se pierde la
//     referencia (M13.3 = 0) y se activa M7.6.
// Cotas (DINT, pulsos; se pueden cambiar en marcha en la memoria V o desde el SCADA):
//   VD204 = 0       Alimentacion, sobre el inductivo I0.0
//   VD208 = 45500   Procesamiento
//   VD212 = 87500   Ensamblaje
//   VD216 = 107500  Seleccion
//   VD222 = 116000  limite maximo   VD226 = -1000 limite minimo
//   VD240 = 3000    retroceso del homing
//   Los valores por defecto solo se cargan si la firma VW220 <> 16#C07F, asi un
//   ajuste se mantiene mientras se conserve la memoria V (rango remanente).
// Memoria (proceso debajo de VB1000; libreria Modbus esclavo en VB4000..VB4799):
//   VW8 paso a retomar despues del homing   VW12/VB14 paso/etapa manual   VB15 fase del homing
//   VW16/VB18 paso/etapa automatico   VB19 tipo de maniobra   VB32 material de la base
//   VB33 tipo especial (5 = negra)    VB34 etapa de la maniobra   VB35 reintentos de homing
//   VD230 cota destino   VD234 distancia   VD250 posicion actual   VD260..VD272 copias para el SCADA
//   VW450 paso de la secuencia PPI   VB500..VB690 tablas NETR/NETW (cada 20 bytes)
//   VB702..VB706 ordenes pendientes para los nodos 2..6 (se envian una vez)   VB710 errores por nodo
//   VW1000.. registros Modbus del SCADA (HoldStart = &VB1000)
//   VD244 correccion del home   VD280 / V284.0 / V284.1 jog de ajuste   VD288 retroceso en el FC derecho
//   VW276 firma de parametros   M24.x retroceso en FC   M25.x / VB37 baliza de la planta (-> VB102 del PLC 3)
BEGIN

Network 1 // Valores iniciales (solo el primer ciclo)
LD     SM0.1
CALL   SBR_INIT

Network 2 // Entradas, pulsadores y mandos del SCADA
LD     SM0.0
CALL   SBR_IO_SCAN

Network 3 // Tiempos de los cilindros, atasco y fuga
LD     SM0.0
CALL   SBR_DIAGNOSTICO

Network 4 // Homing sobre I0.0 (lo piden el manual y el automatico con M7.0)
LD     SM0.0
CALL   SBR_HOMING

Network 5 // Modo manual paso a paso (I2.7 = 0)
LDN    M5.2
CALL   SBR_MAN_STEP

Network 6 // Modo automatico (I2.7 = 1)
LD     M5.2
CALL   SBR_SECUENCIA

Network 7 // Maniobras del manipulador en automatico (tomar / dejar / dejar en la cinta)
LD     SM0.0
CALL   SBR_MANIOBRA

Network 8 // Coordinacion PPI Seleccion <-> brazo (siempre, tambien con Transporte en manual)
LD     SM0.0
CALL   SBR_COORD_BRAZO

Network 9 // Electrovalvulas, focos y seguridad
LD     SM0.0
CALL   SBR_ACTUADORES

Network 10 // Secuencia PPI de maestro en el puerto 1 (siempre: datos y avisos)
LD     SM0.0
CALL   SBR_PPI_CARRUSEL

Network 11 // Modbus RTU esclavo en el puerto 0 para el SCADA
LD     SM0.0
CALL   SBR_MODBUS_SLAVE

Network 12 // Estado general para la baliza de la planta (PLC 3 Q0.6 / Q0.7 / Q1.0)
LD     SM0.0
CALL   SBR_BALIZA_PLANTA

END_ORGANIZATION_BLOCK

// ==============================================================================
// SUBRUTINA 0: SBR_INIT
// ==============================================================================
SUBROUTINE_BLOCK SBR_INIT:SBR0
TITLE=Cotas, tablas PPI, puerto 1 maestro, Modbus e interrupciones
BEGIN

Network 1 // Cotas por defecto, solo si la firma VW220 no es valida
// Asi se pueden ajustar en la memoria V sin recompilar (no se pisan en cada arranque).
LDW<>  VW220, 16#C07F                // Firma de la version 2026-10-12d (cotas -4500 en P, E y S)
MOVD   +0, VD204                    // Alimentacion = 0 pulsos (sobre el inductivo I0.0)
MOVD   +45500, VD208                // Procesamiento (en la planta: -4500)
MOVD   +87500, VD212                // Ensamblaje (en la planta: -4500)
MOVD   +107500, VD216               // Seleccion (en la planta: -4500)
MOVD   +116000, VD222               // Limite maximo (antes del FC derecho)
MOVD   -1000, VD226                 // Limite minimo (antes del FC izquierdo)
MOVD   +3000, VD240                 // Retroceso del homing para el acercamiento lento
MOVW   16#C07F, VW220               // Firma de cotas validas

Network 2 // Parametros de ajuste (firma propia VW276 = 16#C07B)
LDW<>  VW276, 16#C07B
MOVD   +0, VD244                    // Correccion del home: cota que se asigna al flanco de I0.0 (pulsos)
MOVD   +100, VD280                  // Pulsos por toque de jog (tabla de estado)
MOVD   +1500, VD288                 // Retroceso al tocar el FC derecho en Seleccion
MOVW   16#C07B, VW276

Network 3 // Copias de cotas (VD1110..VD1122) y parametros (VD1002..VD1010) para el SCADA
LD     SM0.0
MOVD   VD204, VD260
MOVD   VD208, VD264
MOVD   VD212, VD268
MOVD   VD216, VD272
MOVD   VD204, VD1110
MOVD   VD208, VD1114
MOVD   VD212, VD1118
MOVD   VD216, VD1122
MOVD   VD280, VD720                 // Parametros que se pueden cambiar desde el SCADA (40002..40007) y sus copias
MOVD   VD288, VD724
MOVD   VD240, VD728
MOVD   VD280, VD1002
MOVD   VD288, VD1006
MOVD   VD240, VD1010

Network 4 // Banderas y registros de control
LD     SM0.0
R      M4.0, 2                      // Fuga (M4.0) y atasco (M4.1)
R      M6.0, 3                      // Marcha (M6.0), pausa (M6.1), parar al final (M6.2)
R      M7.0, 8                      // Homing y alarmas de posicion
R      M8.0, 4                      // Maniobra
R      M10.0, 8                     // Diagnostico y alarma manual
R      M13.0, 6                     // Pausa, en movimiento, terminado, con referencia, fin de PTO, salida de tope
R      M14.0, 4                     // Mandos de cilindros
R      M20.0, 8                     // Intercambio con el brazo
R      M21.0, 8                     // Secuencia PPI
MOVW   +0, VW12                     // Paso manual = 0
MOVB   0, VB14
MOVB   0, VB15                      // Fase del homing = 0
MOVW   +0, VW16                     // Paso auto = 0
MOVB   0, VB18
MOVB   0, VB34
MOVB   0, VB33
MOVW   +10, VW8
MOVB   0, VB284                     // Jog V284.0 / V284.1 en reposo
R      M24.0, 8                     // Retroceso en el FC derecho
R      M25.0, 8                     // Baliza de la planta
MOVD   +0, VD250                    // Posicion desconocida hasta el homing (M13.3 = 0)
MOVD   +0, VD230
MOVW   +1, VW450                    // Secuencia PPI en el paso 1

Network 5 // Tiempos normales de los cilindros para el diagnostico (ms)
LD     SM0.0
MOVW   +400, VW40
MOVW   +350, VW42
MOVW   +350, VW44
MOVW   +300, VW46
MOVW   +400, VW48
MOVW   +250, VW50

Network 6 // Puerto 1: el modo maestro PPI (SMB130) lo maneja SBR_PPI_CARRUSEL segun el selector RUN/TERM
LD     SM0.0
R      M26.0, 8                     // SB1 guardado del manual

Network 7 // Tablas NETR (leen VB200 del remoto), 7 bytes de encabezado
LD     SM0.0
MOVB   0, VB500                     // Nodo 2 Alimentacion: estado
MOVB   2, VB501
MOVD   &VB200, VD502
MOVB   8, VB506                     // 8 bytes -> VB507..VB514 (estado, paso, IB0, dato, IB1, QB0, QB1, -)
MOVB   0, VB540                     // Nodo 3 Ensamblaje
MOVB   3, VB541
MOVD   &VB200, VD542
MOVB   8, VB546                     // -> VB547..VB554 (estado, paso, IB0, dato, IB1, QB0, paso de preparacion, diagnostico)
MOVB   0, VB580                     // Nodo 4 Procesamiento
MOVB   4, VB581
MOVD   &VB200, VD582
MOVB   8, VB586                     // -> VB587..VB594 (estado, paso, IB0, dato, IB1, QB0, QB1, -)
MOVB   0, VB620                     // Nodo 5 Seleccion (estado + datos del variador)
MOVB   5, VB621
MOVD   &VB200, VD622
MOVB   13, VB626                    // 13 bytes -> VB627..VB639 (VB639 = QB0 del PLC 5)
MOVB   0, VB660                     // Nodo 6 brazo
MOVB   6, VB661
MOVD   &VB200, VD662
MOVB   4, VB666                     // -> VB667..VB670

Network 8 // Tablas NETW (escriben VB100 del remoto)
// Todos los nodos reciben VB100..VB103 completo (los pasos de los esclavos
// ya estan en VW330/VW332). VB101..VB103 hacia los nodos 2, 3 y 4 = 0 (sin uso).
LD     SM0.0
MOVB   0, VB520                     // Nodo 2
MOVB   2, VB521
MOVD   &VB100, VD522
MOVB   4, VB526                     // VB527..VB530
MOVB   0, VB560                     // Nodo 3
MOVB   3, VB561
MOVD   &VB100, VD562
MOVB   4, VB566                     // VB567..VB570
MOVB   0, VB600                     // Nodo 4
MOVB   4, VB601
MOVD   &VB100, VD602
MOVB   4, VB606                     // VB607..VB610
MOVB   0, VB640                     // Nodo 5: control, tipo, modo del variador, sin uso
MOVB   5, VB641
MOVD   &VB100, VD642
MOVB   4, VB646                     // VB647..VB650
MOVB   0, VB680                     // Nodo 6
MOVB   6, VB681
MOVD   &VB100, VD682
MOVB   1, VB686                     // VB687

Network 9 // Datos y colas de ordenes en cero
LD     SM0.0
MOVD   +0, VD507
MOVD   +0, VD511                    // Nodo 2: IB1, QB0, QB1, libre
MOVD   +0, VD547
MOVD   +0, VD551                    // Nodo 3: IB1, QB0, paso de preparacion, diagnostico
MOVD   +0, VD587
MOVD   +0, VD591                    // Nodo 4: IB1, QB0, QB1, libre
MOVD   +0, VD627
MOVB   0, VB639                     // Nodo 5: QB0
MOVD   +0, VD667
MOVD   +0, VD527                    // Nodo 2: control + 3 bytes sin uso
MOVD   +0, VD567                    // Nodo 3
MOVD   +0, VD607                    // Nodo 4
MOVD   +0, VD647
MOVB   0, VB687
MOVB   0, VB702
MOVB   0, VB703
MOVB   0, VB704
MOVB   0, VB705
MOVB   0, VB706
MOVB   0, VB710

Network 10 // Modbus RTU esclavo en el puerto 0 (HoldStart = &VB1000, 128 registros)
// MBUS_INIT esta en SBR_MODBUS_SLAVE, con Mode = selector en RUN (SM0.7)
LD     SM0.0
MOVB   0, VB285

Network 11 // Interrupciones: evento 19 (fin de PTO0), evento 0 (flanco de I0.0), evento 10 (cada 10 ms)
LD     SM0.0
ATCH   INT_PTO_DONE, 19
ATCH   INT_HOME_I00, 0
MOVB   10, SMB34
ATCH   INT_TIMED_10MS, 10
ENI

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 1: SBR_IO_SCAN
// ==============================================================================
SUBROUTINE_BLOCK SBR_IO_SCAN:SBR1
TITLE=Sensores, pulsadores, selector y mandos del SCADA (por flanco)
BEGIN

Network 1 // Inductivo de home (referencia de posicion, no es final de carrera)
LD     I0.0
=      M3.3

Network 2 // Final de carrera izquierdo (NA: 24 V = choque), seguridad
LD     I0.1
=      M3.4

Network 3 // Final de carrera derecho (NA: 24 V = choque), seguridad
LD     I0.2
=      M3.5

Network 4 // Cilindros, actuador giratorio, pinza y servo
LD     I0.3
=      M2.3                         // CilV abajo
LD     I0.4
=      M2.4                         // CilV arriba
LD     I0.5
=      M2.5                         // Giro antihorario (Seleccion)
LD     I0.6
=      M2.6                         // Giro horario (nidos)
LD     I0.7
=      M2.7                         // CilDV extendido
LD     I1.0
=      M3.0                         // CilDV retraido
LD     I1.1
=      M3.1                         // Pinza cerrada
LD     I1.2
=      M3.2                         // Servo RDY

Network 5 // Sensores capacitivos de fin de rampa (I2.0..I2.2)
LD     I2.0
=      M9.2
LD     I2.1
=      M9.3
LD     I2.2
=      M9.4

Network 6 // Selector SA1 (I2.7): 1 = automatico, 0 = manual (se lee antes que los mandos)
LD     I2.7
=      M5.2

Network 7 // SB1 (I2.5) y SB2 (I2.4) por flanco, sus equivalentes del SCADA y seta QS (I2.6, NC)
// 40001 bit 4 = SB1 desde el SCADA y bit 5 = SB2 desde el SCADA: hacen lo mismo que los pulsadores.
LD     I2.5
EU
LD     V1001.4                      // SCADA: SB1
EU
OLD
=      M5.0
LD     I2.4
EU
LD     V1001.5                      // SCADA: SB2
EU
OLD
=      M5.1
LDN    I2.6
=      M10.6                        // 1 = seta accionada

Network 8 // Mandos del SCADA en 40001 (pulsos de 300 ms; bit n del registro = V1001.n; bit 8 = V1000.0)
LD     V1001.0
EU
=      M22.0                        // Bit 0: marcha
LD     V1001.1
EU
=      M22.1                        // Bit 1: pausa
LD     V1001.2
EU
=      M22.2                        // Bit 2: reset / rearme
LD     V1001.3
EU
=      M22.3                        // Bit 3: parar al final del ciclo
LD     V1001.6                      // Bit 6: jog a la derecha (manual)
EU
AN     M5.2
S      V284.0, 1
LD     V1001.7                      // Bit 7: jog a la izquierda (manual)
EU
AN     M5.2
S      V284.1, 1
LD     V1000.0                      // Bit 8: contadores de piezas a cero
EU
MOVW   +0, VW1182
MOVW   +0, VW1184
MOVW   +0, VW1186
MOVW   +0, VW1188
MOVW   +0, VW1190

Network 9 // Marcha en automatico (SB1 o SCADA); borra las alarmas que se pueden rearmar
LD     M5.0
O      M22.0
A      M5.2
A      I2.6
AN     I0.1
AN     I0.2
AN     M10.7
S      M6.0, 1
R      M6.1, 1
R      M4.0, 2                      // Fuga y atasco
R      M7.2, 1                      // Homing fallido (se vuelve a intentar)
R      M7.6, 1                      // Final de carrera / cota fuera de rango
R      M7.7, 1                      // Movimiento sin referencia
R      M8.2, 1                      // Tiempo de maniobra excedido
R      M20.3, 1                     // El brazo no respondio
S      M8.3, 1                      // Reiniciar la vigilancia de la etapa
S      V702.0, 1                    // CMD_START (una vez) a Alimentacion, Ensamblaje,
S      V703.0, 1                    // Procesamiento y Seleccion: con este SB1 arranca toda
S      V704.0, 1                    // la planta. Ensamblaje empieza a preparar nucleos y
S      V705.0, 1                    // Alimentacion repone bases sola.
S      V702.3, 1                    // CMD_ACK_RESET: rearma las estaciones que esperan rearme
S      V703.3, 1                    // (despues de encender o de una seta) y borra sus alarmas;
S      V704.3, 1                    // a una estacion ya rearmada no le cambia el paso.
S      V705.3, 1

Network 10 // Pausa en automatico (SB2 o SCADA): termina el movimiento en curso y espera
LD     M5.1
O      M22.1
A      M5.2
S      M6.1, 1

Network 11 // Parar al final del ciclo (SCADA bit 3)
LD     M22.3
S      M6.2, 1

Network 12 // Reset de alarmas desde el SCADA (bit 2) y ACK_RESET a las estaciones 2..5
LD     M22.2
R      M4.0, 2
R      M7.2, 1
R      M7.6, 1
R      M7.7, 1
R      M8.2, 1
R      M20.3, 1
S      V702.3, 1
S      V703.3, 1
S      V704.3, 1
S      V705.3, 1

Network 13 // Seta QS de la planta: CMD_ESTOP (una vez) a Seleccion y al brazo
LD     M10.6
EU
S      V705.2, 1
S      V706.2, 1

Network 14 // De automatico a manual: las dos secuencias en reposo
LD     M5.2
ED
MOVW   +0, VW12
MOVB   0, VB14
MOVW   +0, VW16
MOVB   0, VB18
MOVB   0, VB34
R      M6.0, 3
R      M8.0, 2
R      M13.0, 3
R      M10.0, 8

Network 15 // De manual a automatico: empieza en el paso 0 (homing si no hay referencia)
LD     M5.2
EU
MOVW   +0, VW12
MOVB   0, VB14
MOVW   +0, VW16
MOVB   0, VB18
R      M13.0, 3
R      M13.5, 1

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 2: SBR_DIAGNOSTICO
// ==============================================================================
SUBROUTINE_BLOCK SBR_DIAGNOSTICO:SBR2
TITLE=Tiempos de los cilindros y atascos en Transporte
BEGIN
Network 1 // CilV bajando (Q0.3 = 0, sensor I0.3): guardar el tiempo
LDN    Q0.3
A      M2.3
EU
MOVW   T33, VW20
*I     +10, VW20

Network 2 // CilV bajando: aviso de fuga
LDW>   VW20, +550
S      M4.0, 1

Network 3 // CilV bajando: contar tiempo
LDN    Q0.3
AN     M2.3
TON    T33, +32767

Network 4 // CilV bajando: atasco (1,5 s)
LDW>   T33, +150
AN     M2.3
S      M4.1, 1

Network 5 // CilV subiendo (Q0.3 = 1, sensor I0.4): guardar el tiempo
LD     Q0.3
A      M2.4
EU
MOVW   T34, VW22
*I     +10, VW22

Network 6 // CilV subiendo: aviso de fuga
LDW>   VW22, +500
S      M4.0, 1

Network 7 // CilV subiendo: contar tiempo
LD     Q0.3
AN     M2.4
TON    T34, +32767

Network 8 // CilV subiendo: atasco
LDW>   T34, +150
AN     M2.4
S      M4.1, 1

Network 9 // CilDV extendiendo (Q0.6 = 1, sensor I0.7): guardar el tiempo
LD     Q0.6
A      M2.7
EU
MOVW   T35, VW24
*I     +10, VW24

Network 10 // CilDV extendiendo: aviso de fuga
LDW>   VW24, +550
S      M4.0, 1

Network 11 // CilDV extendiendo: contar tiempo
LD     Q0.6
AN     M2.7
TON    T35, +32767

Network 12 // CilDV extendiendo: atasco
LDW>   T35, +150
AN     M2.7
S      M4.1, 1

Network 13 // CilDV retrayendo (Q0.6 = 0, sensor I1.0): guardar el tiempo
LDN    Q0.6
A      M3.0
EU
MOVW   T36, VW26
*I     +10, VW26

Network 14 // CilDV retrayendo: aviso de fuga
LDW>   VW26, +500
S      M4.0, 1

Network 15 // CilDV retrayendo: contar tiempo
LDN    Q0.6
AN     M3.0
TON    T36, +32767

Network 16 // CilDV retrayendo: atasco
LDW>   T36, +150
AN     M3.0
S      M4.1, 1

Network 17 // Giro horario (Q0.5 = 1, sensor I0.6): guardar el tiempo
LD     Q0.5
A      M2.6
EU
MOVW   T97, VW28
*I     +10, VW28

Network 18 // Giro horario: aviso de fuga
LDW>   VW28, +600
S      M4.0, 1

Network 19 // Giro horario: contar tiempo
LD     Q0.5
AN     M2.6
TON    T97, +32767

Network 20 // Giro horario: atasco
LDW>   T97, +150
AN     M2.6
S      M4.1, 1

Network 21 // Cierre de la pinza (Q1.0 = 1, sensor I1.1): guardar el tiempo
LD     Q1.0
A      M3.1
EU
MOVW   T98, VW30
*I     +10, VW30

Network 22 // Cierre de la pinza: aviso de fuga
LDW>   VW30, +450
S      M4.0, 1

Network 23 // Cierre de la pinza: contar tiempo
LD     Q1.0
AN     M3.1
TON    T98, +32767

Network 24 // Cierre de la pinza: atasco
LDW>   T98, +150
AN     M3.1
S      M4.1, 1
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 3: SBR_SECUENCIA (automatico, paso VW16 / etapa VB18)
// ==============================================================================
// Pasos: 0 reposo | 5 homing | 10 A: viaje + esperar pieza + tomar
//        20 E: viaje + dejar (CMD_PIEZA_ENTREGADA al PLC 3, CMD_AUTORIZAR_DOSIF al PLC 2)
//        22 E: esperar STAT_DONE del PLC 3, tomar; si es tipo 5 (VB550 = 5) -> paso 50
//        30 P: viaje + dejar (CMD_PIEZA_ENTREGADA al PLC 4)
//        32 P: esperar STAT_DONE del PLC 4 + tomar
//        50 S: viaje + esperar STAT_READY del PLC 5 + dejar en la cinta (tipo en VB648) -> paso 10
// Etapas: 0 lanzar viaje | 1 viajando | 2 esperar condicion y lanzar maniobra
//         3 maniobra en curso
// ==============================================================================
SUBROUTINE_BLOCK SBR_SECUENCIA:SBR3
TITLE=Secuencia automatica de Transporte
BEGIN

Network 1 // Seta QS: quitar marcha y etapas; si el PTO estaba en marcha se pierde la referencia
LD     M10.6
LPS
AN     SM66.7                       // PTO en marcha al momento de la seta
R      M13.3, 1
LRD
R      M6.0, 1
R      M8.0, 1
R      M23.0, 1
MOVB   0, VB18
MOVB   0, VB34
LPP
CRET

Network 2 // Alarmas que detienen el ciclo (se rearman con SB1 o Marcha del SCADA)
// Un viaje interrumpido se vuelve a lanzar desde la etapa 0 despues del rearme.
LD     M4.1
O      M7.2
O      M7.6
O      M7.7
O      M8.2
LPS
R      M23.0, 1
LRD
AB=    VB18, 1
MOVB   0, VB18
LPP
CRET

Network 3 // Se perdio la referencia con el ciclo en marcha: homing y seguir en el mismo paso
LD     M6.0
AN     M6.1
AN     M13.3
AW>=   VW16, +10
AB=    VB18, 0                      // Solo antes de lanzar un viaje (despues del retroceso en S se deja la pieza)
AN     M24.0
MOVW   VW16, VW8
MOVW   +5, VW16
MOVB   0, VB18

Network 4 // Paso 0 -> paso 5 (homing) o paso 10 (empezar el ciclo)
LDW=   VW16, +0
A      M6.0
AN     M6.1
LPS
AN     M13.3
MOVW   +10, VW8
MOVW   +5, VW16
MOVB   0, VB18
LPP
A      M13.3
MOVW   +10, VW16
MOVB   0, VB18

Network 5 // Paso 5 / etapa 0: pedir homing sobre I0.0
LDW=   VW16, +5
AB=    VB18, 0
S      M7.0, 1
R      M7.3, 1
MOVB   1, VB18

Network 6 // Paso 5 / etapa 1: homing terminado -> volver al paso VW8
LDW=   VW16, +5
AB=    VB18, 1
A      M7.3
LPS
R      M7.3, 1
MOVB   0, VB18
LPP
A      M13.3
MOVW   VW8, VW16

Network 7 // Vigilancia de viajes (T130, 20 s) y llegada por el evento 19 (M13.4)
LD     M23.0
TON    T130, +200
LD     T130
S      M4.1, 1                      // El viaje no termino: alarma
R      M23.0, 1
LD     M23.0
A      M13.4
AN     M24.0                        // No durante el retroceso en el FC derecho
R      M23.0, 1
R      M13.4, 1
MOVB   2, VB18                      // Etapa 2: en la cota

// ---------------------------- PASO 10: ALIMENTACION ----------------------------
Network 8 // Paso 10 / etapa 0: se pidio parar al final del ciclo -> reposo
LDW=   VW16, +10
AB=    VB18, 0
A      M6.2
MOVW   +0, VW16
R      M6.0, 1
R      M6.2, 1

Network 9 // Paso 10 / etapa 0: viaje a Alimentacion (VD204)
LDW=   VW16, +10
AB=    VB18, 0
AN     M6.1
LPS
MOVD   VD204, VD230
CALL   SBR_MOVE_PTO
S      M23.0, 1
MOVB   1, VB18
LPP
AN     V507.2                       // Sin pieza lista en la cuna
AN     V507.1                       // El PLC 2 no esta preparando otra
S      V702.5, 1                    // CMD_AUTORIZAR_DOSIF (una vez)

Network 10 // Paso 10 / etapa 2: pieza en la cuna -> tomar
// Hay pieza: STAT_DONE del PLC 2, o su sensor de cuna I0.4 (VB509 bit 4) con la
// estacion sin empujar y con comunicacion (sirve tambien con Alimentacion en manual).
LDW=   VW16, +10
AB=    VB18, 2
AN     M6.1
LD     V507.2
LD     V509.4                       // I0.4 del PLC 2: pieza en la cuna
AN     V507.1                       // El PLC 2 no esta empujando
AN     V710.2                       // Datos validos del nodo 2
OLD
ALD
MOVB   1, VB19                      // Maniobra: tomar
S      M8.0, 1
R      M8.1, 1
MOVB   3, VB18

Network 11 // Paso 10 / etapa 3: pieza tomada -> CMD_RETIRO_CONFIRMADO al PLC 2 -> paso 20
LDW=   VW16, +10
AB=    VB18, 3
A      M8.1
R      M8.1, 1
S      V702.6, 1
MOVB   VB510, VB32                  // Material de la base (1 = metal, 0 = plastico)
MOVB   0, VB33
MOVW   +20, VW16
MOVB   0, VB18

// ----------------------- PASO 20: ENSAMBLAJE (DEJAR) -----------------------------
Network 12 // Paso 20 / etapa 0: viaje a Ensamblaje (VD212), pasando de largo Procesamiento
LDW=   VW16, +20
AB=    VB18, 0
AN     M6.1
MOVD   VD212, VD230
CALL   SBR_MOVE_PTO
S      M23.0, 1
MOVB   1, VB18

Network 13 // Paso 20 / etapa 2: PLC 3 listo (nido libre) -> dejar en el nido
LDW=   VW16, +20
AB=    VB18, 2
AN     M6.1
A      V547.0
MOVB   2, VB19                      // Maniobra: dejar
S      M8.0, 1
R      M8.1, 1
MOVB   3, VB18

Network 14 // Paso 20 / etapa 3: pieza dejada -> CMD_PIEZA_ENTREGADA (PLC 3) + CMD_AUTORIZAR_DOSIF (PLC 2)
LDW=   VW16, +20
AB=    VB18, 3
A      M8.1
R      M8.1, 1
S      V703.4, 1
S      V702.5, 1
MOVW   +22, VW16
MOVB   0, VB18

// --------------------- PASO 22: ENSAMBLAJE (RECOGER) ----------------------------
Network 15 // Paso 22 / etapa 0: STAT_DONE del PLC 3 -> ver si es tipo 5 y tomar
LDW=   VW16, +22
AB=    VB18, 0
AN     M6.1
A      V547.2
LPS
AB=    VB550, 5                     // STAT_DATA del PLC 3 = 5: plastico negro
MOVB   5, VB33
LPP
MOVB   1, VB19
S      M8.0, 1
R      M8.1, 1
MOVB   3, VB18

Network 16 // Paso 22 / etapa 3: pieza tomada -> CMD_RETIRO_CONFIRMADO (PLC 3) y elegir camino
LDW=   VW16, +22
AB=    VB18, 3
A      M8.1
R      M8.1, 1
S      V703.6, 1
MOVB   0, VB18
LPS
AB=    VB33, 5
MOVW   +50, VW16                    // Tipo 5: directo a Seleccion
LPP
AB<>   VB33, 5
MOVW   +30, VW16                    // Tipos 1..4: volver a Procesamiento

// ------------------------- PASO 30: PROCESAMIENTO ------------------------------
Network 17 // Paso 30 / etapa 0: volver hacia atras hasta Procesamiento (VD208)
LDW=   VW16, +30
AB=    VB18, 0
AN     M6.1
MOVD   VD208, VD230
CALL   SBR_MOVE_PTO
S      M23.0, 1
MOVB   1, VB18

Network 18 // Paso 30 / etapa 2: PLC 4 listo -> dejar en la mordaza
LDW=   VW16, +30
AB=    VB18, 2
AN     M6.1
A      V587.0
MOVB   2, VB19
S      M8.0, 1
R      M8.1, 1
MOVB   3, VB18

Network 19 // Paso 30 / etapa 3: pieza dejada -> CMD_PIEZA_ENTREGADA al PLC 4 (empieza a prensar)
LDW=   VW16, +30
AB=    VB18, 3
A      M8.1
R      M8.1, 1
S      V704.4, 1
MOVW   +32, VW16
MOVB   0, VB18

Network 20 // Paso 32 / etapa 0: prensado terminado (STAT_DONE del PLC 4) -> tomar
LDW=   VW16, +32
AB=    VB18, 0
AN     M6.1
A      V587.2
MOVB   1, VB19
S      M8.0, 1
R      M8.1, 1
MOVB   3, VB18

Network 21 // Paso 32 / etapa 3: pieza tomada -> CMD_RETIRO_CONFIRMADO al PLC 4 -> paso 50
LDW=   VW16, +32
AB=    VB18, 3
A      M8.1
R      M8.1, 1
S      V704.6, 1
MOVW   +50, VW16
MOVB   0, VB18

// --------------------------- PASO 50: SELECCION --------------------------------
Network 22 // Paso 50 / etapa 0: viaje a Seleccion (VD216)
LDW=   VW16, +50
AB=    VB18, 0
AN     M6.1
MOVD   VD216, VD230
CALL   SBR_MOVE_PTO
S      M23.0, 1
MOVB   1, VB18

Network 23 // Paso 50 / etapa 2: cinta lista (STAT_READY del PLC 5) -> tipo en VB648 y dejar en la cinta
LDW=   VW16, +50
AB=    VB18, 2
AN     M6.1
A      V627.0
MOVB   VB33, VB648                  // 5 = pieza negra (va al fin de cinta), 0 = clasificar
MOVB   3, VB19                      // Maniobra: dejar en la cinta (giro antihorario)
S      M8.0, 1
R      M8.1, 1
MOVB   3, VB18

Network 24 // Paso 50 / etapa 3: pieza dejada -> CMD_PIEZA_ENTREGADA al PLC 5 -> paso 10 (vuelve a A)
LDW=   VW16, +50
AB=    VB18, 3
A      M8.1
R      M8.1, 1
S      V705.4, 1
MOVW   +10, VW16
MOVB   0, VB18

END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 4: SBR_ACTUADORES
// ==============================================================================
SUBROUTINE_BLOCK SBR_ACTUADORES:SBR4
TITLE=Electrovalvulas, focos y seguridad
BEGIN
Network 1 // Cilindro vertical Q0.3: 1 = arriba, 0 = abajo (M14.0 = orden de bajar, manual y auto)
LD     M14.0
NOT
=      Q0.3

Network 2 // Cilindro de doble vastago Q0.6: 1 = extender hacia la estacion
LD     M14.1
=      Q0.6

Network 3 // Pinza: Q1.0 cierra / Q0.7 abre
LD     M14.2
=      Q1.0
NOT
=      Q0.7

Network 4 // Actuador giratorio: Q0.4 antihorario (Seleccion) / Q0.5 horario (nidos)
LD     M14.3
=      Q0.4
NOT
=      Q0.5

Network 5 // Foco rojo HL3 (Q1.7 y Q1.1)
LDN    I2.6
O      I0.1
O      I0.2
O      M10.7
O      M4.1
O      M7.2                         // Homing fallido
O      M7.6                         // Final de carrera / cota fuera de rango
O      M7.7                         // Movimiento sin referencia
O      M8.2                         // Tiempo de maniobra excedido
O      M20.3                        // El brazo no responde
=      Q1.7
=      Q1.1

Network 6 // Foco verde HL1 (Q1.6): ciclo en marcha
LD     M5.2
A      M6.0
AN     M6.1
AW>    VW16, +0
LDN    M27.0                        // Fijo mientras se mueve...
O      SM0.5                        // ...parpadea si espera a otra estacion
ALD
LDN    M5.2
AW>    VW12, +0
AN     M13.0
AN     M13.2
AN     M10.7
OLD
A      I2.6
AN     M4.1
LDN    I0.1
AN     I0.2
O      M13.5
ALD
=      Q1.6

Network 7 // Foco amarillo HL2 (Q1.5): espera o pausa (nunca junto con el verde)
LDN    M5.2
AW=    VW12, +0
LDN    M5.2
A      M13.0
OLD
LDN    M5.2
A      M13.2
OLD
LD     M5.2
A      M6.1
OLD
LD     M5.2
A      M4.0
OLD
LD     M5.2
AW=    VW16, +0
OLD
A      SM0.5
AN     Q1.6
A      I2.6
AN     I0.1
AN     I0.2
AN     M10.7
AN     M4.1
=      Q1.5

Network 8 // Seta QS o alarma: frenar el PTO y llevar los cilindros a posicion segura
LDN    I2.6
O      M10.7
O      M4.1
LPS
AN     SM66.7                       // Corte con el PTO en marcha: se pierde la referencia
R      M13.3, 1
LPP
MOVB   16#00, SMB67
PLS    0
R      M14.0, 1                    // Vertical arriba
R      M14.1, 1                     // Doble vastago retraido
R      M24.0, 1                     // Cancelar el retroceso en curso
R      M24.2, 1
S      Q0.3, 1
R      Q0.6, 1

Network 9 // FC izquierdo (I0.1) yendo a la izquierda (Q0.2 = 0)
LD     I0.1
AN     Q0.2
LPS
AN     SM66.7                       // El PTO estaba en marcha: se pierde la posicion
R      M13.3, 1
S      M7.6, 1
LPP
MOVB   16#00, SMB67
PLS    0

Network 10 // FC derecho (I0.2) yendo a la derecha: si el viaje era a Seleccion -> retroceso; si no -> alarma
LD     I0.2
A      Q0.2
AN     SM66.7                       // El PTO estaba en marcha
AN     M24.0
LPS
R      M13.3, 1                     // Posicion desconocida: se vuelve a hacer homing en el regreso
LRD
LDD=   VD230, VD216                 // Destino = cota de Seleccion
ALD
S      M24.0, 1                     // Retroceso previsto (sin alarma)
LPP
LDD<>  VD230, VD216
ALD
S      M7.6, 1                      // Choque inesperado: alarma

Network 11 // FC derecho: cortar de inmediato los pulsos hacia la derecha
LD     I0.2
A      Q0.2
MOVB   16#00, SMB67
PLS    0

Network 12 // Retroceso: con el PTO parado, volver VD288 pulsos a la izquierda a 2 kHz
LD     M24.0
AN     M24.2
A      SM66.7
RI     Q0.2, 1                      // Direccion izquierda de inmediato
R      M13.4, 1
MOVB   16#85, SMB67
MOVW   +500, SMW68                  // 2 kHz
MOVD   VD288, SMD72
PLS    0
S      M24.2, 1                     // Retroceso lanzado

Network 13 // Fin del retroceso: FC libre -> llego a Seleccion (M13.4 = 1); FC todavia activo -> alarma
LD     M24.2
A      M13.4
LPS
AN     I0.2
S      M24.3, 1                     // Aviso: Seleccion alcanzada con retroceso
LRD
A      I0.2
S      M7.6, 1
LPP
R      M24.0, 1
R      M24.2, 1
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 5: SBR_MOVE_PTO (mover el carro a una cota con el PTO 0)
// ==============================================================================
// Entrada: VD230 = cota destino. Salida: M13.4 = 1 al terminar (evento 19).
// No mueve el carro (no envia pulsos) si no hay referencia (M7.7), si la cota esta
// fuera de [VD226, VD222] o si va hacia un final de carrera ya activado (M7.6).
// ==============================================================================
SUBROUTINE_BLOCK SBR_MOVE_PTO:SBR5
TITLE=Mover el carro a una cota con el PTO 0 a 8 kHz, con limites
BEGIN
Network 1 // Sin referencia: no mover
LDN    M13.3
S      M7.7, 1
CRET

Network 2 // Cota fuera de los limites: no mover
LDD<   VD230, VD226
OD>    VD230, VD222
S      M7.6, 1
CRET

Network 3 // Distancia = destino - posicion actual
LD     SM0.0
MOVD   VD230, VD234
-D     VD250, VD234

Network 4 // Ya esta en la cota: terminar
LDD=   VD234, +0
S      M13.4, 1
CRET

Network 5 // Hacia la derecha: direccion = 1 de inmediato (antes de los pulsos)
LDD>   VD234, +0
SI     Q0.2, 1
MOVD   VD234, SMD72

Network 6 // Hacia la izquierda: direccion = 0 de inmediato, pulsos = |distancia|
LDD<   VD234, +0
RI     Q0.2, 1
MOVD   +0, SMD72
-D     VD234, SMD72

Network 7 // No mover hacia un final de carrera ya activado
LD     I0.1
AN     Q0.2
LD     I0.2
A      Q0.2
OLD
S      M7.6, 1
CRET

Network 8 // Lanzar los pulsos del PTO 0 (Q0.0) a 8 kHz
LD     SM0.0
R      M13.4, 1
R      M24.3, 1                     // Aviso "S alcanzada con retroceso"
MOVB   16#85, SMB67
MOVW   +125, SMW68                  // 125 us = 8 kHz
PLS    0
MOVD   VD230, VD250                 // Posicion de destino (si el viaje se corta, M13.3 se pone en 0)
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 6: SBR_PPI_CARRUSEL (maestro PPI en el puerto 1, 10 transacciones)
// ==============================================================================
// Byte de estado de la tabla: bit 7 D (terminada), bit 6 A (en curso), bit 5 E (error),
// bits 3..0 codigo (1 sin respuesta, 2 recepcion, 3 fuera de linea, 4 cola, 5 sin modo maestro...).
// Cada paso se lanza una vez (M21.0) y termina con D, E o T38 (1 s).
// Ordenes: lo pendiente en VB70n se copia a los datos al lanzar el NETW;
// si falla, se vuelve a poner en la cola. Asi un esclavo no recibe dos veces la misma orden.
// ==============================================================================
SUBROUTINE_BLOCK SBR_PPI_CARRUSEL:SBR6
TITLE=Lecturas y escrituras NETR / NETW en orden por el puerto 1
BEGIN
Network 1 // Selector en RUN (SM0.7 = 1): puerto 1 = maestro PPI y secuencia activa
// Selector en TERM (SM0.7 = 0): puerto 1 = esclavo PPI, sin NETR/NETW. El programa sigue en RUN
// (ponerlo en RUN desde Micro/WIN) y la PC es el unico maestro del bus: puede
// programar, ver la tabla de estado del PLC 1 y acceder a los PLC 2..6.
LD     SM0.7
EU
LD     SM0.1
A      SM0.7
OLD
MOVB   2, SMB130                    // Maestro PPI
MOVW   +1, VW450
R      M21.0, 1
LD     SM0.7
ED
LD     SM0.1
AN     SM0.7
OLD
MOVB   0, SMB130                    // Esclavo PPI (para programar)

Network 2 // Selector en TERM: estaciones sin red (las esperas del manual no se traban)
LDN    SM0.7
MOVB   16#7C, VB710                 // Nodos 2..6 sin comunicacion
MOVB   0, VB507                     // Borrar los estados recibidos
MOVB   0, VB547
MOVB   0, VB587
MOVB   0, VB627
MOVB   0, VB667
R      M21.0, 1
CRET

Network 3 // Tiempo maximo por transaccion (T38, 1 s)
LD     M21.0
TON    T38, +10

Network 4 // Paso fuera de rango -> paso 1
LDW<   VW450, +1
OW>    VW450, +10
MOVW   +1, VW450
R      M21.0, 1

Network 5 // Para el PLC 5: modo del variador (VW1016) y sentido de la cinta (VW1014) pedidos desde el SCADA
LD     SM0.0
MOVB   VB1017, VB649                // VB102 del PLC 5: 0 = sin cambio, 1 = analogico, 2 = Modbus
MOVB   VB1015, VB650                // VB103 del PLC 5: sentido pedido desde el SCADA (40008): 0 = sin cambio, 1 = adelante, 2 = atras

// ------------------------------ LANZAR ---------------------------------------
Network 6 // Paso 1: NETR nodo 2 (Alimentacion)
LDW=   VW450, +1
AN     M21.0
NETR   VB500, 1
S      M21.0, 1

Network 7 // Paso 2: NETW nodo 2 (CMD_AUTORIZAR_DOSIF / CMD_RETIRO_CONFIRMADO)
LDW=   VW450, +2
AN     M21.0
MOVB   VB702, VB527
MOVB   0, VB702
NETW   VB520, 1
S      M21.0, 1

Network 8 // Paso 3: NETR nodo 3 (Ensamblaje)
LDW=   VW450, +3
AN     M21.0
NETR   VB540, 1
S      M21.0, 1

Network 9 // Paso 4: NETW nodo 3 (CMD_PIEZA_ENTREGADA / CMD_RETIRO_CONFIRMADO)
LDW=   VW450, +4
AN     M21.0
MOVB   VB703, VB567
MOVB   0, VB703
INCB   VB570                        // Contador de vida (VB103 del PLC 3, lo usa la baliza)
NETW   VB560, 1
S      M21.0, 1

Network 10 // Paso 5: NETR nodo 4 (Procesamiento)
LDW=   VW450, +5
AN     M21.0
NETR   VB580, 1
S      M21.0, 1

Network 11 // Paso 6: NETW nodo 4 (empezar prensado / CMD_RETIRO_CONFIRMADO)
LDW=   VW450, +6
AN     M21.0
MOVB   VB704, VB607
MOVB   0, VB704
NETW   VB600, 1
S      M21.0, 1

Network 12 // Paso 7: NETR nodo 5 (Seleccion: estado, STAT_ROBOT_WAIT y datos del variador)
LDW=   VW450, +7
AN     M21.0
NETR   VB620, 1
S      M21.0, 1

Network 13 // Paso 8: NETW nodo 5 (pieza entregada, BELT_PERMIT_RUN, tipo, modo del variador)
LDW=   VW450, +8
AN     M21.0
MOVB   VB705, VB647
MOVB   0, VB705
NETW   VB640, 1
S      M21.0, 1

Network 14 // Paso 9: NETR nodo 6 (brazo: READY, BUSY, DONE, BELT_PERMIT_RUN, HOMED)
LDW=   VW450, +9
AN     M21.0
NETR   VB660, 1
S      M21.0, 1

Network 15 // Paso 10: NETW nodo 6 (orden de recogida CMD_START / CMD_ESTOP)
LDW=   VW450, +10
AN     M21.0
MOVB   VB706, VB687
MOVB   0, VB706
NETW   VB680, 1
S      M21.0, 1

// -------------------------------- TERMINAR -----------------------------------
Network 16 // Fin del paso 1 (NETR nodo 2). Si falla: VB507 = 0 para no usar datos viejos
LDW=   VW450, +1
A      M21.0
LD     V500.7
O      V500.5
O      T38
ALD
LPS
AN     V500.5
AN     T38
R      V710.2, 1
LRD
LD     V500.5
O      T38
ALD
S      V710.2, 1
MOVB   0, VB507
LPP
R      M21.0, 1
R      T38, 1
MOVW   +2, VW450

Network 17 // Fin del paso 2 (NETW nodo 2). Si falla: volver a poner las ordenes en la cola
LDW=   VW450, +2
A      M21.0
LD     V520.7
O      V520.5
O      T38
ALD
LPS
LD     V520.5
O      T38
ALD
ORB    VB527, VB702
S      V710.2, 1
LPP
MOVB   0, VB527
R      M21.0, 1
R      T38, 1
MOVW   +3, VW450

Network 18 // Fin del paso 3 (NETR nodo 3)
LDW=   VW450, +3
A      M21.0
LD     V540.7
O      V540.5
O      T38
ALD
LPS
AN     V540.5
AN     T38
R      V710.3, 1
LRD
LD     V540.5
O      T38
ALD
S      V710.3, 1
MOVB   0, VB547
LPP
R      M21.0, 1
R      T38, 1
MOVW   +4, VW450

Network 19 // Fin del paso 4 (NETW nodo 3)
LDW=   VW450, +4
A      M21.0
LD     V560.7
O      V560.5
O      T38
ALD
LPS
LD     V560.5
O      T38
ALD
ORB    VB567, VB703
S      V710.3, 1
LPP
MOVB   0, VB567
R      M21.0, 1
R      T38, 1
MOVW   +5, VW450

Network 20 // Fin del paso 5 (NETR nodo 4)
LDW=   VW450, +5
A      M21.0
LD     V580.7
O      V580.5
O      T38
ALD
LPS
AN     V580.5
AN     T38
R      V710.4, 1
LRD
LD     V580.5
O      T38
ALD
S      V710.4, 1
MOVB   0, VB587
LPP
R      M21.0, 1
R      T38, 1
MOVW   +6, VW450

Network 21 // Fin del paso 6 (NETW nodo 4)
LDW=   VW450, +6
A      M21.0
LD     V600.7
O      V600.5
O      T38
ALD
LPS
LD     V600.5
O      T38
ALD
ORB    VB607, VB704
S      V710.4, 1
LPP
MOVB   0, VB607
R      M21.0, 1
R      T38, 1
MOVW   +7, VW450

Network 22 // Fin del paso 7 (NETR nodo 5)
LDW=   VW450, +7
A      M21.0
LD     V620.7
O      V620.5
O      T38
ALD
LPS
AN     V620.5
AN     T38
R      V710.5, 1
LRD
LD     V620.5
O      T38
ALD
S      V710.5, 1
MOVB   0, VB627
LPP
R      M21.0, 1
R      T38, 1
MOVW   +8, VW450

Network 23 // Fin del paso 8 (NETW nodo 5)
LDW=   VW450, +8
A      M21.0
LD     V640.7
O      V640.5
O      T38
ALD
LPS
LD     V640.5
O      T38
ALD
ORB    VB647, VB705
S      V710.5, 1
LPP
MOVB   0, VB647
R      M21.0, 1
R      T38, 1
MOVW   +9, VW450

Network 24 // Fin del paso 9 (NETR nodo 6)
LDW=   VW450, +9
A      M21.0
LD     V660.7
O      V660.5
O      T38
ALD
LPS
AN     V660.5
AN     T38
R      V710.6, 1
LRD
LD     V660.5
O      T38
ALD
S      V710.6, 1
MOVB   0, VB667
LPP
R      M21.0, 1
R      T38, 1
MOVW   +10, VW450

Network 25 // Fin del paso 10 (NETW nodo 6) -> vuelve al paso 1
LDW=   VW450, +10
A      M21.0
LD     V680.7
O      V680.5
O      T38
ALD
LPS
LD     V680.5
O      T38
ALD
ORB    VB687, VB706
S      V710.6, 1
LPP
MOVB   0, VB687
R      M21.0, 1
R      T38, 1
MOVW   +1, VW450
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 7: SBR_MODBUS_SLAVE (Modbus RTU esclavo en el puerto 0, datos del SCADA)
// ==============================================================================
// El bit n de un registro Modbus VWxxxx es V(xxxx+1).n (byte bajo).
// ==============================================================================
SUBROUTINE_BLOCK SBR_MODBUS_SLAVE:SBR7
TITLE=Modbus RTU esclavo en el puerto 0 y datos de la planta para el SCADA
BEGIN
Network 1 // Modbus esclavo en el puerto 0 solo con el selector en RUN (Mode = VB285 = SM0.7)
// En TERM el puerto 0 vuelve a PPI: la PC se puede conectar aunque el programa este en RUN.
// MBUS_INIT se vuelve a ejecutar en el primer ciclo y cada vez que cambia el selector.
LD     SM0.7
MOVB   1, VB285
LDN    SM0.7
MOVB   0, VB285
LD     SM0.7
EU
LD     SM0.7
ED
OLD
O      SM0.1
CALL   MBUS_INIT, VB285, 1, 19200, 0, 0, 128, 32, 128, &VB1000, M12.1, VB39

Network 2 // Modbus esclavo en cada ciclo (solo con el selector en RUN)
LD     SM0.7
CALL   MBUS_SLAVE, M12.0, VB38

Network 3 // VW1020 STAT_GLOBAL_CELL
LD     M6.0
=      V1021.0                      // Bit 0: planta en marcha
LD     M6.1
O      M13.0
=      V1021.1                      // Bit 1: pausa
LD     I2.6
=      V1021.2                      // Bit 2: seta QS liberada
LD     M5.2
=      V1021.3                      // Bit 3: automatico
LDW>   VW16, +0
A      M5.2
LDW>   VW12, +0
AN     M5.2
OLD
=      V1021.4                      // Bit 4: ciclo en curso
LDN    I2.6
O      M4.1
O      M7.2
O      M7.6
O      M7.7
O      M8.2
O      M10.7
O      M20.3
=      V1021.5                      // Bit 5: alarma general
LDN    M5.2
=      V1021.6                      // Bit 6: manual / diagnostico

Network 4 // VW1022 estaciones listas (bit 0 del VB200 de cada una)
LD     M13.3
=      V1023.1                      // Transporte con referencia
LD     V507.0
=      V1023.2
LD     V547.0
=      V1023.3
LD     V587.0
=      V1023.4
LD     V627.0
=      V1023.5
LD     V667.0
=      V1023.6

Network 5 // VW1024..VW1036 pasos de las estaciones y tipo de pieza
LD     M5.2
MOVW   VW16, VW1024
LDN    M5.2
MOVW   VW12, VW1024
LD     SM0.0
BTI    VB508, VW1026
BTI    VB548, VW1028
BTI    VB588, VW1030
BTI    VB628, VW1032
BTI    VB668, VW1034
BTI    VB33, VW1036

Network 6 // VW1038 FLAGS_INTERLOCK
LD     V547.0
=      V1039.0                      // Bit 0: se puede dejar en Ensamblaje
LD     V587.0
=      V1039.1                      // Bit 1: se puede dejar en la prensa
LD     V627.0
=      V1039.2                      // Bit 2: se puede dejar en Seleccion
LD     V667.6
=      V1039.3                      // Bit 3: BELT_PERMIT_RUN del brazo
LD     M20.0
=      V1039.4                      // Bit 4: tarea de recogida del brazo en curso

Network 7 // VW1046 ALM_PROCESO_CELL
LD     V507.5
=      V1047.0                      // Bit 0: silo de Alimentacion vacio
LD     V547.5
=      V1047.1                      // Bit 1: silo de nucleos vacio
LDN    M3.2
=      V1047.2                      // Bit 2: servo no listo (I1.2 = 0), solo aviso
LD     V627.5
=      V1047.3                      // Bit 3: falla de comunicacion con el variador (PLC 5)
LD     I0.1
O      I0.2
O      M7.6
=      V1047.4                      // Bit 4: finales de carrera / limites
LDB<>  VB710, 0
=      V1047.5                      // Bit 5: error o falta de respuesta en la red PPI

Network 8 // Datos del variador (VW204..VB211 del PLC 5 -> VB631..VB638)
LD     SM0.0
MOVW   VW631, VW1132                // Frecuencia real (0,01 Hz)
MOVW   VW635, VW1134                // Bus DC (0,1 V)
MOVW   VW633, VW1136                // Corriente (0,01 A)
MOVB   VB637, VB36
ANDB   16#03, VB36                  // Bits 0..1 = modo (bit 5 atras, bit 6 auto, bit 7 seta del PLC 5)
BTI    VB36, VW1144                 // Modo del variador (1 analogico / 2 Modbus)
BTI    VB638, VW1146                // Codigo de error Modbus del PLC 5
MOVW   +5, VW1138                   // Estado: 5 = parado
LDW>   VW631, +0
MOVW   +1, VW1138                   // Estado: 1 = en marcha

Network 9 // VW1180 sensores del PLC 1
LD     I2.0
=      V1181.0
LD     I2.1
=      V1181.1
LD     I2.2
=      V1181.2
LD     I0.0
=      V1181.3                      // Inductivo home
LD     I0.1
=      V1181.4                      // FC izquierdo
LD     I0.2
=      V1181.5                      // FC derecho

Network 10 // Contadores de piezas por rampa (flanco de los capacitivos)
LD     I2.0
EU
INCW   VW1182
INCW   VW1190
LD     I2.1
EU
INCW   VW1184
INCW   VW1190
LD     I2.2
EU
INCW   VW1186
INCW   VW1190

Network 11 // Cotas escritas desde el SCADA (VD1110..VD1122 distintas de su copia): revisar y aplicar
LDD<>  VD1110, VD260
LDD>=  VD1110, VD226
AD<=   VD1110, VD222
ALD
MOVD   VD1110, VD204
LDD<>  VD1114, VD264
LDD>=  VD1114, VD226
AD<=   VD1114, VD222
ALD
MOVD   VD1114, VD208
LDD<>  VD1118, VD268
LDD>=  VD1118, VD226
AD<=   VD1118, VD222
ALD
MOVD   VD1118, VD212
LDD<>  VD1122, VD272
LDD>=  VD1122, VD226
AD<=   VD1122, VD222
ALD
MOVD   VD1122, VD216

Network 12 // Publicar las cotas vigentes y la posicion (los valores rechazados vuelven al anterior)
LD     SM0.0
MOVD   VD204, VD1110
MOVD   VD208, VD1114
MOVD   VD212, VD1118
MOVD   VD216, VD1122
MOVD   VD204, VD260
MOVD   VD208, VD264
MOVD   VD212, VD268
MOVD   VD216, VD272
MOVD   VD250, VD1126

Network 13 // Parametros escritos desde el SCADA (40002..40007): revisar y aplicar (copias VD720..VD728)
// VD1002 pulsos de jog (1..20000) -> VD280 | VD1006 retroceso en el FC derecho (0..10000) -> VD288
// VD1010 retroceso del homing (500..20000) -> VD240. Un valor fuera de rango se descarta.
LDD<>  VD1002, VD720
LDD>=  VD1002, +1
AD<=   VD1002, +20000
ALD
MOVD   VD1002, VD280
LDD<>  VD1006, VD724
LDD>=  VD1006, +0
AD<=   VD1006, +10000
ALD
MOVD   VD1006, VD288
LDD<>  VD1010, VD728
LDD>=  VD1010, +500
AD<=   VD1010, +20000
ALD
MOVD   VD1010, VD240

Network 14 // Publicar los parametros vigentes (los valores rechazados vuelven al anterior)
LD     SM0.0
MOVD   VD280, VD1002
MOVD   VD288, VD1006
MOVD   VD240, VD1010
MOVD   VD280, VD720
MOVD   VD288, VD724
MOVD   VD240, VD728

Network 15 // VW1040 alarmas de Transporte (byte bajo V1041) y VW1060..VW1070 tiempos de los cilindros (ms)
// bit0 atasco o viaje sin terminar   bit1 homing fallido   bit2 final de carrera / cota fuera de rango
// bit3 movimiento sin referencia     bit4 tiempo de maniobra excedido   bit5 alarma del manual
// bit6 el brazo no responde         bit7 aviso de fuga
LD     SM0.0
MOVB   0, VB1040
MOVB   0, VB1041
MOVW   VW20, VW1060                 // CilV bajando
MOVW   VW22, VW1062                 // CilV subiendo
MOVW   VW24, VW1064                 // CilDV extendiendo
MOVW   VW26, VW1066                 // CilDV retrayendo
MOVW   VW28, VW1068                 // Giro horario
MOVW   VW30, VW1070                 // Cierre de la pinza
LD     M4.1
=      V1041.0
LD     M7.2
=      V1041.1
LD     M7.6
=      V1041.2
LD     M7.7
=      V1041.3
LD     M8.2
=      V1041.4
LD     M10.7
=      V1041.5
LD     M20.3
=      V1041.6
LD     M4.0
=      V1041.7

Network 16 // E/S y datos de cada PLC para el SCADA (40101..40128 = VW1200..VW1254)
// VB1200 IB0  VB1201 IB1  VB1202 IB2  VB1203 QB0  VB1204 QB1  VB1205 maniobra (VB19)
// VB1206 etapa auto (VB18)  VB1207 etapa manual (VB14)  VB1208 etapa de la maniobra (VB34)
// VB1209 nodos PPI sin red (VB710)  VB1210 banderas de Transporte  VB1211 fase del homing (VB15)
// VB1212..VB1219 PLC 2 (VB507..VB514)   VB1220..VB1227 PLC 3 (VB547..VB554)
// VB1228..VB1235 PLC 4 (VB587..VB594)   VB1236..VB1248 PLC 5 (VB627..VB639)
// VB1250..VB1253 PLC 6 (VB667..VB670)   VB1254 contador de vida (VB570)   VB1255 baliza (VB37)
LD     SM0.0
MOVB   IB0, VB1200
MOVB   IB1, VB1201
MOVB   IB2, VB1202
MOVB   QB0, VB1203
MOVB   QB1, VB1204
MOVB   VB19, VB1205
MOVB   VB18, VB1206
MOVB   VB14, VB1207
MOVB   VB34, VB1208
MOVB   VB710, VB1209
MOVB   0, VB1210
MOVB   VB15, VB1211
MOVD   VD507, VD1212
MOVD   VD511, VD1216
MOVD   VD547, VD1220
MOVD   VD551, VD1224
MOVD   VD587, VD1228
MOVD   VD591, VD1232
MOVD   VD627, VD1236
MOVD   VD631, VD1240
MOVD   VD635, VD1244
MOVB   VB639, VB1248
MOVB   0, VB1249
MOVD   VD667, VD1250
MOVB   VB570, VB1254
MOVB   VB37, VB1255

Network 17 // VB1210 banderas de Transporte
// bit0 con referencia  bit1 homing pedido o en curso  bit2 maniobra en curso  bit3 viaje en curso
// bit4 esperando a otra estacion  bit5 retroceso en el FC derecho  bit6 parar al final  bit7 tarea del brazo
LD     M13.3
=      V1210.0
LD     M7.0
=      V1210.1
LD     M8.0
=      V1210.2
LD     M23.0
=      V1210.3
LD     M27.0
=      V1210.4
LD     M24.0
=      V1210.5
LD     M6.2
=      V1210.6
LD     M20.0
=      V1210.7
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 8: SBR_MAN_STEP (manual, una accion por cada SB1)
// ==============================================================================
// Cada pulsacion de SB1 hace una accion. Las maniobras del manipulador usan
// SBR_MANIOBRA (las mismas del automatico) y el PLC 1 envia por PPI los mismos
// avisos a las estaciones, que trabajan solas en su propio automatico.
//   0  Reposo (SB1 -> 1, u homing si no hay referencia; SB2 -> homing)
//   1  Tomar en Alimentacion            -> CMD_RETIRO_CONFIRMADO al PLC 2
//   2  Viaje a Ensamblaje (VD212)
//   3  Dejar en el nido de Ensamblaje   -> CMD_PIEZA_ENTREGADA al PLC 3 + CMD_AUTORIZAR_DOSIF al PLC 2
//   4  Tomar en Ensamblaje (SB1 no hace nada mientras el PLC 3 esta ocupado) -> CMD_RETIRO_CONFIRMADO
//      Tipo 5 (pieza negra, VB550 = 5) -> salta al paso 8 (directo a Seleccion)
//   5  Volver hacia atras a Procesamiento (VD208)
//   6  Dejar en la mordaza de la prensa -> CMD_PIEZA_ENTREGADA al PLC 4 (prensado)
//   7  Tomar en la prensa (SB1 no hace nada mientras el PLC 4 esta ocupado) -> CMD_RETIRO_CONFIRMADO
//   8  Viaje a Seleccion (VD216). Si toca el FC derecho: retrocede VD288 solo y se da por llegado
//   9  Dejar en la cinta (giro AH)      -> tipo en VB648 + CMD_PIEZA_ENTREGADA al PLC 5
//  10  Volver a Alimentacion haciendo homing (homing + viaje a VD204)
//  90  Homing
// Etapas VB14 - viaje: 0 lanzar, 1 viajando, 2 esperar SB1.
//             - maniobra: 0 lanzar, 1 en curso, 2 esperar SB1.
// Ajuste desde la tabla de estado (en el paso 0 o esperando SB1, con referencia):
//   VD280 = pulsos por toque (100 por defecto); V284.0 = 1 jog a la derecha; V284.1 = 1 jog a la izquierda.
//   VD250 muestra la posicion: copiarla a VD204/VD208/VD212/VD216 una vez alineado.
// ==============================================================================
SUBROUTINE_BLOCK SBR_MAN_STEP:SBR8
TITLE=Manual: A -> E (dejar/tomar) -> P (dejar/tomar) -> S (retroceso) -> regreso
BEGIN
Network 1 // Salir del FC izquierdo I0.1 con SB1 (jog a la derecha, 6000 p a 4 kHz)
LD     I0.1
A      M5.0
AN     M5.2
SI     Q0.2, 1                      // Direccion derecha de inmediato
S      M13.5, 1
R      M13.4, 1
R      M13.3, 1                     // Se pierde la posicion: hace falta homing despues
MOVB   16#85, SMB67
MOVW   +250, SMW68
MOVD   +6000, SMD72
PLS    0
CRET

Network 2 // Salir del FC derecho I0.2 con SB1 (jog a la izquierda), no durante el retroceso automatico
LD     I0.2
A      M5.0
AN     M5.2
AN     M24.0
RI     Q0.2, 1                      // Direccion izquierda de inmediato
S      M13.5, 1
R      M13.4, 1
R      M13.3, 1
MOVB   16#85, SMB67
MOVW   +250, SMW68
MOVD   +6000, SMD72
PLS    0
CRET

Network 3 // Fin de la salida del tope -> paso 0
LD     M13.5
LD     M13.4
O      SM66.7
ALD
R      M13.5, 1
MOVW   +0, VW12
MOVB   0, VB14
R      M13.2, 1
R      M13.4, 1
CRET

Network 4 // Seta QS o final de carrera activado: no hacer nada mas (incluye el retroceso en curso)
LDN    I2.6
O      I0.1
O      I0.2
CRET

Network 5 // SB2 con un ciclo en curso (VW12 > 0): volver a 0 y borrar alarmas de maniobra
LD     M5.1
AW>    VW12, +0
LPS
AN     SM66.7                       // Si el PTO estaba en marcha la posicion no es segura
R      M13.3, 1
LPP
MOVB   16#00, SMB67
PLS    0
MOVW   +0, VW12
MOVB   0, VB14
MOVB   0, VB34
R      M8.0, 4                      // Maniobra: pedido, fin, tiempo excedido, transicion
R      M4.0, 2                      // Fuga y atasco
R      M13.0, 3
R      M10.0, 8
R      M14.0, 4                     // Electrovalvulas en reposo
R      M7.6, 1
R      M24.0, 4                     // Retroceso en FC
R      M26.0, 3                     // SB1 guardado y ocupacion vista
CRET

Network 6 // Tiempo para el diagnostico de presion (T41)
LD     M10.0
TON    T41, +25

Network 7 // Alarma HL3 por fuga o atasco
LD     T41
S      M10.7, 1

Network 8 // Con una alarma (diagnostico, atasco o tiempo de maniobra) no se avanza: reset con SB2
LD     M10.7
O      M4.1
O      M8.2
CRET

Network 9 // Movimiento rechazado (sin referencia / cota fuera de limites / homing fallido) -> paso 0
LD     M7.6
O      M7.7
O      M7.2
AW>    VW12, +0
AW<>   VW12, +90
MOVW   +0, VW12
MOVB   0, VB14
R      M13.2, 1
CRET

Network 10 // Ajuste: jog desde la tabla de estado (V284.0 derecha / V284.1 izquierda, VD280 pulsos)
LD     M13.3                        // Con referencia
A      SM66.7                       // PTO parado
AN     M24.0
LDW=   VW12, +0
O      M13.2                        // En reposo o esperando SB1
ALD
LPS
A      V284.0
MOVD   VD250, VD230
+D     VD280, VD230
CALL   SBR_MOVE_PTO
LPP
A      V284.1
AN     V284.0
MOVD   VD250, VD230
-D     VD280, VD230
CALL   SBR_MOVE_PTO

Network 11 // Ajuste: cada orden de jog se usa una sola vez
LD     SM0.0
R      V284.0, 2

// ------------------------------------------------------------------------------
// PASO 0: REPOSO
// ------------------------------------------------------------------------------
Network 12 // Paso 0: SB1 -> mecanismo a reposo; sin referencia -> paso 90 (el network 22 pasa al paso 1)
LDW=   VW12, +0
A      M5.0
LPS
MOVB   0, VB14
R      M13.2, 1
R      M14.0, 1                     // Vertical arriba
R      M14.1, 1                     // Doble vastago retraido
R      M14.2, 1                     // Pinza abierta
R      M14.3, 1                     // Giro horario
R      M7.6, 1
R      M7.7, 1
MOVB   0, VB33
LPP
AN     M13.3
MOVW   +90, VW12
R      M26.2, 1
CRET

Network 13 // Paso 0: SB2 -> homing (paso 90)
LDW=   VW12, +0
A      M5.1
MOVW   +90, VW12
MOVB   0, VB14
R      M7.6, 1
CRET

// ------------------------------------------------------------------------------
// PASO 90: HOMING SOBRE EL INDUCTIVO I0.0 (LO HACE SBR_HOMING)
// ------------------------------------------------------------------------------
Network 14 // Paso 90 / etapa 0: pedir homing
LDW=   VW12, +90
AB=    VB14, 0
S      M7.0, 1
R      M7.3, 1
MOVB   1, VB14
CRET

Network 15 // Paso 90 / etapa 1: homing terminado -> paso 0
LDW=   VW12, +90
AB=    VB14, 1
A      M7.3
R      M7.3, 1
MOVW   +0, VW12
MOVB   0, VB14
CRET

// ------------------------------------------------------------------------------
// MANIOBRAS (PASOS 1, 3, 4, 6, 7, 9): INICIO Y FIN COMUNES
// ------------------------------------------------------------------------------
Network 16 // Etapa 0: lanzar la maniobra segun el paso (1/4/7 tomar, 3/6 dejar, 9 dejar en la cinta)
LDB=   VB14, 0
LDW=   VW12, +1
OW=    VW12, +4
OW=    VW12, +7
ALD
MOVB   1, VB19
S      M8.0, 1
R      M8.1, 1
MOVB   0, VB34
S      M8.3, 1
MOVB   1, VB14
LDB=   VB14, 0
LDW=   VW12, +3
OW=    VW12, +6
ALD
MOVB   2, VB19
S      M8.0, 1
R      M8.1, 1
MOVB   0, VB34
S      M8.3, 1
MOVB   1, VB14
LDB=   VB14, 0
AW=    VW12, +9
MOVB   VB33, VB648                  // Tipo para Seleccion (5 = pieza negra) antes de dejarla
MOVB   3, VB19
S      M8.0, 1
R      M8.1, 1
MOVB   0, VB34
S      M8.3, 1
MOVB   1, VB14

Network 17 // Etapa 1: maniobra terminada -> avisos PPI a las estaciones y esperar SB1
LDB=   VB14, 1
A      M8.1
LDW=   VW12, +1
OW=    VW12, +3
OW=    VW12, +4
OW=    VW12, +6
OW=    VW12, +7
OW=    VW12, +9
ALD
LPS
R      M8.1, 1
MOVB   2, VB14
S      M13.2, 1                     // Esperando SB1
LRD
AW=    VW12, +1
S      V702.6, 1                    // PLC 2: CMD_RETIRO_CONFIRMADO (cuna libre)
LRD
AW=    VW12, +3
S      V703.4, 1                    // PLC 3: CMD_PIEZA_ENTREGADA (empieza el ensamble)
S      V702.5, 1                    // PLC 2: CMD_AUTORIZAR_DOSIF (siguiente base)
LRD
AW=    VW12, +4
S      V703.6, 1                    // PLC 3: CMD_RETIRO_CONFIRMADO
MOVB   0, VB33
AB=    VB550, 5                     // STAT_DATA del PLC 3 = 5: pieza negra, va directo a Seleccion
MOVB   5, VB33
LRD
AW=    VW12, +6
S      V704.4, 1                    // PLC 4: CMD_PIEZA_ENTREGADA (empieza el prensado)
LRD
AW=    VW12, +7
S      V704.6, 1                    // PLC 4: CMD_RETIRO_CONFIRMADO
LPP
AW=    VW12, +9
S      V705.4, 1                    // PLC 5: CMD_PIEZA_ENTREGADA (arranca la cinta)

// ------------------------------------------------------------------------------
// VIAJES (PASOS 2, 5, 8): INICIO Y LLEGADA COMUNES
// ------------------------------------------------------------------------------
Network 18 // Etapa 0: lanzar el viaje (2 -> VD212 Ensamblaje, 5 -> VD208 Procesamiento, 8 -> VD216 Seleccion)
LDB=   VB14, 0
LPS
AW=    VW12, +2
MOVD   VD212, VD230
LRD
AW=    VW12, +5
MOVD   VD208, VD230
LPP
AW=    VW12, +8
MOVD   VD216, VD230
LDB=   VB14, 0
LDW=   VW12, +2
OW=    VW12, +5
OW=    VW12, +8
ALD
R      M10.0, 1
R      M13.4, 1
CALL   SBR_MOVE_PTO
MOVB   1, VB14
R      M13.2, 1
CRET

Network 19 // Etapa 1: tiempo maximo del viaje T106 (16 s; 112000 p a 8 kHz = 14 s)
LDB=   VB14, 1
LDW=   VW12, +2
OW=    VW12, +5
OW=    VW12, +8
ALD
TON    T106, +160

Network 20 // Etapa 1: llegada (evento 19 o PTO parado), sin retroceso en curso -> esperar SB1
LDB=   VB14, 1
LDW=   VW12, +2
OW=    VW12, +5
OW=    VW12, +8
ALD
AN     M24.0                        // No durante el retroceso en el FC derecho
LD     M13.4
O      SM66.7
O      T106
ALD
MOVB   2, VB14
S      M13.2, 1
R      M13.4, 1

// ------------------------------------------------------------------------------
// AVANCE ENTRE PASOS CON SB1 (ETAPA 2 = ACCION TERMINADA)
// ------------------------------------------------------------------------------
Network 21 // SB1 guardado (M26.2): pulsado en reposo (paso 0) o esperando (etapa 2)
// La pulsacion queda guardada y el paso se ejecuta apenas la estacion de destino
// esta lista; no hace falta volver a pulsar. SB2 (reset) o el cambio de paso la borran.
LDB=   VB14, 2
LDW=   VW12, +0
OLD
A      M5.0
S      M26.2, 1
LDB<>  VB14, 2
AW<>   VW12, +0
R      M26.2, 1

Network 22 // Paso 0 -> 1 (tomar en Alimentacion): pieza lista en la cuna (STAT_DONE del PLC 2) o sin red
LDW=   VW12, +0
A      M26.2
A      M13.3                        // Con referencia (si no, el network 12 lanza el homing)
LD     V507.2                       // PLC 2: pieza en la cuna (STAT_DONE)
LD     V509.4                       // o su sensor de cuna I0.4 con la estacion sin empujar
AN     V507.1
OLD
O      V710.2                       // o nodo 2 sin comunicacion (TERM): decide el operador
ALD
MOVW   +1, VW12
MOVB   0, VB14
R      M26.2, 1
CRET

Network 23 // SB1 en los pasos 1, 7, 9 (no hay estacion que esperar): avanzar directo
LDB=   VB14, 2
A      M26.2
LDW=   VW12, +1
OW=    VW12, +7
OW=    VW12, +9
ALD
LPS
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
LPP
+I     +1, VW12
CRET

Network 24 // Paso 2 -> 3 (dejar en Ensamblaje): PLC 3 listo (STAT_READY) o sin red
LDW=   VW12, +2
AB=    VB14, 2
A      M26.2
LD     V547.0
O      V710.3
ALD
MOVW   +3, VW12
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
CRET

Network 25 // Paso 3 -> 4 (tomar en Ensamblaje): ensamble terminado (STAT_DONE del PLC 3) o sin red
LDW=   VW12, +3
AB=    VB14, 2
A      M26.2
LD     V547.2
O      V710.3
ALD
MOVW   +4, VW12
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
CRET

Network 26 // SB1 en el paso 4: tipo 5 -> directo a Seleccion (paso 8); el resto -> Procesamiento (paso 5)
LDW=   VW12, +4
AB=    VB14, 2
A      M26.2
LPS
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
LRD
AB=    VB33, 5
MOVW   +8, VW12
LPP
AB<>   VB33, 5
MOVW   +5, VW12
CRET

Network 27 // Paso 5 -> 6 (dejar en la prensa): PLC 4 listo (STAT_READY) o sin red
LDW=   VW12, +5
AB=    VB14, 2
A      M26.2
LD     V587.0
O      V710.4
ALD
MOVW   +6, VW12
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
CRET

Network 28 // Paso 6 -> 7 (tomar de la prensa): prensado terminado (STAT_DONE del PLC 4) o sin red
LDW=   VW12, +6
AB=    VB14, 2
A      M26.2
LD     V587.2
O      V710.4
ALD
MOVW   +7, VW12
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
CRET

Network 29 // Paso 8 -> 9 (dejar en la cinta): Seleccion lista (STAT_READY del PLC 5, en automatico) o sin red
LDW=   VW12, +8
AB=    VB14, 2
A      M26.2
LD     V627.0
O      V710.5
ALD
MOVW   +9, VW12
MOVB   0, VB14
R      M13.2, 1
R      M26.2, 1
CRET

// ------------------------------------------------------------------------------
// PASO 10: VOLVER A ALIMENTACION HACIENDO HOMING (CORRIGE CUALQUIER DESFASE)
// ------------------------------------------------------------------------------
Network 30 // Paso 10 / etapa 0: homing sobre I0.0
LDW=   VW12, +10
AB=    VB14, 0
S      M7.0, 1
R      M7.3, 1
MOVB   1, VB14
R      M13.2, 1
CRET

Network 31 // Paso 10 / etapa 1: homing terminado -> viaje a la cota de Alimentacion VD204
LDW=   VW12, +10
AB=    VB14, 1
A      M7.3
R      M7.3, 1
R      M13.4, 1
MOVD   VD204, VD230
CALL   SBR_MOVE_PTO
MOVB   2, VB14
CRET

Network 32 // Paso 10 / etapa 2: en Alimentacion -> paso 0 (listo para otro ciclo)
LDW=   VW12, +10
AB=    VB14, 2
LD     M13.4
O      SM66.7
ALD
MOVW   +0, VW12
MOVB   0, VB14
R      M13.4, 1
CRET
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 9: SBR_HOMING (sobre el inductivo I0.0, fase VB15)
// ==============================================================================
// 10 Si I0.0 ya esta activo: alejarse 3000 p a la derecha (2 kHz)
// 20 Busqueda rapida a la izquierda (8 kHz); el flanco de I0.0 detiene el PTO por
//    interrupcion (evento 0 -> INT_HOME_I00), sin esperar al ciclo
// 30 Retroceso a la derecha de VD240 pulsos (2 kHz)
// 40 Acercamiento lento a la izquierda (1 kHz) -> flanco -> VD250 = 0, M13.3 = 1
// 90 Falla (no aparecio I0.0, se llego al FC izquierdo o se acciono la seta): M7.2 = 1
// Los finales de carrera nunca se usan como referencia.
// ==============================================================================
SUBROUTINE_BLOCK SBR_HOMING:SBR9
TITLE=Homing en dos velocidades sobre el inductivo I0.0, con interrupcion
BEGIN
Network 1 // Cancelar el homing con la seta
LD     M10.6
AB<>   VB15, 0
AB<>   VB15, 90
MOVB   90, VB15

Network 2 // Inicio: pedido M7.0 en la fase 0
LD     M7.0
AB=    VB15, 0
R      M13.3, 1
R      M7.2, 1
R      M7.3, 1
R      M7.4, 1
R      M7.5, 1
R      M13.4, 1
MOVB   0, VB35
MOVB   10, VB15

Network 3 // Fase 10: si el sensor ya esta activo, alejarse (derecha, 3000 p a 2 kHz); si no, fase 20
LDB=   VB15, 10
LPS
A      M3.3
SI     Q0.2, 1
MOVB   16#85, SMB67
MOVW   +500, SMW68                  // 500 us = 2 kHz
MOVD   +3000, SMD72
PLS    0
MOVB   11, VB15
LPP
AN     M3.3
MOVB   20, VB15

Network 4 // Fase 11: termino de alejarse -> fase 20
LDB=   VB15, 11
A      M13.4
R      M13.4, 1
MOVB   20, VB15

Network 5 // Fase 20: busqueda rapida a la izquierda (8 kHz, max. 500000 p) con la interrupcion activa
LDB=   VB15, 20
RI     Q0.2, 1
R      M7.5, 1
S      M7.4, 1
R      M13.4, 1
MOVB   16#85, SMB67
MOVW   +125, SMW68
MOVD   +500000, SMD72
PLS    0
MOVB   21, VB15

Network 6 // Fase 21: aparecio el inductivo -> fase 30; se acabo el recorrido o FC izquierdo -> falla
LDB=   VB15, 21
A      M7.5
MOVB   30, VB15
LDB=   VB15, 21
LD     M13.4
O      I0.1
ALD
MOVB   16#00, SMB67
PLS    0
R      M7.4, 1
MOVB   90, VB15

Network 7 // Fase 30: retroceso a la derecha de VD240 pulsos (2 kHz)
LDB=   VB15, 30
SI     Q0.2, 1
R      M13.4, 1
MOVB   16#85, SMB67
MOVW   +500, SMW68
MOVD   VD240, SMD72
PLS    0
MOVB   31, VB15

Network 8 // Fase 31: fin del retroceso -> fase 40
LDB=   VB15, 31
A      M13.4
R      M13.4, 1
MOVB   40, VB15

Network 9 // Fase 40: acercamiento lento a la izquierda (1 kHz, max. VD240 + 1000 p)
LDB=   VB15, 40
AN     M3.3
RI     Q0.2, 1
R      M7.5, 1
S      M7.4, 1
R      M13.4, 1
MOVB   16#85, SMB67
MOVW   +1000, SMW68                 // 1000 us = 1 kHz
MOVD   VD240, SMD72
+D     +1000, SMD72
PLS    0
MOVB   41, VB15
// Si el sensor sigue activo despues del retroceso: retroceder otra vez (max. 3 veces)
LDB=   VB15, 40
A      M3.3
INCB   VB35
MOVB   30, VB15
LDB=   VB15, 30
AB>    VB35, 3
MOVB   90, VB15

Network 10 // Fase 41: flanco tomado -> cero (VD250 = 0 = cota de Alimentacion)
LDB=   VB15, 41
A      M7.5
MOVD   VD244, VD250                 // Cota del flanco de I0.0 (VD244 = 0 por defecto)
S      M13.3, 1                     // Referencia valida
S      M7.3, 1                      // Homing terminado
R      M7.0, 1
MOVB   0, VB15
LDB=   VB15, 41
LD     M13.4
O      I0.1
ALD
MOVB   16#00, SMB67
PLS    0
R      M7.4, 1
MOVB   90, VB15

Network 11 // Fase 90: homing fallido
LDB=   VB15, 90
S      M7.2, 1
S      M7.3, 1
R      M7.0, 1
R      M7.4, 1
R      M13.3, 1
MOVB   0, VB15
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 10: SBR_MANIOBRA (manipulador en automatico, etapa VB34)
// ==============================================================================
// VB19 = 1 tomar | 2 dejar en el nido | 3 dejar en la cinta (giro AH)
// Pedido M8.0, fin M8.1. Cada etapa tiene 2 s (T131): si el sensor no
// confirma se activa M8.2 + M4.1 (la planta se detiene hasta SB1).
// ==============================================================================
SUBROUTINE_BLOCK SBR_MANIOBRA:SBR10
TITLE=Tomar / dejar / dejar en la cinta, cada movimiento confirmado por su sensor
BEGIN
Network 1 // Tiempo maximo por etapa (T131, 2 s), se reinicia con M8.3 en cada cambio
LD     M8.0
AN     M8.3
TON    T131, +20
LD     SM0.0
R      M8.3, 1
LD     T131
S      M8.2, 1
S      M4.1, 1

Network 2 // Inicio: al tomar abre la pinza; tipos 1/2 -> revisar giro horario (15); tipo 3 -> giro AH (10)
LD     M8.0
AB=    VB34, 0
LPS
AB=    VB19, 1
R      M14.2, 1
LRD
AB=    VB19, 3
MOVB   10, VB34
S      M8.3, 1
LPP
AB<>   VB19, 3
MOVB   15, VB34
S      M8.3, 1

Network 3 // 10: girar a antihorario, hacia la cinta (Q0.4) -> I0.5
LD     M8.0
AB=    VB34, 10
S      M14.3, 1
A      M2.5
MOVB   20, VB34
S      M8.3, 1

Network 4 // 15: girar a horario, hacia los nidos (Q0.5) -> I0.6
LD     M8.0
AB=    VB34, 15
R      M14.3, 1
A      M2.6
MOVB   20, VB34
S      M8.3, 1

Network 5 // 20: extender el doble vastago (Q0.6) -> I0.7
LD     M8.0
AB=    VB34, 20
S      M14.1, 1
A      M2.7
MOVB   30, VB34
S      M8.3, 1

Network 6 // 30: bajar (Q0.3 = 0) -> I0.3
LD     M8.0
AB=    VB34, 30
S      M14.0, 1
A      M2.3
MOVB   40, VB34
S      M8.3, 1

Network 7 // 40: tomar = cerrar la pinza (I1.1 o 1 s) / dejar = abrir la pinza
LD     M8.0
AB=    VB34, 40
LPS
AB=    VB19, 1
S      M14.2, 1
TON    T133, +10
LRD
AB=    VB19, 1
LD     M3.1
O      T133
ALD
MOVB   45, VB34
S      M8.3, 1
LPP
AB<>   VB19, 1
R      M14.2, 1
MOVB   45, VB34
S      M8.3, 1

Network 8 // 45: esperar 0,5 s a que la pinza se asiente
LD     M8.0
AB=    VB34, 45
TON    T132, +5
A      T132
MOVB   50, VB34
S      M8.3, 1

Network 9 // 50: subir (Q0.3 = 1) -> I0.4
LD     M8.0
AB=    VB34, 50
R      M14.0, 1
A      M2.4
MOVB   60, VB34
S      M8.3, 1

Network 10 // 60: retraer el doble vastago (Q0.6 = 0) -> I1.0; tipo 3 -> 70, el resto -> 99
LD     M8.0
AB=    VB34, 60
R      M14.1, 1
A      M3.0
LPS
AB=    VB19, 3
MOVB   70, VB34
S      M8.3, 1
LPP
AB<>   VB19, 3
MOVB   99, VB34
S      M8.3, 1

Network 11 // 70: volver el giro a horario (reposo) -> I0.6
LD     M8.0
AB=    VB34, 70
R      M14.3, 1
A      M2.6
MOVB   99, VB34
S      M8.3, 1

Network 12 // 99: maniobra terminada
LD     M8.0
AB=    VB34, 99
S      M8.1, 1
R      M8.0, 1
MOVB   0, VB34
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 11: SBR_COORD_BRAZO (Seleccion <-> brazo por PPI)
// ==============================================================================
// 1. El PLC 5 detiene una pieza tipo 4/5 en VW318 y pone STAT_ROBOT_WAIT (VB627.6).
// 2. El PLC 1 envia CMD_START (orden de recogida) al PLC 6 (VB687.0 -> V100.0 del PLC 6).
// 3. El PLC 6 acepta (STAT_BUSY VB667.1), cierra la garra y sube Y 5000 p -> BELT_PERMIT (VB667.6).
// 4. El PLC 1 pasa el permiso al PLC 5 (VB647.6 -> V100.6 del PLC 5): la cinta vuelve a andar.
// 5. El PLC 5 quita STAT_ROBOT_WAIT: termina el intercambio. STAT_DONE (VB667.2) cuenta la pieza.
// ==============================================================================
SUBROUTINE_BLOCK SBR_COORD_BRAZO:SBR11
TITLE=Recogida en el fin de cinta y paso del permiso BELT_PERMIT_RUN
BEGIN
Network 1 // Nueva tarea: Seleccion espera y el brazo esta listo
LD     V627.6                       // STAT_ROBOT_WAIT (PLC 5)
AN     M20.0
A      V667.0                       // STAT_READY (PLC 6 en auto y en reposo; si le falta homing lo hace solo)
S      M20.0, 1                     // Tarea en curso
R      M20.1, 1
R      M20.2, 1
S      V706.0, 1                    // CMD_START = orden de recogida (una vez)

Network 2 // El brazo acepto la orden (STAT_BUSY)
LD     M20.0
A      V667.1
S      M20.1, 1

Network 3 // Si no acepta en 5 s (T134), reenviar la orden
LD     M20.0
AN     M20.1
TON    T134, +50
LD     T134
S      V706.0, 1
R      T134, 1

Network 4 // Pieza levantada 5000 p: BELT_PERMIT_RUN del brazo -> pasarlo al PLC 5
LD     M20.1
A      V667.6
AN     M20.2
S      V705.6, 1                    // Permiso de la cinta (una vez) -> V100.6 del PLC 5
S      M20.2, 1

Network 5 // Si Seleccion sigue esperando 3 s despues (T135), reenviar el permiso
LD     M20.2
A      V627.6
TON    T135, +30
LD     T135
S      V705.6, 1
R      T135, 1

Network 6 // Fin del intercambio: Seleccion quito STAT_ROBOT_WAIT
LD     M20.0
AN     V627.6
R      M20.0, 3

Network 7 // Brazo ocupado 30 s sin dar el permiso -> alarma M20.3
LD     M20.1
AN     M20.2
TON    T136, +300
LD     T136
S      M20.3, 1

Network 8 // Contador de piezas que retira el brazo (flanco de STAT_DONE del PLC 6)
LD     V667.2
EU
INCW   VW1188
INCW   VW1190

Network 9 // Diagnostico del enlace Seleccion -> brazo (VB286; en el SCADA VW1052 = registro 40027)
// bit0 Seleccion espera al brazo (STAT_ROBOT_WAIT del PLC 5)   bit1 brazo listo (PLC 6 en auto y reposo)
// bit2 brazo con referencia    bit3 brazo ocupado    bit4 sin red con el PLC 5    bit5 sin red con el PLC 6
// bit6 orden de recogida enviada (M20.0)    bit7 permiso de la cinta pasado (M20.2)
LD     SM0.0
MOVB   0, VB286
LD     V627.6
=      V286.0
LD     V667.0
=      V286.1
LD     V667.7
=      V286.2
LD     V667.1
=      V286.3
LD     V710.5
=      V286.4
LD     V710.6
=      V286.5
LD     M20.0
=      V286.6
LD     M20.2
=      V286.7
LD     SM0.0
MOVB   0, VB1052
MOVB   VB286, VB1053
END_SUBROUTINE_BLOCK

// ==============================================================================
// SUBRUTINA 12: SBR_BALIZA_PLANTA (estado general -> baliza grande en el PLC 3)
// ==============================================================================
// Byte VB37 -> VB569 -> VB102 del PLC 3 (NETW nodo 3). Contador de vida en VB570 -> VB103.
//   Bit 4 roja intermitente  : seta QS accionada en alguna estacion (PLC 1 I2.6, PLC 2/3/4 bit 6 de estado,
//                             PLC 5 VB210 bit 7)
//   Bit 3 roja fija          : alarma en cualquier estacion (atasco, homing, limites,
//                             maniobra, brazo, variador) o nodo PPI sin comunicacion (VB710 <> 0)
//   Bit 0 verde              : planta produciendo en automatico, sin alarmas
//   Bit 2 amarilla intermit. : pausa, aviso de fuga o silo vacio (puede ir con la verde)
//   Bit 1 amarilla fija      : planta detenida / Transporte en manual, sin alarmas
// Prioridad: roja intermitente > roja fija > verde/amarilla.
// ==============================================================================
SUBROUTINE_BLOCK SBR_BALIZA_PLANTA:SBR12
TITLE=Estado general de la planta para la baliza grande
BEGIN
Network 1 // M25.0: seta QS accionada en alguna estacion
LDN    I2.6                         // PLC 1 Transporte
O      V507.6                       // PLC 2 Alimentacion
O      V547.6                       // PLC 3 Ensamblaje
O      V587.6                       // PLC 4 Procesamiento
O      V637.7                       // PLC 5 Seleccion (VB210 bit 7)
=      M25.0

Network 2 // M25.1: alarma en alguna estacion o falla de comunicacion
LD     M4.1
O      M7.2
O      M7.6
O      M7.7
O      M8.2
O      M10.7
O      M20.3
O      V507.3                       // Atascos en las estaciones (bit 3 de estado)
O      V547.3
O      V587.3
O      V627.3
O      V627.5                       // Falla de comunicacion con el variador
LDB<>  VB710, 0                     // Nodo PPI sin respuesta
OLD
=      M25.1

Network 3 // M25.2: avisos (pausa, fugas, silos vacios)
LD     M5.2
A      M6.1
O      M4.0
O      V507.4
O      V547.4
O      V587.4
O      V627.4
O      V507.5                       // Silo de bases vacio
O      V547.5                       // Silo de nucleos vacio
=      M25.2

Network 4 // M25.3: planta produciendo (Transporte en automatico y en marcha)
LD     M5.2
A      M6.0
AN     M6.1
=      M25.3

Network 5 // Armar el byte de la baliza VB37
LD     SM0.0
MOVB   0, VB37
LD     M25.0
=      V37.4                        // Roja intermitente
LD     M25.1
AN     M25.0
=      V37.3                        // Roja fija
LD     M25.3
AN     M25.0
AN     M25.1
=      V37.0                        // Verde
LD     M25.2
AN     M25.0
=      V37.2                        // Amarilla intermitente
LDN    M25.3
AN     M25.0
AN     M25.1
AN     M25.2
=      V37.1                        // Amarilla fija

Network 6 // Que espera el automatico (VB287; en el SCADA VW1054 = registro 40028)
// bit0 pieza en Alimentacion (PLC 2)           bit1 Ensamblaje listo para recibir
// bit2 fin del ensamble (DONE del PLC 3)        bit3 Procesamiento listo para recibir
// bit4 fin del prensado (DONE del PLC 4)        bit5 Seleccion lista (en automatico)
// bit6 viaje o maniobra en curso               bit7 homing en curso
// M27.0 = esperando a otra estacion (bits 0..5): el foco verde del tablero parpadea.
LD     SM0.0
MOVB   0, VB287
LD     M5.2
LPS
AW=    VW16, +10
AB=    VB18, 2
=      V287.0
LRD
AW=    VW16, +20
AB=    VB18, 2
=      V287.1
LRD
AW=    VW16, +22
AB=    VB18, 0
=      V287.2
LRD
AW=    VW16, +30
AB=    VB18, 2
=      V287.3
LRD
AW=    VW16, +32
AB=    VB18, 0
=      V287.4
LRD
AW=    VW16, +50
AB=    VB18, 2
=      V287.5
LRD
LD     M8.0
O      M23.0
ALD
=      V287.6
LPP
AW=    VW16, +5
=      V287.7
LD     SM0.0
MOVB   0, VB1054
MOVB   VB287, VB1055
LDB<>  VB287, 0
AB<    VB287, 64                    // Solo bits 0..5
O      V287.0
=      M27.0

Network 7 // Envio al PLC 3 (VB569 -> VB102 del PLC 3) y copia para el SCADA (VW1050 = registro 40026)
LD     SM0.0
MOVB   VB37, VB569
MOVB   0, VB1050
MOVB   VB37, VB1051

Network 8 // Por que esta roja la baliza (VB292; en el SCADA VW1056 = registro 40029)
// bit0 alarma de Transporte (atasco, homing, limite, maniobra, FC)   bit1 el brazo no responde (M20.3)
// bit2 atasco en Alimentacion   bit3 atasco en Ensamblaje   bit4 atasco en Procesamiento
// bit5 atasco en Seleccion o falla de comunicacion con el variador
// bit6 nodo PPI sin comunicacion (VB710: bit2 = PLC 2 ... bit6 = PLC 6)   bit7 seta QS en alguna estacion
LD     SM0.0
MOVB   0, VB292
LD     M4.1
O      M7.2
O      M7.6
O      M7.7
O      M8.2
O      M10.7
=      V292.0
LD     M20.3
=      V292.1
LD     V507.3
=      V292.2
LD     V547.3
=      V292.3
LD     V587.3
=      V292.4
LD     V627.3
O      V627.5
=      V292.5
LDB<>  VB710, 0
=      V292.6
LD     M25.0
=      V292.7
LD     SM0.0
MOVB   0, VB1056
MOVB   VB292, VB1057
END_SUBROUTINE_BLOCK

// ==============================================================================
// INTERRUPCION 0: INT_TIMED_10MS
// ==============================================================================
INTERRUPT_BLOCK INT_TIMED_10MS:INT0
TITLE=Interrupcion cada 10 ms (sin uso por ahora)
BEGIN
Network 1
LD     SM0.0
CRETI
END_INTERRUPT_BLOCK

// ==============================================================================
// INTERRUPCION 1: INT_PTO_DONE (evento 19, termino el PTO 0)
// ==============================================================================
INTERRUPT_BLOCK INT_PTO_DONE:INT1
TITLE=Termino el tren de pulsos del PTO 0 (evento 19)
BEGIN
Network 1 // Fin de los pulsos
LD     SM0.0
S      M13.4, 1
CRETI
END_INTERRUPT_BLOCK

// ==============================================================================
// INTERRUPCION 2: INT_HOME_I00 (evento 0, flanco de subida de I0.0)
// ==============================================================================
INTERRUPT_BLOCK INT_HOME_I00:INT2
TITLE=Inductivo de home: detener el PTO 0 al instante
BEGIN
Network 1 // Solo si el homing la activo (M7.4); en el ciclo normal no hace nada
LD     M7.4
MOVB   16#00, SMB67
PLS    0
R      M7.4, 1
S      M7.5, 1
END_INTERRUPT_BLOCK
